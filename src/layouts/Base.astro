---
import '../styles/global.css';
import Header from '../components/Header.astro';
import DevMode from '../components/DevMode.astro';
import { ClientRouter } from 'astro:transitions';
import { ui, type Lang } from '../data/ui';
import { cv } from '../data/cv';
import { contact } from '../data/about';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;            // chemin sans la langue, ex. 'about/' ou '' pour l'accueil
  active?: 'work' | 'lab' | 'archive' | 'about' | 'contact';
  bare?: boolean;          // page plein cadre sans menu du site (bureau du Lab)
}
const { lang, title, description, path, active, bare = false } = Astro.props;
const t = ui[lang];
const fullTitle = title === 'kerningkastle' ? `kerningkastle — ${t.tagline}` : `${title} — kerningkastle`;
const site = Astro.site ?? new URL('https://kerningkastle.com');
const canonical = new URL(`/${lang}/${path}`, site).href;
// référencement (14/11) : seuls les deux accueils sortent dans les moteurs de recherche, déclarés comme une même page en deux
// langues (hreflang) : un seul résultat, dans la langue de l'internaute. Les autres pages restent explorables, leurs liens comptent.
const indexable = path === '';
const alt = (l: string) => new URL(`/${l}/${path}`, site).href;
// image d'aperçu au partage : /og/<langue>-<page>.png (générées, 1200 × 630)
const seg = path.split('/').filter(Boolean);
const ogRaw = !seg.length ? 'home' : seg[0] === 'work' && seg[1] ? `work-${seg[1]}` : seg[0];
const ogKey = ['home', 'work', 'lab', 'archive', 'about'].includes(ogRaw) || ogRaw.startsWith('work-') ? ogRaw : 'home';
const ogImage = new URL(`/og/${lang}-${ogKey}.png`, site).href;
// données structurées (schema.org) : le site et la personne derrière, pour les moteurs de recherche
const home = new URL('/en/', site).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#site`, url: home, name: 'kerningkastle', alternateName: 'kerning kastle', inLanguage: ['fr', 'en'], publisher: { '@id': `${home}#me` } },
    {
      '@type': 'Person', '@id': `${home}#me`, name: 'kerningkastle', jobTitle: cv[lang].role, // nom d'usage seulement : le nom civil reste sur la page CV, pas mis en avant
      url: home, image: new URL('/portrait-720.webp', site).href, email: `mailto:${contact.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
      sameAs: [contact.instagram, contact.behance],
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- fond posé avant tout (pas de fond blanc avant la feuille de style) -->
    <style is:inline>html{background:#f3f3f3}html[data-theme='nuit']{background:#12110f}</style>
    <!-- premier chargement du document (les pages suivantes arrivent sans rechargement, voir scripts/page.ts) : JS présent,
         écran d'ouverture masqué jusqu'à son apparition, chargement d'entrée déjà vu, page intégrée au Lab, thème -->
    <script is:inline>(function(){var r=document.documentElement;r.classList.add('js','rv-pre');if(/[?&]embed\b/.test(location.search))r.classList.add('embed','ld-skip');try{if(sessionStorage.getItem('kk-ld'))r.classList.add('ld-skip')}catch(e){}try{var th=localStorage.getItem('kk-theme');if(th==='nuit'||(!th&&matchMedia('(prefers-color-scheme: dark)').matches))r.dataset.theme='nuit'}catch(e){}})()</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={alt('fr')} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <!-- favicon : noir sur navigateur clair, clair sur navigateur sombre (SVG qui suit le thème) ; .ico pour les anciens navigateurs -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <!-- écran d'accueil (iPhone, Android) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="kerningkastle" />
    <meta name="application-name" content="kerningkastle" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="author" content="kerningkastle" />
    <link rel="preload" href="/logo-icon-128.webp" as="image" />
    <!-- navigation sans rechargement : le menu reste, le contenu change (voir scripts/page.ts). Pas dans les salles du Lab
         (bare) : pièces plein écran autonomes (lab/back.js), on y entre et on en sort par un chargement complet. -->
    {!bare && <ClientRouter />}
    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3f3f3" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kerningkastle" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
    <!-- mesure d'audience sans cookie (GoatCounter), seulement sur le site en ligne -->
    {import.meta.env.PROD && <link rel="preconnect" href="https://kern.goatcounter.com" />}
    {import.meta.env.PROD && (
      <script is:inline data-goatcounter="https://kern.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    {!bare && <div class="ld" data-ld aria-hidden="true">
      <span class="ld-logo"><img class="logo-ic" src="/logo-icon-128.webp" alt="" width="64" height="64" /><span class="ld-fill" data-ld-fill></span></span>
      <span class="ld-n mono mu" data-ld-n>000</span>
    </div>}
    <a class="skip mono" href="#main">{t.skip}</a>
    {!bare && <Header lang={lang} path={path} active={active} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <!-- interface globale, gardée d'une page à l'autre : mode dev, flamme du mode nuit -->
    <div class="kk-ui" transition:persist="kk-ui"><DevMode /><div class="kk-layer" data-layer></div></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
