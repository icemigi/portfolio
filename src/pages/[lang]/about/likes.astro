---
// « Ce que j'aime » (easter egg de la porte, page À propos). L'écran est vide, puis les objets tombent du ciel.
// On les prend et on les lance ; un clic ouvre le texte au milieu de l'écran, qui repousse les objets.
// Chaque objet a sa propre adresse (#id). Physique : matter.js (MIT), servi depuis /vendor/.
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam } from '../../../data/ui';
import { likes } from '../../../data/likes';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const data = likes.map((l) => ({ id: l.id, src: l.src, shape: l.shape, w: l.w, h: l.h, cm: l.cm, hull: l.hull, link: l.link || '', embed: l.embed || '', ...l[lang] }));
---
<Base lang={lang} title={fr ? 'Ce que j\'aime' : 'Things I love'} description={fr ? 'Ce que j\'aime, en vrac.' : 'Things I love, in no particular order.'} path="about/likes/" active="about">
  <Fragment slot="head"><script is:inline src="/vendor/matter.min.js"></script></Fragment>
  <div class="likes" data-likes data-own-wheel>
    <p class="ttl mono mu"><a class="lk hit" href={`/${lang}/about/`}>← {t.nav.about}</a></p>
    <p class="hint mono mu">{fr ? 'Attrapez, lancez, cliquez.' : 'Grab, throw, click.'}</p>
    <h1 class="big" data-big><span class="t56">{fr ? 'Ce que j\'aime.' : 'Things I love.'}</span></h1>
    <div class="stage" data-stage>
      {data.map((d) => (
        <button class:list={['it', d.shape]} type="button" data-id={d.id} style={`width:${d.w / 4}px;height:${d.h / 4}px`} aria-label={d.title}>
          {d.src ? <img src={d.src} alt="" draggable="false" /> : <span class="mono">{d.sub}</span>}
          {d.embed && <span class="emb" data-emb={d.embed} aria-hidden="true"></span>}
        </button>
      ))}
    </div>
    <div class="card g" data-card hidden role="dialog" aria-modal="false" aria-labelledby="like-t">
      <div class="in">
        <p class="sub mono mu"><span data-sub></span><a class="lk" data-link target="_blank" rel="noopener" hidden></a></p>
        <h2 class="t28 tt" id="like-t" data-title></h2>
        <p class="txt" data-text></p>
        <button class="x mono lk hit" type="button" data-close>{t.close} ×</button>
      </div>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ data }}>window.kkLikes = data;</script>

<style>
  .likes { position: fixed; inset: 0; overflow: hidden; }
  .ttl { position: absolute; z-index: 5; left: var(--m); top: calc(var(--head) + 16px); }
  .hint { position: absolute; z-index: 1; right: var(--m); top: calc(var(--head) + 16px); text-align: right; pointer-events: none; transition: opacity .3s; }
  .big { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; pointer-events: none; padding: 0 var(--m); }
  .big span { display: inline-block; text-align: center; }
  .big[hidden] { display: none; }
  .stage { position: absolute; inset: 0; touch-action: none; cursor: grab; }
  .stage:active { cursor: grabbing; }
  .it { position: absolute; left: 0; top: 0; display: grid; place-items: center; padding: 8px; background: #c9c9c9; color: #fff; text-align: center; will-change: transform; pointer-events: none; }
  .it.circle { border-radius: 50%; }
  /* une ombre qui suit la forme de l'objet (pas de rectangle) ; l'objet soulevé ou ouvert s'élève */
  .it img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, .16)); transition: filter .3s; }
  .it.sel img { filter: drop-shadow(0 30px 34px rgba(0, 0, 0, .22)); }
  .it:has(img) { background: none; padding: 0; }
  /* écran de l'iPod : le lecteur Spotify y est posé (iframe 300 px réduite à la taille de l'écran) */
  .emb { position: absolute; left: 8.5%; top: 3.8%; width: 83%; height: 42%; overflow: hidden; border-radius: 2px; opacity: 0; transition: opacity .3s .5s; pointer-events: none; }
  .it.sel .emb { opacity: 1; pointer-events: auto; }
  .emb :global(iframe) { width: 300px; height: 380px; max-width: none; border: 0; transform-origin: 0 0; }
  .card { position: absolute; inset: 0; z-index: 4; display: grid; align-content: center; pointer-events: none; }
  .card[hidden] { display: none; }
  .card .in { grid-column: 7 / 11; pointer-events: auto; }
  .card .tt { margin-top: 8px; font-weight: 500; }
  .card .txt { margin-top: 16px; max-width: 46ch; }
  .card .x { margin-top: 24px; }
  .it.sel { z-index: 3; }
  .veil { position: fixed; inset: 0; z-index: 50; background: radial-gradient(circle at 50% 60%, #fff, #f3f3f3 70%); pointer-events: none; }
  .it { transition: opacity .35s; }
  /* objet ouvert : le monde se fige et s'efface derrière l'objet choisi */
  .likes.open .hint { opacity: 0; }
  .likes.open .it:not(.sel) { opacity: .08; }
  /* téléphone : le texte s'ouvre en feuille au bas de l'écran */
  @media (max-width: 760px) {
    .card { position: fixed; inset: auto 0 0 0; display: block; max-height: 56dvh; overflow-y: auto; overscroll-behavior: contain; padding: 40px var(--m) calc(24px + env(safe-area-inset-bottom)); background: linear-gradient(to bottom, transparent, var(--bg) 32px); }
    .card .in { grid-column: auto; }
    .card .txt { max-width: none; }
    .card .x { margin-top: 20px; }
  }
</style>

<script>
  import { letters } from '../../../scripts/motion';
  const M = (window as any).Matter;
  const D = (window as any).kkLikes as { id: string; shape: string; w: number; h: number; cm: number; hull: [number, number][]; link: string; embed: string; title: string; sub: string; text: string }[];
  const root = document.querySelector<HTMLElement>('[data-likes]')!;
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const card = root.querySelector<HTMLElement>('[data-card]')!;
  const big = root.querySelector<HTMLElement>('[data-big]')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const small = matchMedia('(max-width: 760px)').matches;
  const { Engine, Bodies, Body, Composite, Mouse, MouseConstraint, Query, Events, Vertices } = M;
  // plus d'itérations du solveur : les objets empilés ne s'enfoncent plus les uns dans les autres
  const engine = Engine.create({ gravity: { y: 1.1 }, positionIterations: 14, velocityIterations: 10, constraintIterations: 4 });
  let W = innerWidth, H = innerHeight;

  // boîte fermée : sol, plafond et côtés (on ne peut rien lancer hors de l'écran)
  const wallOpt = { isStatic: true, restitution: 0.2, friction: 0.6 };
  let walls: any[] = [], closed = false;
  // plafond : sous l'en-tête et le lien retour (les objets ne recouvrent jamais la navigation)
  const top = () => root.querySelector('.ttl')!.getBoundingClientRect().bottom + 12;
  const buildWalls = () => {
    Composite.remove(engine.world, walls);
    const T = 400; walls = [Bodies.rectangle(W / 2, H + T / 2, W + 2 * T, T, wallOpt), Bodies.rectangle(-T / 2, H / 2 - 1000, T, H + 2 * T + 2000, wallOpt), Bodies.rectangle(W + T / 2, H / 2 - 1000, T, H + 2 * T + 2000, wallOpt)];
    if (closed) walls.push(Bodies.rectangle(W / 2, top() - T / 2, W + 2 * T, T, wallOpt));
    Composite.add(engine.world, walls);
  };
  buildWalls();

  // échelle commune : chaque objet à sa taille réelle, fortement rapprochées (les petits objets comme l'iPod restent lisibles, la roue et le sac ne grossissent pas),
  // puis le tout ajusté pour couvrir ~44 % de l'écran (32 % sur téléphone) : une page pleine
  const real = D.map((d) => { const c = Math.pow(d.cm, 0.3), r = d.w / d.h; return r >= 1 ? [c, c / r] : [c * r, c]; });
  const area = real.reduce((a, [w, h]) => a + w * h, 0);
  const K = Math.sqrt(((small ? 0.24 : 0.24) * innerWidth * innerHeight) / area);
  // le titre est une étagère : les objets tombent dessus, ceux qui débordent glissent jusqu'au sol
  const tr = big.querySelector('span')!.getBoundingClientRect();
  let titleBody: any = null;
  const buildShelf = () => {
    if (titleBody) Composite.remove(engine.world, titleBody);
    const r = big.querySelector('span')!.getBoundingClientRect();
    titleBody = Bodies.rectangle(r.left + r.width / 2, r.top + r.height / 2, r.width, r.height * 0.82, { isStatic: true, friction: 1, frictionStatic: 10, restitution: 0 });
    Composite.add(engine.world, titleBody);
  };
  buildShelf(); document.fonts.ready.then(() => { if (!big.hidden) buildShelf(); });
  const items = D.map((d, i) => {
    const el = stage.querySelector<HTMLElement>(`[data-id="${d.id}"]`)!;
    let [w, h] = real[i].map((v) => v * K);
    const cap = Math.min(1, (innerHeight * 0.42) / h, (innerWidth * (small ? 0.34 : 0.4)) / w); w *= cap; h *= cap;
    el.style.width = `${w}px`; el.style.height = `${h}px`;
    const x = Math.max(w / 2 + 8, Math.min(W - w / 2 - 8, tr.left + tr.width * (0.5 + 0.8 * (((i * 0.37) % 1) - 0.5)))), y = -h - 20;
    const opt = { restitution: 0.12, friction: 0.8, frictionStatic: 1.2, frictionAir: 0.015, slop: 0.01, angle: (Math.random() - 0.5) * 0.25 };
    // contour exact : enveloppe convexe du PNG (le corps physique colle à l'objet, plus de flottement)
    let body: any, ox = 0, oy = 0;
    if (d.shape === 'circle') body = Bodies.circle(x, y, w / 2, opt);
    else {
      const verts = d.hull.map(([u, v]) => ({ x: u * w, y: v * h }));
      const c = Vertices.centre(verts); ox = w / 2 - c.x; oy = h / 2 - c.y;
      body = Bodies.fromVertices(x, y, [verts], opt);
    }
    body.kk = d.id;
    return { d, el, body, w, h, ox, oy, s: 1, tw: 0, home: null as null | { x: number; y: number; a: number } };
  });
  // le titre s'écrit au centre, puis les objets pleuvent dessus ; il s'efface quand un objet est ouvert, mais l'étagère reste (rien ne tombe)
  const showTitle = (delay: number) => {
    big.hidden = false;
    letters(big, delay);
  };
  const hideTitle = () => {
    big.hidden = true;
  };
  showTitle(150);
  items.forEach((it, i) => setTimeout(() => Composite.add(engine.world, it.body), still ? 0 : 900 + i * 220));
  // le plafond se ferme quand tous les objets sont entrés : ensuite, rien ne sort de la boîte
  Events.on(engine, 'afterUpdate', () => {
    if (closed) return;
    if (items.every(({ body, h }) => Composite.get(engine.world, body.id, 'body') && body.position.y > top() + h / 2 + 8)) { closed = true; buildWalls(); }
  });
  // vitesse plafonnée : un lancer violent ne traverse pas les murs
  Events.on(engine, 'beforeUpdate', () => items.forEach(({ body }) => { const v = body.velocity, s = Math.hypot(v.x, v.y); if (s > 32) Body.setVelocity(body, { x: (v.x / s) * 32, y: (v.y / s) * 32 }); }));

  // glisser, lancer
  const mouse = Mouse.create(stage);
  mouse.pixelRatio = 1;
  stage.removeEventListener('wheel', mouse.mousewheel); stage.removeEventListener('mousewheel', mouse.mousewheel); stage.removeEventListener('DOMMouseScroll', mouse.mousewheel);
  const mc = MouseConstraint.create(engine, { mouse, constraint: { stiffness: 0.12, damping: 0.12, render: { visible: false } } });
  Composite.add(engine.world, mc);
  let down = { x: 0, y: 0, t: 0 };
  Events.on(mc, 'startdrag', () => dispatchEvent(new CustomEvent('kk:sound', { detail: 'pick' })));
  Events.on(mc, 'enddrag', () => dispatchEvent(new CustomEvent('kk:sound', { detail: 'drop' })));
  stage.addEventListener('pointerdown', (e) => { down = { x: e.clientX, y: e.clientY, t: performance.now() }; });
  stage.addEventListener('pointerup', (e) => {
    if (Math.hypot(e.clientX - down.x, e.clientY - down.y) > 6 || performance.now() - down.t > 400) return;
    const hit = Query.point(items.map((it) => it.body), { x: e.clientX, y: e.clientY })[0];
    if (hit && sel && hit === sel.body) close(); // second clic sur l'objet ouvert : on referme
    else if (hit) open(hit.kk, true);
    else if (sel) close(); // toucher le vide referme
  });
  let hovered: string | null = null;
  stage.addEventListener('pointermove', (e) => {
    const hit = Query.point(items.map((it) => it.body), { x: e.clientX, y: e.clientY })[0];
    const id = hit ? hit.kk : null;
    if (id && id !== hovered) dispatchEvent(new CustomEvent('kk:sound', { detail: 'hover' }));
    hovered = id; stage.style.cursor = id ? 'grab' : 'default';
  });

  // clic : l'objet vient au premier plan, agrandi, à gauche ; le texte apparaît à droite ; les autres objets sont chassés
  let sel: (typeof items)[number] | null = null;
  // objet ouvert : la physique est suspendue (rien ne bouge, rien n'est poussé) jusqu'à ce que l'objet soit revenu à sa place
  let paused = false;
  const tween = (it: (typeof items)[number], tx: number, ty: number, ts: number, ta = 0, done?: () => void) => {
    const b = it.body, x0 = b.position.x, y0 = b.position.y, a0 = b.angle, s0 = it.s, t0 = performance.now(), dur = still ? 1 : 700, tok = ++it.tw;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const step = (now: number) => {
      if (tok !== it.tw) return; // un nouveau mouvement a pris le relais
      const p = ease(Math.min(1, (now - t0) / dur));
      Body.setPosition(b, { x: x0 + (tx - x0) * p, y: y0 + (ty - y0) * p }); Body.setAngle(b, a0 + (ta - a0) * p); it.s = s0 + (ts - s0) * p;
      if (p < 1) requestAnimationFrame(step); else done?.();
    };
    requestAnimationFrame(step);
  };
  // l'objet refermé retourne exactement là où on l'a pris (sur l'étagère, dans le tas), puis la physique le reprend
  const release = () => {
    if (!sel) return;
    const it = sel, h = it.home!; sel = null;
    it.el.classList.remove('sel');
    const land = () => { if (sel === it || !it.body.isStatic) return; Body.setPosition(it.body, { x: h.x, y: h.y }); Body.setAngle(it.body, h.a); it.s = 1; Body.setStatic(it.body, false); Body.setVelocity(it.body, { x: 0, y: 0 }); if (!sel) paused = false; };
    tween(it, h.x, h.y, 1, h.a, land);
    setTimeout(land, still ? 0 : 760); // filet de sécurité si l'animation est suspendue (onglet en arrière-plan)
  };
  // le titre s'écrit lettre à lettre ; le texte apparaît d'un bloc (découper un paragraphe en lettres le fait sauter de ligne)
  const reveal = () => {
    if (still) return;
    letters(card.querySelector('[data-title]')!, 200);
    card.querySelectorAll<HTMLElement>('.sub, .txt, .x').forEach((el, i) => el.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 500, delay: 260 + i * 60, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' }));
  };
  const open = (id: string, push: boolean) => {
    const d = D.find((x) => x.id === id); const it = items.find((x) => x.d.id === id); if (!d || !it) return;
    release();
    if (!big.hidden) hideTitle();
    card.querySelector('[data-sub]')!.textContent = d.sub;
    const lk = card.querySelector<HTMLAnchorElement>('[data-link]')!;
    lk.hidden = !d.link; if (d.link) { lk.href = d.link; lk.textContent = ' ↗'; lk.setAttribute('aria-label', 'Letterboxd'); }
    // lecteur intégré (iPod) : chargé seulement à l'ouverture, dans l'écran de l'objet
    const emb = it.el.querySelector<HTMLElement>('[data-emb]');
    if (emb && !emb.firstChild) emb.innerHTML = `<iframe src="${emb.dataset.emb}" title="Playlist" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>`;
    if (emb?.firstElementChild) (emb.firstElementChild as HTMLElement).style.transform = `scale(${emb.clientWidth / 300})`;
    card.querySelector('[data-title]')!.textContent = d.title;
    card.querySelector('[data-text]')!.textContent = d.text;
    card.hidden = false;
    card.scrollTop = 0;
    const r = (small ? card : card.querySelector('.in')!).getBoundingClientRect();
    // le monde se fige, les autres objets s'effacent (rien n'est chassé, tout reste à sa place)
    paused = true; root.classList.add('open');
    if (!it.body.isStatic) it.home = { x: it.body.position.x, y: it.body.position.y, a: it.body.angle };
    sel = it; it.el.classList.add('sel'); Body.setStatic(it.body, true);
    if (small) {
      // téléphone : l'objet se pose au centre de l'espace libre au-dessus de la feuille
      const t0 = top(), room = r.top - t0 - 32;
      tween(it, W / 2, t0 + 16 + room / 2, Math.min(d.embed ? 3.6 : 2.4, room / it.h, (W * 0.72) / it.w));
    } else {
      // ordinateur : l'objet au centre de la moitié gauche, le texte à droite (colonnes 7 à 10)
      const room = Math.min(r.left - 2 * 48, H - 2 * 140);
      tween(it, r.left / 2, H / 2, Math.min(d.embed ? 3.6 : 2.6, room / Math.max(it.w, it.h) * (d.embed ? 1.15 : 1)));
    }
    reveal();
    if (push) history.replaceState(null, '', `#${id}`);
    card.querySelector<HTMLElement>('[data-close]')!.focus({ preventScroll: true });
  };
  const close = () => {
    card.hidden = true; history.replaceState(null, '', location.pathname);
    root.classList.remove('open');
    release();
    showTitle(80);
  };
  card.querySelector('[data-close]')!.addEventListener('click', close);
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !card.hidden) close(); });
  // clavier : chaque objet est un bouton (Tab puis Entrée)
  items.forEach((it) => { it.el.style.pointerEvents = 'none'; it.el.addEventListener('click', () => (sel === it ? close() : open(it.d.id, true))); });

  addEventListener('resize', () => { W = innerWidth; H = innerHeight; buildWalls(); if (!big.hidden) buildShelf(); });

  const draw = () => items.forEach((it) => {
    const { el, body, w, h, ox, oy } = it; const sc = it.s;
    const ca = Math.cos(body.angle), sa = Math.sin(body.angle);
    const cx = body.position.x + ox * ca - oy * sa, cy = body.position.y + ox * sa + oy * ca;
    el.style.transform = `translate(${cx - w / 2}px, ${cy - h / 2}px) rotate(${body.angle}rad) scale(${sc})`;
  });
  if (still) { setTimeout(() => { for (let i = 0; i < 600; i++) Engine.update(engine, 1000 / 60); }, 10); }
  let last = performance.now();
  const tick = (now: number) => {
    const dt = Math.min(32, now - last); last = now;
    if (!document.hidden && !paused) Engine.update(engine, dt);
    draw(); requestAnimationFrame(tick);
  };
  draw(); requestAnimationFrame(tick);
  const h0 = location.hash.slice(1);
  if (h0) setTimeout(() => open(h0, false), still ? 0 : 1600);
</script>
