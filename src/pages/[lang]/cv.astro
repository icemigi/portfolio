---
// CV en terminal : page cachée (lien dans le pied de page seulement, hors plan du site, noindex).
// Le CV complet est écrit dans la page (lisible sans JavaScript) ; le script le rejoue comme une session
// puis attend des commandes : help, profil, xp, projets, formation, outils, interets, contact, cv, clear, lang, exit.
import Base from '../../layouts/Base.astro';
import { languages, getLangFromParam } from '../../data/ui';
import { cv, sectionHtml, headHtml } from '../../data/cv';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const c = cv[lang];
const other = lang === 'fr' ? 'en' : 'fr';
const full = headHtml(c) + c.sections.map(sectionHtml).join('');
const data = {
  lang, other, full,
  ui: c.ui,
  sections: c.sections.map((s) => ({ id: s.id, cmd: s.cmd, html: sectionHtml(s) })),
};
const PS = 'xavier@kerningkastle ~ %';
---
<Base lang={lang} title="CV — Xavier M. Diez" description={c.role} path="cv/" bare>
  <h1 class="sr">CV — Xavier M. Diez</h1>
  <div class="term" data-term data-cv={JSON.stringify(data)}>
    <div class="bar">
      <span class="ttl mu">xavier — cv — zsh</span>
      <span class="act">
        <span class="lg"><a href="/en/cv/" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>en</a> / <a href="/fr/cv/" data-lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>fr</a></span>
        <a href={`/${lang}/`}>exit</a>
      </span>
    </div>
    <div class="out" data-out aria-live="polite">
      <p class="t-cmd"><span class="ps">{PS}</span> cat cv.txt</p>
      <Fragment set:html={full} />
    </div>
    <form class="in" data-form autocomplete="off">
      <label class="ps" for="cv-in">{PS}</label>
      <input id="cv-in" data-in type="text" spellcheck="false" autocapitalize="off" aria-label={c.ui.hint} />
    </form>
    <nav class="chips" aria-label={c.ui.help}>
      {c.sections.map((s) => s.cmd[0]).map((k) => <button type="button" data-cmd={k}>{k}</button>)}
    </nav>
  </div>
</Base>

<style>
  :global(html:has(.term)) { --bg: #0e0e0d; --fg: #e9e7e0; --mu: #8b8880; --ln: rgba(255, 255, 255, .12); color-scheme: dark; }
  :global(html:has(.term) body) { background: var(--bg); color: var(--fg); }
  .term { position: fixed; inset: 0; display: flex; flex-direction: column; font-family: var(--mono); font-size: 14px; line-height: 22px; padding: 0 var(--m); }
  .bar { display: flex; align-items: center; gap: 16px; height: var(--head); flex: none; border-bottom: 1px solid var(--ln); }
  /* barre épurée (14/11) : le titre à gauche, langue et sortie à droite */
  .ttl { flex: 1; }
  .act { display: flex; gap: 20px; }
  .act a:hover, .chips button:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  .act a { color: var(--mu); } .act .lg [aria-current='true'] { color: var(--fg); }
  .out { flex: 1; overflow-y: auto; padding: 28px 0 8px; scrollbar-width: none; max-width: 980px; }
  .out::-webkit-scrollbar { display: none; }
  .out :global(p) { margin: 0; }
  .out :global(.t-cmd) { margin-top: 18px; }
  .out :global(.t-cmd:first-child) { margin-top: 0; }
  .out :global(.t-name) { font-family: var(--sans); font-weight: 500; font-size: clamp(40px, 7vw, 88px); line-height: 1; letter-spacing: -0.04em; margin: 20px 0 14px; text-transform: none; }
  .out :global(.t-h) { margin-top: 26px; margin-bottom: 6px; color: var(--mu); }
  .out :global(.t-e), .out :global(.t-i) { display: grid; grid-template-columns: 150px 1fr; gap: 0 20px; }
  .out :global(.t-e) { margin-top: 10px; }
  .out :global(.t-e b) { font-weight: 400; color: var(--fg); }
  .out :global(.t-d), .out :global(.t-m) { color: var(--mu); }
  .out :global(.t-i) { color: #c9c6be; }
  .out :global(.t-p) { max-width: 72ch; }
  .out :global(.t-err) { color: #e0806a; }
  .out :global(.t-wait) { visibility: hidden; }  .out :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .ps { color: var(--ac); white-space: nowrap; }
  .in { display: flex; gap: 10px; align-items: baseline; padding: 6px 0 4px; flex: none; }
  .in input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--fg); font: inherit; caret-color: var(--ac); padding: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px 18px; padding: 10px 0 22px; border-top: 1px solid var(--ln); flex: none; }
  .chips button { color: var(--mu); padding: 4px 0; }
  .term :global(.typing)::after { content: '▍'; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 760px) {
    .term { font-size: 13px; line-height: 20px; }
    .ttl { display: none; }
    .bar { justify-content: space-between; }
    .out :global(.t-e), .out :global(.t-i) { grid-template-columns: 1fr; }
    .out :global(.t-i .t-d) { display: none; }
    .ps { display: none; }
    .in::before { content: '%'; color: var(--mu); }
  }
</style>

