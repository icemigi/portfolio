---
// Mentions légales (obligatoires en France, loi pour la confiance dans l'économie numérique).
// SIRET : à compléter dès réception (07/11).
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { languages, getLangFromParam } from '../../data/ui';
import { contact } from '../../data/about';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const fr = lang === 'fr';
const S = fr
  ? [
      ['Éditeur', `Xavier Mediavilla Diez, entrepreneur individuel (kerningkastle) · SIRET [en cours] · adresse communiquée sur demande · ${contact.email}`],
      ['Directeur de la publication', 'Xavier Mediavilla Diez'],
      ['Hébergeur', 'GitHub, Inc. · 88 Colin P Kelly Jr St, San Francisco, CA 94107, États-Unis · support@github.com'],
      ['Propriété intellectuelle', 'Les textes, images, caractères et codes présentés sur ce site appartiennent à kerningkastle ou à leurs ayants droit. Toute reproduction sans accord écrit est interdite.'],
      ['Données personnelles', 'Ce site ne dépose aucun cookie. La fréquentation est mesurée par GoatCounter, sans cookie et sans donnée permettant de vous identifier. Seuls deux réglages (langue, son) sont gardés dans votre navigateur et ne sont transmis à personne. Les messages envoyés par email ne servent qu\'à vous répondre.'],
      ['Crédits', 'Conception, design et code : kerningkastle. Caractère Geist (licence SIL Open Font License).'],
    ]
  : [
      ['Publisher', `Xavier Mediavilla Diez, sole trader (kerningkastle) · SIRET [pending] · address available upon request · ${contact.email}`],
      ['Publication director', 'Xavier Mediavilla Diez'],
      ['Hosting', 'GitHub, Inc. · 88 Colin P Kelly Jr St, San Francisco, CA 94107, USA · support@github.com'],
      ['Intellectual property', 'Texts, images, typefaces and code shown on this site belong to kerningkastle or their rights holders. Any reproduction without written consent is prohibited.'],
      ['Personal data', 'This site sets no cookies. Visits are counted by GoatCounter, without cookies and without any data that could identify you. Only two settings (language, sound) are kept in your browser and shared with no one. Emails you send are only used to reply to you.'],
      ['Credits', 'Concept, design and code: kerningkastle. Geist typeface (SIL Open Font License).'],
    ];
---
<Base lang={lang} title={fr ? 'Mentions légales' : 'Legal notice'} description={fr ? 'Mentions légales de kerningkastle.com : éditeur, hébergement (GitHub Pages), données personnelles (aucun cookie, mesure d\'audience GoatCounter) et crédits.' : 'Legal notice for kerningkastle.com: publisher, hosting (GitHub Pages), personal data (no cookies, GoatCounter analytics) and credits.'} path="legal/">
  <div class="screens-host" data-screens>
    <section class="scr all">
      <div class="page">
        <div class="g body">
          <h1 class="k mono mu par">{fr ? 'Mentions légales' : 'Legal notice'}</h1>
          <dl class="v">{S.map(([k, v]) => <div><dt class="mono mu">{k}</dt><dd>{v}</dd></div>)}</dl>
        </div>
        <Footer lang={lang} />
      </div>
    </section>
    {/* téléphone : le même texte réparti en écrans, pour qu'aucun ne demande de défiler (masqués sur ordinateur) */}
    {[S.slice(0, 3), S.slice(3, 5)].map((part, i) => (
      <section class="scr part">
        <div class="in g">
          <p class="k mono mu par">{fr ? 'Mentions légales' : 'Legal notice'} {i + 1}/3</p>
          <dl class="v">{part.map(([k, v]) => <div><dt class="mono mu">{k}</dt><dd>{v}</dd></div>)}</dl>
        </div>
      </section>
    ))}
    <section class="scr part end">
      <div class="in g">
        <p class="k mono mu par">{fr ? 'Mentions légales' : 'Legal notice'} 3/3</p>
        <dl class="v">{S.slice(5).map(([k, v]) => <div><dt class="mono mu">{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <Footer lang={lang} class="line" />
    </section>
  </div>
</Base>

<style>
  .page { min-height: 100%; display: flex; flex-direction: column; }
  .part { display: none; }
  .body { flex: 1; padding-top: calc(var(--head) + 24px); padding-bottom: 40px; align-content: start; align-items: first baseline; row-gap: 24px; }
  .k { grid-column: 1 / 4; }
  .v { grid-column: 4 / 10; }
  .v div + div { margin-top: 24px; }
  .v dd { margin-top: 4px; }
  @media (max-width: 760px) {
    .all { display: none; }
    .part { display: block; }
    .part.end { display: flex; flex-direction: column; }
    .part.end .in { flex: 1; min-height: 0; }
    .k, .v { grid-column: 1 / -1; }
    .k { position: absolute; top: calc(var(--head) + 20px); left: var(--m); }
    .v { font-size: clamp(13px, 2.1dvh, 16px); line-height: 1.4; }
    .v div + div { margin-top: min(20px, 2.2dvh); }
  }
</style>
