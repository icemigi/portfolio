---
// Étude de cas, mise en page magazine : chaque écran est une double page composée (texte et visuels ensemble,
// contrastes d'échelle), la disposition change d'un écran à l'autre. Titre · accroche · doubles pages · planche contact
// · projet suivant. Un seul libellé entre parenthèses par écran. Le défilement reste celui du site (un geste = un écran).
// Fin : l'anneau se remplit en 3,5 s puis ouvre le projet suivant (le titre glisse et grandit jusqu'au titre de la page suivante).
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../../data/ui';
import { projects } from '../../../data/projects';
import { media, type Img } from '../../../data/media';
import { captions } from '../../../data/captions';
import { rich, first } from '../../../data/text';
import KernOutdoor from '../../../components/case/KernOutdoor.astro';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const index = projects.findIndex((p) => p.slug === Astro.params.slug);
const project = projects[index];
const c = project[lang];
const next = projects[(index + 1) % projects.length];
const nc = next[lang];
const N = pad(projects.length);

type Para = { t?: string; p: string };
type Group = { k: string; paras: Para[]; list?: boolean };
type Block =
  | { kind: 'hook'; k: string; p: string; img?: Img }
  | { kind: 'chap'; side: 'l' | 'r'; k: string; phrase: string; notes: Para[]; img?: Img }
  | { kind: 'list'; k: string; items: { k: string; v: string }[] }
  | { kind: 'vis'; imgs: Img[] }
  | { kind: 'gen'; src: string };
const M = media[project.slug];
// grandes images : une version 800 px (public/work/**/<nom>-800.webp) pour les téléphones
const ss = (im: { src: string; w: number }) => (im.w > 1000 ? `${im.src.replace(/\.webp$/, '-800.webp')} 800w, ${im.src} ${im.w}w` : undefined);
const vid = (src: string) => /\.(mp4|webm)$/i.test(src);
const len = (ps: Para[]) => ps.reduce((n, x) => n + (x.t?.length ?? 0) + x.p.length, 0);

// rubriques : rubrique fixe (r) + titre propre au projet (h)
const S = c.sections;
const groups: Group[] = [];
if (c.text) groups.push({ k: fr ? 'le projet' : 'the project', paras: c.text.map((p) => ({ p })) });
S.forEach((s) => groups.push({ k: s.r ? `${s.r} — ${s.h.toLowerCase()}` : s.h.toLowerCase(), paras: s.paras }));
groups.forEach((g) => { if (g.paras.length > 1 && g.paras.every((x) => x.t)) g.list = true; });

// Cadre commun : page de garde, accroche, projet suivant, et un texte court (une rubrique par écran : une grande phrase,
// la suite en petite note mono). Le milieu peut être propre au projet (src/components/case/) ; sinon, la mise en page
// par défaut : rubriques avec une image chacune, générateur, visuels restants. Aucune image n'est recadrée.
const ALL: Img[] = M ? [M.cover, ...(M.gal ?? []).flat().filter((im) => im.src !== M.cover.src && !vid(im.src))] : [];
const pool = [...ALL];
// première phrase : jusqu'au premier point (ou ! ? …) suivi d'une majuscule ; le reste part en note
const blocks: Block[] = [{ kind: 'hook', k: fr ? 'en bref' : 'in short', p: c.lead, img: pool.shift() }];
groups.filter((g) => !g.list).forEach((g, i) => {
  const [ph, rest] = first(g.paras[0].p);
  blocks.push({ kind: 'chap', side: i % 2 ? 'l' : 'r', k: g.k, phrase: (g.paras[0].t ? `${g.paras[0].t} ` : '') + ph, notes: [...(rest ? [{ p: rest }] : []), ...g.paras.slice(1)], img: pool.shift() });
});
groups.filter((g) => g.list).forEach((g) => blocks.push({ kind: 'list', k: g.k, items: g.paras.map((x) => ({ k: x.t!.replace(/[\s.:]+$/, ''), v: x.p })) }));
if (project.generator) blocks.push({ kind: 'gen', src: project.generator });
while (pool.length) blocks.push({ kind: 'vis', imgs: pool.splice(0, 6) }); // six au plus par écran
if (c.blocks?.length) blocks.push({ kind: 'list', k: fr ? 'en bref' : 'in short', items: c.blocks });
// projets à architecture propre : leur milieu remplace les blocs par défaut (l'accroche reste commune)
const Own = ({ 'kern-outdoor': KernOutdoor } as Record<string, typeof KernOutdoor>)[project.slug];

// textes alternatifs et légendes : celle de captions.ts, sinon « visuel 03/19 »
const imgTotal = ALL.length;
const imgNo = (im: Img) => ALL.indexOf(im) + 1;
const capOf = (im: Img) => captions[im.src]?.[lang] || `${fr ? 'visuel' : 'visual'} ${pad(imgNo(im))}/${pad(imgTotal)}`;
const pic = (im: Img, sizes: string) => ({ i: ALL.indexOf(im), src: im.src, srcset: ss(im), sizes, w: im.w, h: im.h, r: +(im.w / im.h).toFixed(4), alt: `${c.title} — ${capOf(im)}`, cap: capOf(im), n: `${pad(imgNo(im))}/${pad(imgTotal)}` });
type Pic = ReturnType<typeof pic>;
// données structurées : l'étude comme œuvre, signée par la personne décrite dans Base (#me)
const home = new URL('/', Astro.site ?? 'https://kerningkastle.com').href;
const workLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: c.title, description: c.lead, inLanguage: lang,
  url: new URL(`/${lang}/work/${project.slug}/`, home).href,
  ...(M ? { image: new URL(M.cover.src, home).href } : {}),
  ...(project.years.length ? { dateCreated: String(project.years[0]) } : {}),
  creator: { '@id': `${home}#me` }, isPartOf: { '@id': `${home}#site` },
};
---
<Base lang={lang} title={c.title} description={c.lead.length < 110 ? `${c.lead} ${c.meta.role} · ${c.meta.tools}.` : c.lead} path={`work/${project.slug}/`} active="work">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
    <script is:inline>
      // arrivée par « Projet suivant » : drapeau lu tout de suite, puis effacé
      try { window.kkArriving = sessionStorage.getItem('kk-next') === '1'; sessionStorage.removeItem('kk-next'); } catch (e) { window.kkArriving = false; }
      // navigateurs sans transition entre pages (Firefox, Zen…) : la page arrive titre d'abord, par un repli en JS (voir plus bas)
      window.kkXVT = 'CSSViewTransitionRule' in window && 'onpagereveal' in window;
      if (window.kkArriving && !window.kkXVT) document.documentElement.classList.add('kk-flip');
      if (window.kkArriving) document.documentElement.classList.add('kk-arr');
      // titre continu (transition entre documents) : seulement pour l'ouverture du projet suivant ; ailleurs, le fondu enchaîné de global.css
      addEventListener('pageswap', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkLeavingNext || !window.kkXVT) return; // sinon : fondu enchaîné commun
        const h = document.querySelector('.next-title .vt'); if (h) h.style.viewTransitionName = 'case-title';
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkArriving || !window.kkXVT) return;
        const h = document.querySelector('.case-h1 .vt'); if (h) h.style.viewTransitionName = 'case-title';
      });
    </script>
  </Fragment>

  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label={fr ? 'Visuel agrandi' : 'Enlarged visual'}>
    <img alt="" decoding="async" />
    <p class="lbc mono"><span data-lbc></span><span class="mu" data-lbn></span></p>
  </div>

  <div class="screens-host case free" data-screens data-no-arrow data-pi={index}>
    <section class="scr s1" aria-labelledby="case-title">
      <div class="head g">
        <p class="lab mono mu par s1-late" data-cl><span class="vl">{fr ? 'projet' : 'project'} {pad(index + 1)}/{N}</span></p>
        <h1 class="case-h1" id="case-title"><span class="vt">{c.title}</span></h1>
        <dl class="fiche mono s1-late">
          <div><dt class="mu">{t.meta.year}</dt><dd>{c.meta.year}</dd></div>
          <div><dt class="mu">{t.meta.context}</dt><dd>{c.meta.context}</dd></div>
          <div><dt class="mu">{t.meta.role}</dt><dd>{c.meta.role}</dd></div>
          <div><dt class="mu">{t.meta.tools}</dt><dd>{c.meta.tools}</dd></div>
        </dl>
      </div>
    </section>
    <script is:inline>
      // arrivée par « Projet suivant » sans transition native (Firefox, Zen) : le titre est posé à son ancienne place
      // (position et taille de la page précédente) AVANT le premier affichage — aucune image sans titre, aucun saut ;
      // le script de la page le fait ensuite glisser jusqu'à sa place.
      (function () {
        var r = document.documentElement; if (!r.classList.contains('kk-arr')) return;
        // la page de garde est affichée tout de suite (sans attendre le script des écrans) : pas d'image vide à l'arrivée
        var s1 = document.querySelector('.s1'); if (s1) s1.classList.add('on');
        if (!r.classList.contains('kk-flip')) return;
        var h = document.querySelector('.case-h1'), v = h && h.querySelector('.vt'), f = null;
        try { f = JSON.parse(sessionStorage.getItem('kk-next-r') || 'null'); sessionStorage.removeItem('kk-next-r'); } catch (e) {}
        if (!v) return;
        var b = v.getBoundingClientRect();
        if (b.width > h.clientWidth) { h.style.fontSize = parseFloat(getComputedStyle(h).fontSize) * h.clientWidth / b.width * 0.98 + 'px'; b = v.getBoundingClientRect(); }
        if (f) { var tr = 'translate(' + (f.x - b.left) + 'px,' + (f.y - b.top) + 'px) scale(' + (f.w ? f.w / b.width : 1) + ')'; v.style.transformOrigin = '0 0'; v.style.transform = tr; v.dataset.from = tr; }
        v.style.opacity = '1';
      })();
    </script>

    {(Own ? blocks.filter((b) => b.kind === 'hook') : blocks).map((b) =>
      b.kind === 'hook' ? (
        <section class="scr">
          <div class="in g ch hook">
            <h2 class="lab mono mu par" data-caplab>{b.k}</h2>
            <p class="lead t56" data-hola data-fit set:html={rich(b.p)} />
            {b.img && ((p: Pic) => <div class="slot" data-slot data-fly="cover" data-card style={`--r:${p.r}`}><img class="md" src={p.src} srcset={p.srcset} sizes={p.sizes} width={p.w} height={p.h} alt={p.alt} data-cap={p.cap} data-n={p.n} data-i={p.i} loading="lazy" decoding="async" /></div>)(pic(b.img, '(max-width: 760px) 100vw, 50vw'))}
          </div>
        </section>
      ) : b.kind === 'chap' ? (
        <section class="scr">
          <div class:list={['in g ch chap', b.side, { solo: !b.img }]}>
            <h2 class="lab mono mu par" data-caplab>{b.k}</h2>
            <p class="phr t56" data-hola data-fit set:html={rich(b.phrase)} />
            {b.notes.length > 0 && <div class="nts mono mu">{b.notes.map((pp) => <p>{pp.t && <b>{pp.t} </b>}<Fragment set:html={rich(pp.p, 'note')} /></p>)}</div>}
            {b.img && ((p: Pic) => <div class="slot" data-slot data-card style={`--r:${p.r}`}><img class="md" src={p.src} srcset={p.srcset} sizes={p.sizes} width={p.w} height={p.h} alt={p.alt} data-cap={p.cap} data-n={p.n} data-i={p.i} loading="lazy" decoding="async" /></div>)(pic(b.img, '(max-width: 760px) 100vw, 50vw'))}
          </div>
        </section>
      ) : b.kind === 'list' ? (
        <section class="scr">
          <div class="in g">
            <h2 class="lab mono mu par">{b.k}</h2>
            <ul class="bd idx" data-hola data-fit>
              {b.items.map((it, i) => (
                <li><span class="mono mu n">{pad(i + 1)}</span><h3 class="t28">{it.k}</h3><p class="mono mu dl">{it.v}</p></li>
              ))}
            </ul>
          </div>
        </section>
      ) : b.kind === 'vis' ? (
        <section class="scr" data-still>
          <div class="in g ch vis">
            <p class="lab mono mu par" data-caplab>{fr ? 'visuels' : 'visuals'}</p>
            <div class="rows">{b.imgs.map((im) => ((p: Pic) => <span class="cd" data-card style={`--r:${p.r}`}><img class="md" src={p.src} srcset={p.srcset} sizes={p.sizes} width={p.w} height={p.h} alt={p.alt} data-cap={p.cap} data-n={p.n} data-i={p.i} loading="lazy" decoding="async" /></span>)(pic(im, '(max-width: 760px) 50vw, 30vw')))}</div>
          </div>
        </section>
      ) : (
        <section class="scr">
          <div class="in g">
            <p class="lab mono mu par">{fr ? 'générateur' : 'generator'}</p>
            <div class="bd gen">
              <p class="mono mu">{fr ? 'entrez une clé, obtenez son blason' : 'enter a key, get its coat of arms'}</p>
              <iframe src={b.src} title={fr ? 'Générateur héraldique' : 'Heraldry generator'} loading="lazy"></iframe>
            </div>
          </div>
        </section>
      ),
    )}

    {Own && <Own lang={lang} c={c} M={M!} pic={pic} rich={rich} />}

    <section class="scr nx" aria-labelledby="next-l">
      <div class="in g">
        <p class="lab mono mu par" id="next-l" data-cl><span class="vl">{t.next} {pad(((index + 1) % projects.length) + 1)}/{N}</span></p>
        <div class="bd tt">
          <h2 class="next-title t56"><span class="vt">{nc.title}</span></h2>
          <p class="mono mu">{nc.short} — {next.yearLabel}</p>
        </div>
        <a class="ring" href={`/${lang}/work/${next.slug}/`} data-next aria-label={`${t.next} : ${nc.title}`}>
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="54" class="track0" /><circle cx="60" cy="60" r="54" class="arc" data-arc /></svg>
          <span class="mono" aria-hidden="true">{t.nextShort}</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  /* Titre continu : le titre du projet suivant glisse jusqu'à sa place de titre, sans fondu ni déformation
     (même texte, même taille, une seule ligne : seul le déplacement est animé). L'ancienne page disparaît net,
     la nouvelle arrive une fois le titre posé. */
  .vt { display: inline-block; white-space: nowrap; }
  ::view-transition-group(case-title) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-title) { animation: none; opacity: 0; }
  ::view-transition-new(case-title) { animation: none; }
  ::view-transition { background: var(--bg); }
  html.kk-arr::view-transition-old(root) { animation: none; opacity: 0; }
  html.kk-arr::view-transition-new(root) { animation: kk-vt-in .9s both; }
  @keyframes kk-vt-in { 0%, 70% { opacity: 0; } 100% { opacity: 1; } }
  /* repli sans transition entre pages : le titre attend d'être replacé à son ancienne position, le menu arrive après lui */
  html.kk-flip .case-h1 .vt, html.kk-flip .site-header { opacity: 0; }
  /* page de garde : le numéro et la fiche n'apparaissent qu'une fois le titre posé (en CSS : aucun affichage avant le script) */
  html.js .s1-late { animation: kk-late .45s cubic-bezier(.2,.7,.2,1) 1s both; }
  html.js.kk-arr .s1-late { animation-delay: 1.15s; }
  html.js .s1-late + .s1-late { animation-delay: 1.12s; }
  html.js.kk-arr .s1-late + .s1-late { animation-delay: 1.27s; }
  @keyframes kk-late { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { html.js .s1-late { animation: none; } }
</style>

<style>
  :global(.glue) { white-space: nowrap; }
  :global(.case .note) { display: inline-block; font-size: 12px; line-height: 0; letter-spacing: 0; vertical-align: super; margin-left: 2px; }
  /* Gabarit : libellé entre parenthèses en colonnes 1 à 3, contenu sur la grille de 12 colonnes du site.
     Doubles pages : la ligne utile va du dessous du menu au bas de l'écran ; chaque élément s'y pose (haut, milieu, bas). */
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .bd { grid-column: 4 / 11; align-self: first baseline; }

  /* page de garde : très grand titre en bas, fiche dessous */
  .s1 .head { height: 100%; align-content: stretch; grid-template-rows: auto 1fr auto auto; row-gap: 24px; padding-top: calc(var(--head) + 24px); padding-bottom: 32px; }
  .s1 .lab { grid-row: 1; }
  .case-h1 { grid-column: 1 / -1; grid-row: 3; font-weight: 500; font-size: min(10.5vw, 17dvh); line-height: .86; letter-spacing: -0.05em; margin-left: -.05em; }
  .fiche { grid-column: 1 / -1; grid-row: 4; display: grid; grid-template-columns: subgrid; border-top: 1px solid var(--ln); padding-top: 12px; }
  .fiche > div { grid-column: span 3; }
  .fiche dd { margin-top: 4px; }

  /* écrans de chapitre : texte d'un côté, image de l'autre (côté alterné), l'image dans sa proportion d'origine.
     La case (.slot) prend la forme de l'image : largeur bornée par la colonne et par la hauteur utile. */
  .ch { height: 100%; min-height: 0; align-content: center; align-items: center; padding-top: calc(var(--head) + 24px); padding-bottom: 48px; }
  .ch .lab { align-self: start; }
  .slot { --hmax: calc(100dvh - var(--head) - 120px); position: relative; width: min(100%, calc(var(--hmax) * var(--r))); aspect-ratio: var(--r); justify-self: center; }
  .slot img { display: block; width: 100%; height: 100%; object-fit: contain; cursor: zoom-in; }
  .hook .lab { grid-column: 1 / 4; grid-row: 1; }
  .hook .lead { grid-column: 1 / 7; grid-row: 1; align-self: center; font-size: clamp(28px, 6.6dvh, 54px); }
  .hook .slot { grid-column: 8 / -1; grid-row: 1; }
  /* chapitre : libellé, grande phrase, notes mono dessous ; l'image à droite, sortie de la planche */
  .chap .lab { grid-column: 1 / -1; grid-row: 1; align-self: end; }
  .chap .phr { grid-column: 1 / 7; grid-row: 2; margin-top: 18px; font-size: clamp(28px, 6.2dvh, 52px); }
  .chap .nts { grid-column: 1 / 6; grid-row: 3; margin-top: 22px; font-size: 12px; line-height: 1.55; text-transform: none; max-width: 52ch; }
  .chap .nts b { font-weight: 500; }
  .chap .nts p + p { margin-top: .6em; }
  .chap .slot { grid-column: 8 / -1; grid-row: 1 / 4; }
  .chap.solo .phr { grid-column: 1 / 11; }
  /* alternance (l'accroche est à gauche) : premier chapitre texte à droite, puis à gauche, etc. */
  .chap.r .lab, .chap.r .phr { grid-column: 7 / -1; }
  .chap.r .nts { grid-column: 7 / 12; }
  .chap.r .slot { grid-column: 1 / 6; }
  .chap.r.solo .lab, .chap.r.solo .phr { grid-column: 3 / -1; }
  .chap.r.solo .nts { grid-column: 3 / 9; }
  /* défilement libre : chaque bloc à sa hauteur, avec de l'air ; page de garde et fin à la hauteur de l'écran */
  .case.free .s1 .head { height: auto; min-height: 100svh; }
  .case.free .ch { height: auto; min-height: 86svh; }
  .case.free .nx .in { min-height: 100svh; }
  /* composition (ordinateur) : le libellé toujours au même endroit en haut ; tout le reste centré dans la hauteur de
     l'écran — le visuel, et le bloc de texte (phrase + note) centré sur le milieu du visuel */
  @media (min-width: 761px) {
    .ch { align-content: center; align-items: center; padding-top: calc(var(--head) + 48px); padding-bottom: 56px; }
    .ch .lab, .hook .lab, .chap .lab, .chap.r .lab, .chap.r.solo .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); margin: 0; grid-area: auto; }
    .chap.r .lab { left: calc(var(--m) + (100% - 2 * var(--m) + var(--gut)) / 2); }
    .chap.r.solo .lab { left: calc(var(--m) + (100% - 2 * var(--m) + var(--gut)) / 6); }
    .slot { --hmax: calc(100dvh - var(--head) - 160px); }
    .hook .lead, .hook .slot { align-self: center; }
    .chap { grid-template-rows: 1fr auto auto 1fr; } /* phrase + note groupées au milieu, le visuel sur toute la hauteur */
    .chap .phr { grid-row: 2; margin-top: 0; align-self: end; }
    .chap .nts { grid-row: 3; align-self: start; }
    .chap .slot { grid-row: 1 / 5; align-self: center; }
  }
  /* visuels restants : rangées d'images à hauteur égale, chacune à sa largeur naturelle (aucun rognage) */
  .vis .rows { grid-column: 4 / -1; display: flex; flex-wrap: wrap; justify-content: flex-start; align-content: center; gap: var(--gut); }
  .vis .rows .cd { display: block; height: min(26dvh, 240px); aspect-ratio: var(--r); }
  .vis .rows img { height: 100%; width: 100%; aspect-ratio: var(--r); object-fit: contain; cursor: zoom-in; }
  /* l'image qui voyage d'un écran à l'autre (transition morphée, pilotée par le défilement) */
  /* passage d'un élément d'un écran au suivant (data-fly) : une copie fixe fait le trajet, les originaux s'effacent pendant ce temps */
  :global(.fly) { position: fixed; z-index: 4; left: 0; top: 0; pointer-events: none; object-fit: contain; will-change: transform; }

  .idx { display: grid; grid-template-columns: subgrid; row-gap: 20px; }
  .idx > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 4px; align-items: baseline; }
  .idx .n { font-size: 12px; grid-column: 1; grid-row: 1; }
  .idx h3 { grid-column: 2 / -1; font-weight: 500; }
  .idx .dl { grid-column: 2 / -1; font-size: 12px; text-transform: none; }

  .gen { display: grid; row-gap: 16px; grid-column: 4 / -1; }
  .gen iframe { width: 100%; aspect-ratio: 16 / 9; max-height: calc(100dvh - var(--head) - 180px); border: 1px solid var(--ln); background: #fff; }

  /* zoom */
  .lb { position: fixed; inset: 0; z-index: 70; display: grid; place-items: center; padding: calc(var(--head) + 8px) var(--m) 56px; background: color-mix(in srgb, var(--bg) 96%, transparent); }
  .lb[hidden] { display: none; }
  .lb img { max-width: 100%; max-height: calc(100dvh - var(--head) - 64px); width: auto; height: auto; object-fit: contain; }
  .lbc { position: absolute; left: var(--m); bottom: 20px; right: var(--m); display: flex; justify-content: space-between; font-size: 12px; text-transform: none; }

  /* projet suivant */
  .nx .in { position: relative; align-content: start; }
  .nx .tt > .mono { margin-top: 12px; }
  .ring { position: absolute; right: var(--m); bottom: 40px; width: 160px; height: 160px; display: grid; place-items: center; }
  .ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring circle { fill: none; stroke-width: 1.5; }
  .ring .track0 { stroke: var(--ln); }
  .ring .arc { stroke: var(--fg); stroke-dasharray: 339.3; stroke-dashoffset: 339.3; transform: rotate(-90deg); transform-origin: 60px 60px; }
  .vl { display: inline-block; white-space: nowrap; }

  @media (max-width: 760px) {
    .lab, .bd, .gen { grid-column: 1 / -1; }
    .s1 .head { grid-template-rows: auto 1fr auto auto; row-gap: 16px; padding-top: calc(var(--head) + 20px); padding-bottom: min(32px, 4dvh); }
    .case-h1 { font-size: min(15vw, 12dvh); }
    .fiche { grid-template-columns: 1fr 1fr; gap: 12px var(--gut); border-top: 0; padding-top: 0; }
    .fiche > div { grid-column: auto; }
    .idx { grid-template-columns: 1fr auto; row-gap: min(20px, 2.4dvh); }
    .idx h3 { grid-column: 1; grid-row: 1; }
    .idx .n { grid-column: 2; grid-row: 1; justify-self: end; }
    .idx .dl { grid-column: 1 / -1; grid-row: 2; }
    /* téléphone : l'image en haut, le texte dessous, toujours sur un écran */
    .ch { align-content: end; row-gap: 18px; padding-top: calc(var(--head) + 48px); padding-bottom: min(56px, 7dvh); }
    .ch .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); margin: 0; }
    .slot { --hmax: 38dvh; grid-column: 1 / -1 !important; grid-row: auto !important; }
    .hook .lead, .chap .phr, .chap .nts { grid-column: 1 / -1 !important; grid-row: auto; }
    .hook .lead, .chap .phr { font-size: min(8.6vw, 4.2dvh); }
    .chap .phr { margin-top: 0; }
    .chap .nts { margin-top: 0; font-size: 11px; }
    .ch .slot { order: -1; }
    .hook .lab, .chap .lab, .chap.r .lab, .chap.r.solo .lab { grid-area: auto; }
    .vis .rows { grid-column: 1 / -1; }
    .vis .rows .cd { height: min(18dvh, 30vw); }
    .nx .in { align-content: start; padding-top: calc(var(--head) + 56px); }
    .nx .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); }
    .ring { width: 112px; height: 112px; bottom: min(72px, 9dvh); left: var(--m); right: auto; }
  }
</style>

<script>
  import { letters, reduced } from '../../../scripts/motion';
  import { initFlow, enterOnce, maskIn, ScrollTrigger } from '../../../scripts/flow';
  const run = () => {
    const api = window.kkScreens!;
    const host = document.querySelector<HTMLElement>('[data-screens]')!;
    const last = api.count - 1;
    const ring = document.querySelector<HTMLAnchorElement>('[data-next]')!;
    const arc = document.querySelector<SVGCircleElement>('[data-arc]')!;
    const RING = 3500;
    let fill: Animation | null = null;
    const root = document.documentElement;
    const arriving = (window as any).kkArriving;

    // arrivée par « Projet suivant », sans transition native : le titre, déjà posé à son ancienne place avant le premier
    // affichage (script en ligne sous la page de garde), glisse et grandit jusqu'à sa place ; le menu revient après lui
    if (root.classList.contains('kk-flip')) {
      const v = document.querySelector<HTMLElement>('.case-h1 .vt')!, hd = document.querySelector<HTMLElement>('.site-header');
      const from = v.dataset.from;
      root.classList.remove('kk-flip');
      if (from) {
        v.style.transform = '';
        v.animate([{ transformOrigin: '0 0', transform: from }, { transformOrigin: '0 0', transform: 'none' }], { duration: 1000, easing: 'cubic-bezier(.7, 0, .2, 1)' });
      }
      hd?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, delay: 620, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' });
    }
    if (arriving) letters(api.el(0), 650, '.case-h1');

    // arrivée par la molette depuis le projet précédent : l'élan du geste qui a ouvert la page ne doit pas faire sauter
    // la page de garde. La molette est ignorée tant que ce geste dure (au moins 0,9 s, puis jusqu'à 0,25 s de calme).
    if (arriving) {
      const t0 = performance.now();
      let lastW = t0;
      host.style.overflowY = 'hidden'; // défilement natif figé tant que dure l'élan du geste qui a ouvert la page
      const onW = () => { lastW = performance.now(); };
      addEventListener('wheel', onW, { passive: true, capture: true });
      const check = () => {
        const now = performance.now();
        if (now - t0 > 900 && now - lastW > 250) { host.style.overflowY = ''; removeEventListener('wheel', onW, { capture: true }); return; }
        setTimeout(check, 60);
      };
      check();
    }

    // texte : s'il ne tient pas dans son écran (téléphone, fenêtre basse), il descend par paliers jusqu'à tenir
    const fit = () => document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
      const scr = el.closest<HTMLElement>('.scr')!;
      const big = el.classList.contains('idx') ? [...el.querySelectorAll<HTMLElement>('h3')] : [el];
      if (!big.length) return;
      big.forEach((b) => { b.style.fontSize = ''; });
      const min = innerWidth <= 760 ? 13 : 15;
      const over = () => scr.scrollHeight > scr.clientHeight + 2;
      let f = parseFloat(getComputedStyle(big[0]).fontSize);
      while (over() && f > min) { f -= 1; big.forEach((b) => { b.style.fontSize = f + 'px'; }); }
    });
    const fitTitle = () => {
      const h = document.querySelector<HTMLElement>('.case-h1'), v = h?.querySelector<HTMLElement>('.vt');
      if (!h || !v) return;
      h.style.fontSize = '';
      const room = h.clientWidth, w = v.getBoundingClientRect().width;
      if (w > room) h.style.fontSize = parseFloat(getComputedStyle(h).fontSize) * room / w * 0.98 + 'px';
    };
    let ft = 0;
    const refit = () => { fitTitle(); fit(); };
    if (!arriving) refit(); else fit();
    document.fonts.ready.then(fit);
    addEventListener('resize', () => { clearTimeout(ft); ft = window.setTimeout(refit, 150); });

    const open = () => {
      if ((window as any).kkLeavingNext) return;
      (window as any).kkLeavingNext = !reduced();
      try { if (!reduced()) sessionStorage.setItem('kk-next', '1'); } catch { /* */ }
      // sans transition entre pages : tout s'efface autour du titre du projet suivant, qui reste seul à l'écran ; on note sa place
      if (!reduced() && !(window as any).kkXVT) {
        const h = document.querySelector<HTMLElement>('.next-title .vt'), b = h?.getBoundingClientRect();
        try { if (b) sessionStorage.setItem('kk-next-r', JSON.stringify({ x: b.left, y: b.top, w: b.width })); } catch { /* */ }
        const fade = [...document.querySelectorAll<HTMLElement>('.site-header, .more-arrow, .nx .lab, .nx .tt > p, .nx .ring')];
        Promise.all(fade.map((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 280, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' }).finished))
          .then(() => { location.href = ring.href; });
        return;
      }
      location.href = ring.href;
    };
    const stop = () => { if (fill) { fill.onfinish = null; fill.cancel(); fill = null; } };
    const start = () => {
      stop();
      if (reduced()) return; // pas d'ouverture automatique : l'anneau s'ouvre au clic
      fill = arc.animate([{ strokeDashoffset: 339.3 }, { strokeDashoffset: 0 }], { duration: RING, easing: 'linear', fill: 'forwards' });
      if (document.hidden) fill.pause();
      dispatchEvent(new CustomEvent('kk:sound', { detail: 'ring' }));
      fill.onfinish = open;
    };
    host.addEventListener('screens:enter', (e) => { if ((e as CustomEvent).detail.index === last) start(); });
    host.addEventListener('screens:leave', (e) => { if ((e as CustomEvent).detail.from === last) stop(); });
    host.addEventListener('screens:beyond', open);
    ring.addEventListener('click', (e) => { e.preventDefault(); open(); });
    document.addEventListener('visibilitychange', () => { if (!fill) return; document.hidden ? fill.pause() : fill.play(); });
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-next]')) stop(); }, true);
    addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) { (window as any).kkLeavingNext = false; stop(); } });
    if (api.current() === last) start();
    // défilement libre : l'anneau démarre une fois tout en bas de la page (écran « projet suivant » entier), s'arrête si l'on remonte ;
    // la page du projet suivant se précharge à l'approche
    const nxs = document.querySelector<HTMLElement>('.scr.nx');
    if (nxs) {
      ScrollTrigger.create({ trigger: nxs, start: 'bottom bottom+=4', onEnter: start, onLeaveBack: stop });
      ScrollTrigger.create({ trigger: nxs, start: 'top 200%', once: true, onEnter: () => { const l = document.createElement('link'); l.rel = 'prefetch'; l.href = ring.href; document.head.appendChild(l); } });
    }

    // préchargement : les images de l'écran d'après, et la page du projet suivant à l'approche de la fin
    let pre = false;
    host.addEventListener('screens:enter', (e) => {
      const i = (e as CustomEvent).detail.index;
      api.el(i + 1)?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((m) => { m.loading = 'eager'; });
      if (!pre && i >= last - 2) { pre = true; const l = document.createElement('link'); l.rel = 'prefetch'; l.href = ring.href; document.head.appendChild(l); }
    });
    api.el(1)?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((m) => { m.loading = 'eager'; });

    // ---------- défilement libre : textes écrits à leur entrée, visuels découverts au masque, légère parallaxe ----------
    const { still } = initFlow();
    enterOnce(host.querySelectorAll<HTMLElement>(':scope > .scr:not(.s1):not(.nx) :is(.lab, .rk, .lead, .phr, .nts, .idx li, .gen > p)'));
    maskIn(host.querySelectorAll<HTMLElement>(':scope > .scr:not(.s1) :is(.slot, .vis .cd, .gen iframe)'));
    // ---------- entrée des images : elles se découvrent de bas en haut, chacune à son tour ----------
    const play = (scr: HTMLElement, delay: number) => {
      if (reduced()) return;
      scr.querySelectorAll<HTMLElement>('img.md').forEach((m, i) => {
        if (i > 5) return;
        const a = m.animate([{ clipPath: 'inset(100% 0 0 0)' }, { clipPath: 'inset(0 0 0 0)' }], { duration: 900, delay: i * 110, easing: 'cubic-bezier(.7, 0, .2, 1)', fill: 'backwards' });
        a.startTime = (document.timeline.currentTime as number) + delay;
      });
    };
    host.addEventListener('screens:leave', (e) => { const el = api.el((e as CustomEvent).detail.to); if (el) play(el, 160); });

    // ---------- profondeur : pendant le passage d'un écran à l'autre, les images n'avancent pas toutes à la même vitesse ----------
    const deep = [...document.querySelectorAll<HTMLElement>('[data-depth]')].map((el) => ({ el, k: +el.dataset.depth!, scr: el.closest<HTMLElement>('.scr')! }));
    let praf = 0, until = 0;
    const depth = () => {
      for (const d of deep) {
        const top = d.scr.getBoundingClientRect().top;
        d.el.style.translate = Math.abs(top) < innerHeight * 1.2 ? `0 ${(top * d.k).toFixed(1)}px` : '';
      }
      praf = performance.now() < until ? requestAnimationFrame(depth) : 0;
      if (!praf) deep.forEach((d) => { if (Math.abs(d.scr.getBoundingClientRect().top) < 1) d.el.style.translate = ''; });
    };
    if (!reduced() && deep.length) host.addEventListener('screens:leave', () => { until = performance.now() + 1500; if (!praf) praf = requestAnimationFrame(depth); });

    // ---------- légende au survol : elle remplace le libellé de l'écran ----------
    document.querySelectorAll<HTMLImageElement>('img[data-cap]').forEach((im) => {
      const lab = im.closest('.in')?.querySelector<HTMLElement>('[data-caplab]');
      if (!lab) return;
      const base = lab.textContent || '';
      im.addEventListener('pointerenter', () => { const n = im.dataset.n || '', cap = im.dataset.cap || ''; lab.textContent = cap.endsWith(n) ? cap : `${cap} — ${n}`; });
      im.addEventListener('pointerleave', () => { lab.textContent = base; });
    });

    const H = () => host.clientHeight || innerHeight;
    const scrTop = (el: Element) => { const sc = el.closest('.scr')!; return sc.getBoundingClientRect().top + host.scrollTop; };
    const ease = (t: number) => t * t * (3 - 2 * t);

    // ---------- passages d'un écran à l'autre (data-fly="clé") ----------
    // Deux éléments de même clé sur deux écrans voisins : pendant le défilement de l'un à l'autre, une copie glisse de la place
    // du premier à celle du second (position, taille, arrondi). Au repos, les originaux sont là et la copie disparaît.
    type Fr = { x: number; y: number; w: number; h: number; rad: number };
    const pairs: { a: HTMLElement; b: HTMLElement; ta: number; tb: number; A?: Fr; B?: Fr; im: HTMLImageElement }[] = [];
    if (!reduced()) {
      const byKey = new Map<string, HTMLElement[]>();
      document.querySelectorAll<HTMLElement>('[data-fly]').forEach((el) => byKey.set(el.dataset.fly!, [...(byKey.get(el.dataset.fly!) || []), el]));
      byKey.forEach((els) => els.slice(1).forEach((b, i) => {
        const a = els[i];
        const src = (a.querySelector<HTMLImageElement>('img[data-fly-src]') || a.querySelector<HTMLImageElement>('img'))!;
        const im = document.createElement('img'); im.className = 'fly'; im.alt = ''; im.hidden = true;
        im.src = src.dataset.real || src.getAttribute('src') || ''; document.body.appendChild(im);
        new MutationObserver(() => { if (src.dataset.real) im.src = src.dataset.real; }).observe(src, { attributes: true, attributeFilter: ['data-real'] });
        pairs.push({ a, b, ta: 0, tb: 0, im });
      }));
    }
    const rest = (el: HTMLElement): Fr => { const r = el.getBoundingClientRect(), sc = el.closest('.scr')!.getBoundingClientRect(); return { x: r.left, y: r.top - sc.top, w: r.width, h: r.height, rad: parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0 }; };
    const measureFly = () => pairs.forEach((p) => { p.ta = scrTop(p.a); p.tb = scrTop(p.b); p.A = rest(p.a); p.B = rest(p.b); });
    const paintFly = (y: number) => pairs.forEach((p) => {
      const t = (y - p.ta) / (p.tb - p.ta);
      const moving = t > 0.002 && t < 0.998;
      p.a.style.opacity = moving ? '0' : ''; p.b.style.opacity = moving ? '0' : '';
      p.im.hidden = !moving;
      if (!moving || !p.A || !p.B) return;
      const e = ease(t), L = (u: number, v: number) => u + (v - u) * e;
      p.im.style.transform = `translate3d(${L(p.A.x, p.B.x).toFixed(1)}px, ${L(p.A.y, p.B.y).toFixed(1)}px, 0)`;
      p.im.style.width = `${L(p.A.w, p.B.w).toFixed(1)}px`; p.im.style.height = `${L(p.A.h, p.B.h).toFixed(1)}px`;
      p.im.style.borderRadius = `${L(p.A.rad, p.B.rad).toFixed(1)}px`;
    });

    // les pièces propres à un projet (src/components/case/) suivent le même défilement : case:scroll { y, h } et case:measure
    let fr = 0;
    const paintAll = () => { fr = 0; const y = host.scrollTop, h = H(); paintFly(y); host.dispatchEvent(new CustomEvent('case:scroll', { detail: { y, h } })); };
    const kickAll = () => { if (!fr) fr = requestAnimationFrame(paintAll); };
    const remeasure = () => { host.dispatchEvent(new CustomEvent('case:measure')); measureFly(); kickAll(); }; // les pièces se remettent au repos d'abord
    remeasure();
    host.addEventListener('scroll', kickAll, { passive: true });
    addEventListener('resize', () => setTimeout(remeasure, 180));
    document.fonts?.ready.then(remeasure);

    // ---------- zoom ----------
    const lb = document.querySelector<HTMLElement>('[data-lb]')!, lbImg = lb.querySelector('img')!;
    const lbc = lb.querySelector<HTMLElement>('[data-lbc]')!, lbn = lb.querySelector<HTMLElement>('[data-lbn]')!;
    const all = [...document.querySelectorAll<HTMLImageElement>('img[data-cap]')];
    let at = -1;
    const show = (i: number) => {
      at = (i + all.length) % all.length;
      const m = all[at];
      lbImg.src = m.getAttribute('data-real') || m.getAttribute('src') || ''; lbImg.width = m.width; lbImg.height = m.height;
      const cap = m.dataset.cap || '', n = m.dataset.n || '';
      lbc.textContent = cap; lbn.textContent = cap.endsWith(n) ? '' : n;
    };
    const block = (e: Event) => {
      e.stopPropagation();
      if (e.type === 'wheel') { close(); return; }
      if (e.type !== 'keydown') return;
      const k = (e as KeyboardEvent).key;
      if (k === 'Escape') close();
      else if (k === 'ArrowRight' || k === 'ArrowDown') show(at + 1);
      else if (k === 'ArrowLeft' || k === 'ArrowUp') show(at - 1);
      e.preventDefault();
    };
    const EVS = ['wheel', 'keydown', 'touchstart'] as const;
    const openLb = (m: HTMLImageElement) => {
      show(all.indexOf(m));
      lb.hidden = false;
      EVS.forEach((t) => addEventListener(t, block, { capture: true, passive: false }));
      if (reduced()) return;
      const a = m.getBoundingClientRect(), b = lbImg.getBoundingClientRect();
      if (b.width) lbImg.animate([{ transformOrigin: '0 0', transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.width / b.width})`, opacity: 0.6 }, { transformOrigin: '0 0', transform: 'none', opacity: 1 }], { duration: 560, easing: 'cubic-bezier(.7, 0, .2, 1)' });
      lb.animate([{ backgroundColor: 'transparent' }, {}], { duration: 360, easing: 'ease-out' });
      lb.querySelector('.lbc')?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 380, fill: 'backwards' });
    };
    function close() {
      if (lb.hidden) return;
      EVS.forEach((t) => removeEventListener(t, block, { capture: true }));
      if (reduced()) { lb.hidden = true; return; }
      lb.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, easing: 'ease-in' }).finished.then(() => { lb.hidden = true; });
    }
    all.forEach((m) => m.addEventListener('click', () => openLb(m)));
    lb.addEventListener('click', close);
  };
  if (window.kkScreens) run(); else document.addEventListener('kk:screens', run, { once: true });
</script>
