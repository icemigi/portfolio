---
// Étude de cas, mise en page magazine : chaque écran est une double page composée (texte et visuels ensemble,
// contrastes d'échelle), la disposition change d'un écran à l'autre. Titre · accroche · doubles pages · planche contact
// · projet suivant. Un seul libellé entre parenthèses par écran. Le défilement reste celui du site (un geste = un écran).
// Fin : l'anneau se remplit en 3,5 s puis ouvre le projet suivant (le titre glisse et grandit jusqu'au titre de la page suivante).
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../../data/ui';
import { projects } from '../../../data/projects';
import { media, type Img } from '../../../data/media';
import { captions } from '../../../data/captions';
import { rich, first, esc } from '../../../data/text';
import KernOutdoor from '../../../components/case/KernOutdoor.astro';
import ObjectShape from '../../../components/ObjectShape.astro';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const index = projects.findIndex((p) => p.slug === Astro.params.slug);
const project = projects[index];
const c = project[lang];
const next = projects[(index + 1) % projects.length];
const prev = projects[(index - 1 + projects.length) % projects.length];
const nc = next[lang];
const N = pad(projects.length);

type Para = { t?: string; p: string };
// Un écran de texte (au milieu de la grille, ferré à gauche : gros texte puis petit texte), puis un écran de médias en grand,
// en alternance. Les médias gardent toujours leurs proportions (jamais rognés).
type Block =
  | { kind: 'txt'; k: string; big: string; small: string[] }
  | { kind: 'media'; imgs: Img[] }
  | { kind: 'list'; k: string; items: { k: string; v: string }[] }
  | { kind: 'gen'; src: string };
const M = media[project.slug];
// grandes images : une version 800 px (public/work/**/<nom>-800.webp) pour les téléphones
const ss = (im: { src: string; w: number }) => (im.w > 1000 ? `${im.src.replace(/\.webp$/, '-800.webp')} 800w, ${im.src} ${im.w}w` : undefined);
const vid = (src: string) => /\.(mp4|webm)$/i.test(src);
const len = (ps: Para[]) => ps.reduce((n, x) => n + (x.t?.length ?? 0) + x.p.length, 0);

// rubriques : le canevas habituel (7 rubriques) se lit en 4 temps ; deux rubriques courtes partagent un écran
const S = c.sections;
type Group = { k: string; paras: Para[]; list?: boolean };
const groups: Group[] = [];
if (c.text) groups.push({ k: fr ? 'le projet' : 'the project', paras: c.text.map((p) => ({ p })) });
if (S.length === 7) {
  const names = fr ? ['contexte', 'démarche', 'choix clés', 'résultat'] : ['context', 'process', 'key decisions', 'outcome'];
  [[0, 1], [2, 3], [4], [5, 6]].forEach((g, gi) => {
    const ps = g.flatMap((i) => S[i].paras);
    if (g.length === 1 || len(ps) <= 720) groups.push({ k: names[gi], paras: ps });
    else g.forEach((i) => groups.push({ k: S[i].h.toLowerCase(), paras: S[i].paras }));
  });
} else S.forEach((s) => groups.push({ k: s.r ? `${s.r} — ${s.h.toLowerCase()}` : s.h.toLowerCase(), paras: s.paras })); // rubrique fixe (r) + titre propre au projet (h)
groups.forEach((g) => { if (g.paras.length > 1 && g.paras.every((x) => x.t)) g.list = true; });

// gros texte / petit texte : la première phrase (ou l'intertitre) en grand, la suite en note mono
const split = (ps: Para[]) => {
  const [p0, ...more] = ps;
  const [big, rest] = p0.t ? [p0.t.replace(/[\s.:]+$/, '') + '.', p0.p] : first(p0.p);
  return { big: rich(big), small: [...(rest ? [rich(rest, 'note')] : []), ...more.map((x) => (x.t ? `<b>${esc(x.t)}</b> ` : '') + rich(x.p, 'note'))] };
};

// visuels : la couverture d'abord, puis la galerie, répartis également entre les écrans de médias (un après chaque texte, 4 visuels au plus)
const pool: Img[] = M ? [M.cover, ...(M.gal ?? []).flat().filter((im) => im.src !== M.cover.src && !vid(im.src))] : [];
const blocks: Block[] = [{ kind: 'txt', k: fr ? 'en bref' : 'in short', big: rich(c.lead), small: c.note ? [rich(c.note, 'note')] : [] }];
groups.forEach((g, i) => {
  if (g.list) blocks.push({ kind: 'list', k: g.k, items: g.paras.map((x) => ({ k: x.t!.replace(/[\s.:]+$/, ''), v: x.p })) });
  else blocks.push({ kind: 'txt', k: g.k, ...split(g.paras) });
  if (project.generator && i === groups.length - 2) blocks.push({ kind: 'gen', src: project.generator });
});
if (c.blocks?.length) blocks.push({ kind: 'list', k: fr ? 'en bref' : 'in short', items: c.blocks });
let slots = blocks.filter((b) => b.kind === 'txt').length;
for (let i = 0; i < blocks.length && pool.length; i++) {
  if (blocks[i].kind !== 'txt') continue;
  blocks.splice(i + 1, 0, { kind: 'media', imgs: pool.splice(0, Math.min(4, Math.ceil(pool.length / slots--))) });
  i++;
}
while (pool.length) blocks.push({ kind: 'media', imgs: pool.splice(0, 4) });
// projets à architecture propre (src/components/case/) : leur milieu remplace les rubriques (l'accroche reste commune)
const Own = ({ 'kern-outdoor': KernOutdoor } as Record<string, typeof KernOutdoor | undefined>)[project.slug];
const shown: Block[] = Own ? [blocks[0]] : blocks;

// textes alternatifs et légendes : celle de captions.ts, sinon « visuel 03/19 »
const allImgs: Img[] = shown.flatMap((b) => (b.kind === 'media' ? b.imgs : []));
const imgTotal = allImgs.length;
const imgNo = (im: Img) => allImgs.indexOf(im) + 1;
const capOf = (im: Img) => captions[im.src]?.[lang] || `${fr ? 'visuel' : 'visual'} ${pad(imgNo(im))}/${pad(imgTotal)}`;
const pic = (im: Img, cls: string, sizes: string) => ({ cls, src: im.src, srcset: ss(im), sizes, w: im.w, h: im.h, alt: `${c.title} — ${capOf(im)}`, cap: capOf(im), n: `${pad(imgNo(im))}/${pad(imgTotal)}` });
type Pic = ReturnType<typeof pic>;
// données structurées : l'étude comme œuvre, signée par la personne décrite dans Base (#me)
const home = new URL('/', Astro.site ?? 'https://kerningkastle.com').href;
const workLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: c.title, description: c.lead, inLanguage: lang,
  url: new URL(`/${lang}/work/${project.slug}/`, home).href,
  ...(M ? { image: new URL(M.cover.src, home).href } : {}),
  ...(project.years.length ? { dateCreated: String(project.years[0]) } : {}),
  creator: { '@id': `${home}#me` }, isPartOf: { '@id': `${home}#site` },
};
---
<Base lang={lang} title={c.title} description={c.lead.length < 110 ? `${c.lead} ${c.meta.role} · ${c.meta.tools}.` : c.lead} path={`work/${project.slug}/`} active="work">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
  </Fragment>

  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label={fr ? 'Visuel agrandi' : 'Enlarged visual'}>
    <img alt="" decoding="async" />
    <p class="lbc mono"><span data-lbc></span><span class="mu" data-lbn></span></p>
  </div>

  <div class="screens-host case" data-screens>
    <section class="scr s1" aria-labelledby="case-title">
      <div class="head g">
        <p class="lab mono mu par s1-late" data-cl><a class="cr" href={`/${lang}/work/${prev.slug}/`} data-prev aria-label={`${fr ? 'Projet précédent' : 'Previous project'} : ${prev[lang].title}`}>←</a> <span class="vl">{fr ? 'projet' : 'project'} {pad(index + 1)}/{N}</span></p>
        <h1 class="case-h1" id="case-title"><span class="vt">{c.title}</span></h1>
        <div class="cobj" data-cobj data-slug={project.slug} aria-hidden="true"><span class="cfl"><ObjectShape kind={project.object} /></span></div>
        <dl class="fiche mono s1-late">
          <div><dt class="mu">{t.meta.year}</dt><dd>{c.meta.year}</dd></div>
          <div><dt class="mu">{t.meta.context}</dt><dd>{c.meta.context}</dd></div>
          <div><dt class="mu">{t.meta.role}</dt><dd>{c.meta.role}</dd></div>
          <div><dt class="mu">{t.meta.tools}</dt><dd>{c.meta.tools}</dd></div>
        </dl>
      </div>
    </section>

    {shown.map((b, bi) =>
      b.kind === 'txt' ? (
        <section class="scr txs">
          <div class="in g cen">
            <div class="pin">
              <h2 class="lab mono mu par">{b.k}</h2>
              <div class="tx">
                <p class="phr t56" data-hola data-fit set:html={b.big} />
                {b.small.length > 0 && <div class="nts mono mu note">{b.small.map((h) => <p set:html={h} />)}</div>}
              </div>
            </div>
          </div>
        </section>
      ) : b.kind === 'media' ? (
        <section class="scr mds" data-media>
          <div class:list={['in g med', `n${b.imgs.length}`, { flip: bi % 4 === 3 }]}>
            <p class="lab mono mu par" data-caplab>{fr ? 'visuels' : 'visuals'}</p>
            {b.imgs.map((im, i) => ((p: Pic) => (
              <figure class:list={['mi', `m${i}`]} data-par={[70, 150, 110, 190][i]}>
                {/* capture très haute (page web entière) : elle défile dans un cadre d'écran (views/case.ts) */}
                {p.h / p.w > 2.5
                  ? <div class="shot" data-shot><img src={p.src} srcset={p.srcset} sizes={p.sizes} width={p.w} height={p.h} alt={p.alt} data-cap={p.cap} data-n={p.n} loading="lazy" decoding="async" /></div>
                  : <img class="md" src={p.src} srcset={p.srcset} sizes={p.sizes} width={p.w} height={p.h} alt={p.alt} data-cap={p.cap} data-n={p.n} loading="lazy" decoding="async" />}
              </figure>
            ))(pic(im, '', b.imgs.length === 1 ? '(max-width: 760px) 100vw, 70vw' : '(max-width: 760px) 100vw, 40vw')))}
          </div>
        </section>
      ) : b.kind === 'list' ? (
        <section class="scr">
          <div class="in g">
            <h2 class="lab mono mu par">{b.k}</h2>
            <ul class="bd idx" data-hola data-fit>
              {b.items.map((it, i) => (
                <li><span class="mono mu n">{pad(i + 1)}</span><h3 class="t28">{it.k}</h3><p class="mono mu dl">{it.v}</p></li>
              ))}
            </ul>
          </div>
        </section>
      ) : (
        <section class="scr">
          <div class="in g">
            <p class="lab mono mu par">{fr ? 'générateur' : 'generator'}</p>
            <div class="bd gen">
              <p class="mono mu">{fr ? 'entrez une clé, obtenez son blason' : 'enter a key, get its coat of arms'}</p>
              <iframe src={b.src} title={fr ? 'Générateur héraldique' : 'Heraldry generator'} loading="lazy"></iframe>
            </div>
          </div>
        </section>
      ),
    )}

    {Own && M && <Own lang={lang} c={c} M={M} pic={(im: Img, sizes: string) => pic(im, '', sizes)} rich={rich} />}

    <section class="scr nx" aria-labelledby="next-l">
      <div class="in g">
        <p class="lab mono mu par" id="next-l" data-cl><span class="vl">{t.next} {pad(((index + 1) % projects.length) + 1)}/{N}</span></p>
        <div class="bd tt">
          <h2 class="next-title t56"><span class="vt">{nc.title}</span></h2>
          <p class="mono mu">{nc.short} — {next.yearLabel}</p>
        </div>
        <a class="ring" href={`/${lang}/work/${next.slug}/`} data-next aria-label={`${t.next} : ${nc.title}`}>
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="54" class="track0" /><circle cx="60" cy="60" r="54" class="arc" data-arc /></svg>
          <span class="mono" aria-hidden="true">{t.nextShort}</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  /* Voyages (transitions nommées, views/case.ts) : le titre « projet suivant » devient le titre de la page d'arrivée, l'objet
     de la scène Projets se pose sur la page de garde. Même texte, même taille : seul le déplacement est animé. */
  .vt { display: inline-block; white-space: nowrap; }
  ::view-transition-group(case-title), ::view-transition-group(case-object) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-title), ::view-transition-old(case-object) { animation: none; opacity: 0; }
  ::view-transition-new(case-title), ::view-transition-new(case-object) { animation: none; }
  /* page de garde : le numéro et la fiche n'apparaissent qu'une fois le titre posé (en CSS : aucun affichage avant le script) */
  html.js .s1-late { animation: kk-late .45s cubic-bezier(.2,.7,.2,1) 1s both; }
  html.js.case-next .s1-late { animation-delay: 1.15s; }
  html.js .s1-late + .s1-late { animation-delay: 1.12s; }
  html.js.case-next .s1-late + .s1-late { animation-delay: 1.27s; }
  @keyframes kk-late { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { html.js .s1-late { animation: none; } }

  /* ---------- écrans de texte et de médias (partagés avec les études à architecture propre) ---------- */
  /* texte : au milieu de la grille (colonnes 4 à 9), ferré à gauche comme le reste du site ; libellé au-dessus, gros texte
     (première phrase) puis petit texte mono */
  .case .cen { align-content: center; padding-top: calc(var(--head) + 48px); padding-bottom: 96px; }
  .case .pin { grid-column: 4 / 10; display: grid; justify-items: start; row-gap: 28px; }
  .case .pin .lab { position: static; margin: 0; }
  .case .pin .phr { font-size: clamp(30px, 6.2dvh, 56px); }
  .case .pin .nts { margin-top: 24px; font-size: 12px; line-height: 1.55; text-transform: none; max-width: 52ch; }
  .case .pin .nts b { font-weight: 500; }
  .case .pin .nts p + p { margin-top: .6em; }
  /* médias : jamais rognés (largeur et hauteur plafonnées, proportions d'origine), posés sur les colonnes */
  .case .mi { margin: 0; display: flex; justify-content: center; min-width: 0; }
  .case .mi > img { display: block; width: auto; height: auto; max-width: 100%; max-height: var(--mh, 70dvh); }
  .case .shot { position: relative; overflow: hidden; aspect-ratio: 16 / 10; width: min(100%, var(--mh, 70dvh) * 1.6); background: color-mix(in srgb, var(--fg) 6%, var(--bg)); }
  .case .shot > img { display: block; width: 100%; height: auto; will-change: transform; }
  .case .med { height: 100%; grid-template-rows: minmax(0, 1fr); align-items: center; padding-top: calc(var(--head) + 48px); padding-bottom: 96px; }
  .case .med > .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); margin: 0; }

  /* médias en grand ; un seul sur les colonnes 3 à 10, sinon la grille partagée en parts égales, légèrement décalés en hauteur */
  .case .med .mi { grid-row: 1; }
  .case .med.n1 .mi { grid-column: 3 / 11; --mh: 72dvh; }
  .case .med.n2 .m0 { grid-column: 1 / 7; } .case .med.n2 .m1 { grid-column: 7 / -1; } .case .med.n2 { --mh: 62dvh; }
  .case .med.n3 .m0 { grid-column: 1 / 5; } .case .med.n3 .m1 { grid-column: 5 / 9; } .case .med.n3 .m2 { grid-column: 9 / -1; } .case .med.n3 { --mh: 52dvh; }
  .case .med.n4 .m0 { grid-column: 1 / 4; } .case .med.n4 .m1 { grid-column: 4 / 7; } .case .med.n4 .m2 { grid-column: 7 / 10; } .case .med.n4 .m3 { grid-column: 10 / -1; } .case .med.n4 { --mh: 44dvh; }
  .case .med:not(.n1) .m0, .case .med:not(.n1) .m2 { align-self: start; margin-top: 4dvh; }
  .case .med:not(.n1) .m1, .case .med:not(.n1) .m3 { align-self: end; margin-bottom: 4dvh; }

  @media (max-width: 760px) {
    .case .pin { grid-column: 1 / -1; row-gap: 16px; }
    .case .pin .phr { font-size: min(8.6vw, 4.2dvh); }
    .case .pin .nts { margin-top: 12px; font-size: 11px; }
    .case .med { display: flex; flex-direction: column; justify-content: center; gap: 16px; padding-top: calc(var(--head) + 52px); }
    .case .med .mi { margin: 0 !important; align-self: center !important; }
    .case .med.n1 .mi { --mh: 64dvh; } .case .med.n2 { --mh: 34dvh; } .case .med.n3 { --mh: 22dvh; } .case .med.n4 { --mh: 16dvh; }
  }
</style>

<style>
  /* registre des rubriques (14/11) : ligne fixe et statique en bas de l'écran, centrée, sur la ligne de la flèche ; rubrique en
     cours entre parenthèses. Sans fond (16/11) : une bande de flou progressif sur toute la largeur le détache de ce qui passe
     dessous (image du fil), invisible sur le fond uni. */
  :global(.reg) { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: flex; justify-content: center; gap: 10px; padding: 56px var(--m) 43px; color: var(--mu); white-space: nowrap; visibility: hidden; pointer-events: none; }
  :global(.reg)::before { content: ''; position: absolute; inset: 0; z-index: -1; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    mask-image: linear-gradient(to top, #000 45%, transparent); -webkit-mask-image: linear-gradient(to top, #000 45%, transparent); }
  :global(.reg.on) { visibility: visible; }
  :global(.reg a) { position: relative; pointer-events: auto; transition: color .2s; }
  :global(.reg a[aria-current]) { color: var(--ac); }
  /* les parenthèses sont toujours là (invisibles) : la ligne garde la même largeur, rien ne bouge quand la rubrique change */
  :global(.reg a)::before { content: '('; color: transparent; } :global(.reg a)::after { content: ')'; color: transparent; }
  :global(.reg a[aria-current])::before, :global(.reg a[aria-current])::after { color: var(--ac); }
  @media (hover: hover) { :global(.reg a:hover) { color: var(--fg); } }
  @media (max-width: 760px) { :global(.reg) { display: none; } }
  /* lien du libellé (projet précédent), souligné au survol */
  :global(.case .lab .cr) { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color .2s; }
  @media (hover: hover) { :global(.case .lab .cr:hover) { text-decoration-color: currentColor; } }
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .bd { grid-column: 4 / 11; align-self: first baseline; }

  /* page de garde : très grand titre en bas, fiche dessous */
  .s1 .head { height: 100%; align-content: stretch; grid-template-rows: auto 1fr auto auto; row-gap: 24px; padding-top: calc(var(--head) + 24px); padding-bottom: 32px; }
  .s1 .lab { grid-row: 1; }
  .case-h1 { grid-column: 1 / -1; grid-row: 3; font-weight: 500; font-size: min(10.5vw, 17dvh); line-height: .86; letter-spacing: -0.05em; margin-left: -.05em; }
  /* l'objet du projet (le même que sur la page Projets), à droite du titre ; il flotte doucement */
  .cobj { grid-column: 7 / 12; grid-row: 1 / 3; align-self: center; justify-self: center; width: min(26vw, 44dvh); transform-origin: 50% 50%; will-change: transform; pointer-events: none; }
  .cobj .cfl { display: block; animation: kk-float 6.5s ease-in-out infinite; }
  .cobj :global(.shape) { display: block; width: 100%; height: auto; rotate: -4deg; filter: drop-shadow(0 30px 26px rgba(0, 0, 0, .22)); }
  @keyframes kk-float { 0%, 100% { translate: 0 -7px; } 50% { translate: 0 7px; } }
  @media (prefers-reduced-motion: reduce) { .cobj .cfl { animation: none; } }
  .fiche { grid-column: 1 / -1; grid-row: 4; display: grid; grid-template-columns: subgrid; border-top: 1px solid var(--ln); padding-top: 12px; }
  .fiche > div { grid-column: span 3; }
  .fiche dd { margin-top: 4px; }

  .idx { display: grid; grid-template-columns: subgrid; row-gap: 20px; }
  .idx > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 4px; align-items: baseline; }
  .idx .n { font-size: 12px; grid-column: 1; grid-row: 1; }
  .idx h3 { grid-column: 2 / -1; font-weight: 500; }
  .idx .dl { grid-column: 2 / -1; font-size: 12px; text-transform: none; }

  .gen { display: grid; row-gap: 16px; grid-column: 4 / -1; }
  .gen iframe { width: 100%; aspect-ratio: 16 / 9; max-height: calc(100dvh - var(--head) - 180px); border: 1px solid var(--ln); background: #fff; }

  /* zoom */
  .lb { position: fixed; inset: 0; z-index: 70; display: grid; place-items: center; padding: calc(var(--head) + 8px) var(--m) 56px; background: color-mix(in srgb, var(--bg) 96%, transparent); }
  .lb[hidden] { display: none; }
  .lb img { max-width: 100%; max-height: calc(100dvh - var(--head) - 64px); width: auto; height: auto; object-fit: contain; }
  .lbc { position: absolute; left: var(--m); bottom: 20px; right: var(--m); display: flex; justify-content: space-between; font-size: 12px; text-transform: none; }

  /* projet suivant */
  .nx .in { position: relative; align-content: start; }
  .nx .tt > .mono { margin-top: 12px; }
  .ring { position: absolute; right: var(--m); bottom: 40px; width: 160px; height: 160px; display: grid; place-items: center; }
  .ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring circle { fill: none; stroke-width: 1.5; }
  .ring .track0 { stroke: var(--ln); }
  .ring .arc { stroke: var(--fg); stroke-dasharray: 339.3; stroke-dashoffset: 339.3; transform: rotate(-90deg); transform-origin: 60px 60px; }
  .vl { display: inline-block; white-space: nowrap; }

  @media (max-width: 760px) {
    .lab, .bd, .gen { grid-column: 1 / -1; }
    .s1 .head { grid-template-rows: auto 1fr auto auto; row-gap: 16px; padding-top: calc(var(--head) + 20px); padding-bottom: min(32px, 4dvh); }
    .case-h1 { font-size: min(15vw, 12dvh); }
    .cobj { grid-column: 1 / -1; grid-row: 2; width: min(52vw, 30dvh); }
    .fiche { grid-template-columns: 1fr 1fr; gap: 12px var(--gut); border-top: 0; padding-top: 0; }
