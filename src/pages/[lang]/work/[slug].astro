---
// Étude de cas en écrans (03/11) : le même défilement forcé que le reste du site (un geste = un écran, glissement,
// texte qui s'écrit à l'arrivée puis s'écarte au survol, vignettes qui partent du centre pour rejoindre leur place).
// Écrans : ouverture → accroche + fiche → un écran par chapitre, texte et images ensemble (composition qui change
// à chaque écran) → choix clés, avec les visuels du projet qui traversent l'écran → générateur → projet suivant.
// Le geste au-delà du dernier écran ouvre le projet suivant (titre continu).
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../../data/ui';
import { projects } from '../../../data/projects';
import { media, type Img } from '../../../data/media';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const index = projects.findIndex((p) => p.slug === Astro.params.slug);
const project = projects[index];
const c = project[lang];
const next = projects[(index + 1) % projects.length];
const nc = next[lang];
const N = pad(projects.length);
const M = media[project.slug];
const gals = [...(M?.gal ?? [])];
const vid = (src: string) => /\.(mp4|webm)$/i.test(src);
type Ch = { h: string; paras: { t?: string; p: string }[] };
const chapters: Ch[] = [
  ...(c.text ? [{ h: fr ? 'Le projet' : 'The project', paras: c.text.map((p) => ({ p })) }] : []),
  ...(c.blocks?.length ? [{ h: fr ? 'En bref' : 'In short', paras: c.blocks.map((b) => ({ t: b.k, p: b.v })) }] : []),
  ...c.sections,
];
// images réparties régulièrement sur les chapitres (au plus trois par écran)
const flat = gals.flat();
const C = chapters.length, n = flat.length;
const pics = chapters.map((_, i) => flat.slice(Math.round((i * n) / C), Math.round(((i + 1) * n) / C)).slice(0, 3));
// l'écran des choix clés : celui dont les paragraphes ont des titres ; les visuels du projet le traversent
const keyAt = chapters.findIndex((ch) => ch.paras.some((p) => p.t));
const fly = flat.slice(0, 10);
const cap = (i: Img) => i.cap?.[lang];
const im = (i: Img, cls = '') => vid(i.src)
  ? `<video class="${cls}" src="${i.src}" width="${i.w}" height="${i.h}" autoplay muted loop playsinline></video>`
  : `<img class="${cls}" src="${i.src}" width="${i.w}" height="${i.h}" alt="${c.title.replace(/"/g, '')}" loading="lazy" decoding="async" />`;
---
<Base lang={lang} title={c.title} description={c.lead} path={`work/${project.slug}/`} active="work">
  <Fragment slot="head">
    <script is:inline>
      // arrivée par « Projet suivant » : drapeau lu tout de suite, puis effacé
      try { window.kkArriving = sessionStorage.getItem('kk-next') === '1'; sessionStorage.removeItem('kk-next'); } catch (e) { window.kkArriving = false; }
      // titre continu (transition entre documents) : seulement pour l'ouverture du projet suivant
      addEventListener('pageswap', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkLeavingNext) { e.viewTransition.skipTransition(); return; }
        const h = document.querySelector('.next-title .vt'); if (h) h.style.viewTransitionName = 'case-title';
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkArriving) { e.viewTransition.skipTransition(); return; }
        const h = document.querySelector('.case-h1 .vt'); if (h) h.style.viewTransitionName = 'case-title';
      });
    </script>
  </Fragment>
  <div class="screens-host case" data-screens data-next={`/${lang}/work/${next.slug}/`}>
    <!-- ouverture -->
    <section class="scr" aria-labelledby="case-title">
      <div class="in g op">
        <p class="lab mono mu par">{pad(index + 1)} / {N}</p>
        {M && <figure class="cv door"><Fragment set:html={im(M.cover, 'cov')} /></figure>}
        <div class="ttl">
          <h1 class="case-h1" id="case-title"><span class="vt">{c.title}</span></h1>
          <p class="mono mu">{c.short} — {project.yearLabel}</p>
        </div>
      </div>
    </section>

    <!-- accroche et fiche -->
    <section class="scr">
      <div class="in g ld">
        <p class="lab mono mu par">{fr ? 'en bref' : 'in short'}</p>
        <p class="lead t56" data-hola>{c.lead}</p>
        <dl class="fiche mono">
          <div><dt class="mu">{t.meta.year}</dt><dd>{c.meta.year}</dd></div>
          <div><dt class="mu">{t.meta.context}</dt><dd>{c.meta.context}</dd></div>
          <div><dt class="mu">{t.meta.role}</dt><dd>{c.meta.role}</dd></div>
          <div><dt class="mu">{t.meta.tools}</dt><dd>{c.meta.tools}</dd></div>
        </dl>
      </div>
    </section>

    <!-- chapitres : texte et images ensemble, la composition change à chaque écran -->
    {chapters.map((ch, i) => (
      <section class={`scr${i === keyAt ? ' key' : ''}`} data-ch={i}>
        {i === keyAt && fly.length > 0 && (
          <div class="fly" aria-hidden="true">{fly.map((g) => <img src={g.src} width={g.w} height={g.h} alt="" loading="lazy" decoding="async" />)}</div>
        )}
        <div class={`in g chp v${i % 5} n${pics[i].length}`}>
          <p class="lab mono mu par">{pad(i + 1)} — {ch.h.toLowerCase()}</p>
          <div class="tx" data-hola>{ch.paras.map((p) => <p>{p.t && <b>{p.t} </b>}{p.p}</p>)}</div>
          {i !== keyAt && pics[i].map((g, k) => (
            <figure class={`door f${k + 1}`}><Fragment set:html={im(g)} />{cap(g) && <figcaption class="mono mu">→ {cap(g)}</figcaption>}</figure>
          ))}
        </div>
      </section>
    ))}

    {project.generator && (
      <section class="scr">
        <div class="in g gen">
          <p class="lab mono mu par">{fr ? 'générateur — entrez une clé, obtenez son blason' : 'generator — enter a key, get its coat of arms'}</p>
          <iframe src={project.generator} title={fr ? 'Générateur héraldique' : 'Heraldry generator'} loading="lazy"></iframe>
        </div>
      </section>
    )}

    <!-- projet suivant : un geste de plus l'ouvre -->
    <section class="scr" aria-labelledby="next-l">
      <div class="in g nx">
        <p class="lab mono mu par" id="next-l">{t.next.toLowerCase()} {pad(((index + 1) % projects.length) + 1)}/{N}</p>
        <a class="tt" href={`/${lang}/work/${next.slug}/`} data-next>
          <h2 class="next-title"><span class="vt">{nc.title}</span></h2>
          <p class="mono mu">{nc.short} — {next.yearLabel}</p>
          <span class="mono nxs">{t.nextShort} ↓</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  @view-transition { navigation: auto; }
  .vt { display: inline-block; white-space: nowrap; }
  ::view-transition-group(case-title) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-title) { animation: none; opacity: 0; }
  ::view-transition-new(case-title) { animation: none; }
  ::view-transition { background: #f3f3f3; }
  ::view-transition-old(root) { animation: none; opacity: 0; }
  ::view-transition-new(root) { animation: kk-vt-in .9s both; }
  @keyframes kk-vt-in { 0%, 70% { opacity: 0; } 100% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
</style>

<style>
  .case .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); margin: 0; }
  .case .in { position: relative; }
  /* ouverture */
  .op { align-content: center; row-gap: 28px; }
  .op .cv { grid-column: 4 / 13; grid-row: 1; }
  .op .cv :global(.cov) { display: block; width: 100%; height: auto; max-height: 64vh; object-fit: cover; box-shadow: 0 30px 60px rgba(0, 0, 0, .14); }
  .op .ttl { grid-column: 1 / -1; grid-row: 1; align-self: end; z-index: 2; mix-blend-mode: difference; color: #f3f3f3; margin-bottom: -2vh; }
  .op .ttl .mono { color: #f3f3f3; margin-top: 10px; }
  .case-h1 { font-weight: 500; font-size: clamp(64px, 11vw, 190px); line-height: .9; letter-spacing: -0.05em; }
  /* accroche */
  .ld { align-content: center; row-gap: 8vh; }
  .ld .lead { grid-column: 4 / 12; }
  .fiche { grid-column: 4 / 13; display: grid; grid-template-columns: repeat(4, 1fr); column-gap: var(--gut); }
  .fiche dd { margin-top: 4px; }
  /* chapitres : cinq compositions, en alternance */
  .chp { align-content: center; grid-template-rows: auto auto; row-gap: 4vh; }
  .tx { font-size: 22px; line-height: 1.4; letter-spacing: -0.01em; align-self: center; }
  .tx p + p { margin-top: 16px; }
  .tx b { font-weight: 500; }
  .chp figure { margin: 0; align-self: center; }
  .chp :global(img), .chp :global(video) { display: block; width: 100%; height: auto; max-height: 56vh; object-fit: contain; object-position: left center; box-shadow: 0 24px 50px rgba(0, 0, 0, .12); }
  figcaption { margin-top: 10px; }
  .n0 .tx { grid-column: 3 / 11; font-size: 30px; line-height: 1.28; font-weight: 500; letter-spacing: -0.02em; }
  .v0 .tx { grid-column: 4 / 8; grid-row: 1 / 3; } .v0 .f1 { grid-column: 8 / 13; grid-row: 1; } .v0 .f2 { grid-column: 9 / 12; grid-row: 2; } .v0 .f3 { grid-column: 1 / 4; grid-row: 2; }
  .v1 .tx { grid-column: 8 / 12; grid-row: 1 / 3; } .v1 .f1 { grid-column: 1 / 7; grid-row: 1 / 3; } .v1 .f2 { grid-column: 12 / 13; display: none; } .v1.n2 .f1 { grid-column: 1 / 5; grid-row: 1; } .v1.n2 .f2 { display: block; grid-column: 4 / 8; grid-row: 2; } .v1 .f3 { display: none; }
  .v2 .tx { grid-column: 4 / 10; grid-row: 1; } .v2 .f1 { grid-column: 1 / 5; grid-row: 2; } .v2 .f2 { grid-column: 5 / 9; grid-row: 2; margin-top: 8vh; } .v2 .f3 { grid-column: 9 / 13; grid-row: 2; }
  .v3 .f1 { grid-column: 3 / 8; grid-row: 1 / 3; } .v3 .tx { grid-column: 9 / 13; grid-row: 1; } .v3 .f2 { grid-column: 9 / 12; grid-row: 2; } .v3 .f3 { grid-column: 1 / 3; grid-row: 2; }
  .v4 .tx { grid-column: 2 / 7; grid-row: 1 / 3; } .v4 .f1 { grid-column: 7 / 13; grid-row: 1; } .v4 .f2 { grid-column: 8 / 11; grid-row: 2; } .v4 .f3 { grid-column: 11 / 13; grid-row: 2; }
  .n1 .tx, .n0.v1 .tx { grid-row: 1 / 3; }
  .v2.n1 .f1 { grid-column: 4 / 10; }
  .v2.n0 .tx, .v0.n0 .tx, .v1.n0 .tx, .v3.n0 .tx, .v4.n0 .tx { grid-column: 3 / 11; grid-row: 1 / 3; }
  /* choix clés : les visuels du projet traversent l'écran à l'arrivée */
  .key .chp .tx { grid-column: 3 / 11; grid-row: 1 / 3; font-size: 24px; }
  .key .tx b { display: block; font-size: 56px; line-height: 60px; letter-spacing: -0.035em; margin-bottom: 6px; }
  .key .tx p + p { margin-top: 32px; }
  .fly { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .fly img { position: absolute; left: 0; top: 0; width: 24vmin; height: auto; opacity: 0; box-shadow: 0 24px 50px rgba(0, 0, 0, .14); will-change: transform; }
  .key .in { z-index: 1; }
  /* générateur */
  .gen { align-content: center; }
  .gen iframe { grid-column: 2 / 12; width: 100%; aspect-ratio: 16 / 9; max-height: calc(100dvh - var(--head) - 140px); border: 1px solid var(--ln); background: #fff; }
  /* suivant */
  .nx { align-content: center; }
  .nx .tt { grid-column: 4 / 12; display: block; }
  .next-title { font-weight: 500; font-size: clamp(56px, 9vw, 150px); line-height: .95; letter-spacing: -0.05em; }
  .nx .tt .mono { margin-top: 14px; }
  .nxs { display: inline-block; margin-top: 40px; }
  @media (max-width: 760px) {
    .op .cv, .ld .lead, .fiche, .nx .tt, .gen iframe { grid-column: 1 / -1; }
    .fiche { grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    .chp { grid-template-rows: none; row-gap: 20px; align-content: end; }
    .chp .tx, .chp figure, .key .chp .tx { grid-column: 1 / -1 !important; grid-row: auto !important; margin: 0 !important; display: block !important; }
    .chp .f3 { display: none !important; }
    .tx, .n0 .tx { font-size: 18px; }
    .key .tx b { font-size: 9.6vw; line-height: 1.04; }
    .chp :global(img) { max-height: 34vh; }
  }
</style>

<script>
  import { initCase } from '../../../scripts/story';
  initCase(document.querySelector<HTMLElement>('[data-screens].case')!);
</script>
