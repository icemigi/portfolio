---
// Étude de cas : page de garde · accroche (en bref) · milieu propre à chaque étude (src/components/case/<Étude>.astro :
// écrans de texte et de médias sur la grille) · projet suivant. Un seul libellé entre parenthèses par écran. Le défilement
// reste celui du site (un geste = un écran). Fin : l'anneau se remplit en 3,5 s puis ouvre le projet suivant (le titre glisse
// et grandit jusqu'au titre de la page suivante).
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../../data/ui';
import { projects } from '../../../data/projects';
import { media, type Img } from '../../../data/media';
import TextScreen from '../../../components/case/TextScreen.astro';
import { rich } from '../../../data/text';
import KernOutdoor from '../../../components/case/KernOutdoor.astro';
import SportsAventure from '../../../components/case/SportsAventure.astro';
import MusicIdentities from '../../../components/case/MusicIdentities.astro';
import AlgorithmicHeraldry from '../../../components/case/AlgorithmicHeraldry.astro';
import Asaphr from '../../../components/case/Asaphr.astro';
import BmsEsport from '../../../components/case/BmsEsport.astro';
import ChateauStudio from '../../../components/case/ChateauStudio.astro';
import ObjectShape from '../../../components/ObjectShape.astro';
import { aspect } from '../../../data/objects';
import { av, avSet } from '../../../data/avif';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const index = projects.findIndex((p) => p.slug === Astro.params.slug);
const project = projects[index];
const c = project[lang];
const next = projects[(index + 1) % projects.length];
const prev = projects[(index - 1 + projects.length) % projects.length];
const nc = next[lang];
const N = pad(projects.length);

const M = media[project.slug];
// grandes images : une version 800 px (public/work/**/<nom>-800.webp) pour les téléphones ; chaque étude écrit ses textes alternatifs
const ss = (im: { src: string; w: number }) => (im.w > 1000 ? `${im.src.replace(/\.webp$/, '-800.webp')} 800w, ${im.src} ${im.w}w` : undefined);
const pic = (im: Img, sizes: string) => ({ src: av(im.src), srcset: avSet(ss(im)), sizes, w: im.w, h: im.h, alt: c.title });
// milieu de chaque étude (src/components/case/)
const Own = ({ 'kern-outdoor': KernOutdoor, 'sports-aventure': SportsAventure, 'music-identities': MusicIdentities, 'algorithmic-heraldry': AlgorithmicHeraldry, asaphr: Asaphr, 'bms-esport': BmsEsport, 'chateau-studio': ChateauStudio } as Record<string, typeof KernOutdoor | undefined>)[project.slug];
// données structurées : l'étude comme œuvre, signée par la personne décrite dans Base (#me)
const home = new URL('/', Astro.site ?? 'https://kerningkastle.com').href;
const workLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: c.title, description: c.lead, inLanguage: lang,
  url: new URL(`/${lang}/work/${project.slug}/`, home).href,
  ...(M ? { image: new URL(M.cover.src, home).href } : {}),
  ...(project.years.length ? { dateCreated: String(project.years[0]) } : {}),
  creator: { '@id': `${home}#me` }, isPartOf: { '@id': `${home}#site` },
};
---
<Base lang={lang} title={c.title} description={c.lead.length < 110 ? `${c.lead} ${c.meta.role} · ${c.meta.tools}.` : c.lead} path={`work/${project.slug}/`} active="work">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
  </Fragment>

  <div class="screens-host case" data-screens>
    <section class="scr s1" aria-labelledby="case-title">
      <div class="head g">
        <p class="lab mono mu par s1-late" data-cl><a class="cr" href={`/${lang}/work/${prev.slug}/`} data-prev aria-label={`${fr ? 'Projet précédent' : 'Previous project'} : ${prev[lang].title}`}>← <span class="vl">{fr ? 'projet' : 'project'} {pad(index + 1)}/{N}</span></a></p>
        <h1 class="case-h1" id="case-title"><span class="vt">{c.title}</span></h1>
        <div class="cobj" data-cobj data-slug={project.slug} aria-hidden="true" style={`--a:${Math.sqrt(aspect(project.object)).toFixed(3)}`}><span class="cfl"><ObjectShape kind={project.object} /></span></div>
        <dl class="fiche mono s1-late">
          <div><dt class="mu">{t.meta.year}</dt><dd>{c.meta.year}</dd></div>
          <div><dt class="mu">{t.meta.context}</dt><dd>{c.meta.context}</dd></div>
          <div><dt class="mu">{t.meta.role}</dt><dd>{c.meta.role}</dd></div>
          <div><dt class="mu">{t.meta.tools}</dt><dd>{c.meta.tools}</dd></div>
        </dl>
      </div>
    </section>

    <TextScreen k={fr ? 'en bref' : 'in short'} big={rich(c.lead)} note={c.note ? rich(c.note, 'note') : undefined} />

    {Own && <Own lang={lang} c={c} M={M} pic={pic} rich={rich} />}

    <section class="scr nx" data-peek aria-labelledby="next-l">
      <div class="nxb g">
        <p class="lab mono par" id="next-l" data-cl><span class="vl">{t.next} {pad(((index + 1) % projects.length) + 1)}/{N}</span></p>
        <h2 class="next-title"><span class="vt">{nc.title}</span></h2>
        <p class="nfoot mono">{nc.short} — {next.yearLabel}</p>
        <a class="ring" href={`/${lang}/work/${next.slug}/`} data-next aria-label={`${t.next} : ${nc.title}`}>
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="54" class="track0" /><circle cx="60" cy="60" r="54" class="arc" data-arc /></svg>
          <span class="mono" aria-hidden="true">{t.nextShort}</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  /* Voyages (transitions nommées, views/case.ts) : le titre « projet suivant » devient le titre de la page d'arrivée, l'objet
     de la scène Projets se pose sur la page de garde. Même texte, même taille : seul le déplacement est animé. */
  .vt { display: inline-block; white-space: nowrap; }
  ::view-transition-group(case-title), ::view-transition-group(case-object) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-title), ::view-transition-old(case-object) { animation: none; opacity: 0; }
  ::view-transition-new(case-title), ::view-transition-new(case-object) { animation: none; }
  /* ouverture du projet suivant, sans fondu : le bandeau orange descend et sort par le bas, le dernier écran monte et sort par
     le haut ; la page d'arrivée apparaît entre les deux, pendant que le titre voyage (même durée, même courbe) */
  ::view-transition-group(case-band), ::view-transition-group(case-out) { animation: none; }
  ::view-transition-old(case-band) { animation: kk-band-out .9s cubic-bezier(.7, 0, .2, 1) both; }
  ::view-transition-old(case-out) { animation: kk-out-up .9s cubic-bezier(.7, 0, .2, 1) both; }
  @keyframes kk-band-out { to { transform: translateY(100%); } }
  @keyframes kk-out-up { to { transform: translateY(-100%); } }
  /* page de garde : le numéro et la fiche n'apparaissent qu'une fois le titre posé (en CSS : aucun affichage avant le script) */
  html.js .s1-late { animation: kk-late .45s cubic-bezier(.2,.7,.2,1) 1s both; }
  html.js.case-next .s1-late { animation-delay: 1.15s; }
  html.js .s1-late + .s1-late { animation-delay: 1.12s; }
  html.js.case-next .s1-late + .s1-late { animation-delay: 1.27s; }
  @keyframes kk-late { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { html.js .s1-late { animation: none; } }

  /* ---------- écrans de texte et de médias (partagés avec les études à architecture propre) ---------- */
  /* texte : au milieu de la grille (colonnes 4 à 9), ferré à gauche comme le reste du site ; libellé au-dessus, gros texte
     (première phrase) puis petit texte mono */
  .case .cen { align-content: center; padding-top: calc(var(--head) + 48px); padding-bottom: 96px; }
  .case .pin { grid-column: 4 / 10; display: grid; justify-items: start; row-gap: 28px; }
  .case .pin .lab { position: static; margin: 0; }
  .case .pin .phr { font-size: clamp(30px, 6.2dvh, 56px); }
  .case .pin .nts { margin-top: 24px; font-size: 12px; line-height: 1.55; text-transform: none; max-width: 52ch; }
  .case .pin .nts b { font-weight: 500; }
  .case .pin .nts p + p { margin-top: .6em; }
  /* médias : jamais rognés (proportions d'origine), posés sur les colonnes */
  .case .mi { margin: 0; display: flex; justify-content: center; min-width: 0; }
  .case .shot { position: relative; overflow: hidden; aspect-ratio: 16 / 10; width: min(100%, var(--mh, 70dvh) * 1.6); background: color-mix(in srgb, var(--fg) 6%, var(--bg)); }
  .case .shot > img { display: block; width: 100%; height: auto; will-change: transform; }
  .case .med { height: 100%; grid-template-rows: minmax(0, 1fr); align-items: center; padding-top: calc(var(--head) + 48px); padding-bottom: 96px; }
  .case .med > .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); margin: 0; }

  /* grille stricte des études à mise en page propre (.sqg, 17/11) : chaque visuel garde ses proportions et couvre un nombre
     entier de colonnes (ses bords sur les lignes de la grille), dans les colonnes 2 à 11 au plus ; entre deux visuels, toujours la
     gouttière. cN : N visuels ; c4 : 2 × 2 ; big / big-r : un grand sur 2k colonnes et deux petits sur k colonnes empilés.
     Écran large (16/9) : spans modérés ; écran plus haut (16/10 et au-delà) : visuels plus grands. Un visuel haut peut recevoir
     sa propre place (style --s, --t sur écran haut, --r pour la rangée) pour ne jamais dépasser de l'écran. */
  .case .med.sqg { grid-template-rows: none; grid-auto-rows: auto; align-content: center; row-gap: var(--gut); }
  .case .med.sqg .mi { grid-row: auto; align-self: start; margin: 0; display: block; }
  .case .mf { display: block; width: 100%; }
  .case .mf > img { display: block; width: 100%; height: auto; }
  .case .mf.ph { aspect-ratio: 1; }
  .case .mf.shot { aspect-ratio: 16 / 10; overflow: hidden; background: color-mix(in srgb, var(--fg) 6%, var(--bg)); }
  .case .sqg.c1 .m0 { grid-column: 5 / 9; }
  .case .sqg.c2 .m0 { grid-column: 3 / 7; } .case .sqg.c2 .m1 { grid-column: 7 / 11; }
  .case .sqg.c3 .m0 { grid-column: 2 / 5; } .case .sqg.c3 .m1 { grid-column: 5 / 8; } .case .sqg.c3 .m2 { grid-column: 8 / 11; }
  .case .sqg.c4 .m0 { grid-column: 5 / 7; grid-row: 1; } .case .sqg.c4 .m1 { grid-column: 7 / 9; grid-row: 1; }
  .case .sqg.c4 .m2 { grid-column: 5 / 7; grid-row: 2; } .case .sqg.c4 .m3 { grid-column: 7 / 9; grid-row: 2; }
  .case .sqg.big .m0 { grid-column: 3 / 7; grid-row: 1 / 3; } .case .sqg.big .m1 { grid-column: 7 / 9; grid-row: 1; } .case .sqg.big .m2 { grid-column: 7 / 9; grid-row: 2; }
  .case .sqg.big-r .m0 { grid-column: 7 / 11; grid-row: 1 / 3; } .case .sqg.big-r .m1 { grid-column: 5 / 7; grid-row: 1; } .case .sqg.big-r .m2 { grid-column: 5 / 7; grid-row: 2; }
  .case .sqg .mi[style] { grid-column: var(--s); grid-row: var(--r, auto); }
  @media (min-width: 761px) and (max-aspect-ratio: 8 / 5) {
    .case .sqg.c1 .m0 { grid-column: 4 / 10; }
    .case .sqg.c2 .m0 { grid-column: 2 / 7; } .case .sqg.c2 .m1 { grid-column: 7 / 12; }
    .case .sqg.c4 .m0 { grid-column: 4 / 7; } .case .sqg.c4 .m1 { grid-column: 7 / 10; } .case .sqg.c4 .m2 { grid-column: 4 / 7; } .case .sqg.c4 .m3 { grid-column: 7 / 10; }
    .case .sqg.big .m0 { grid-column: 2 / 8; } .case .sqg.big .m1, .case .sqg.big .m2 { grid-column: 8 / 11; }
    .case .sqg.big-r .m0 { grid-column: 6 / 12; } .case .sqg.big-r .m1, .case .sqg.big-r .m2 { grid-column: 3 / 6; }
    .case .sqg .mi[style] { grid-column: var(--t, var(--s)); }
  }

  @media (max-width: 760px) {
    .case .pin { grid-column: 1 / -1; row-gap: 16px; }
    .case .pin .phr { font-size: min(8.6vw, 4.2dvh); }
    .case .pin .nts { margin-top: 12px; font-size: 11px; }
    .case .med { display: flex; flex-direction: column; justify-content: center; gap: 16px; padding-top: calc(var(--head) + 52px); }
    .case .med .mi { margin: 0 !important; align-self: center !important; }
    .case .med.sqg { flex-direction: row; flex-wrap: wrap; align-content: center; justify-content: center; gap: var(--gut); }
    .case .med.sqg .mi { width: calc((100% - var(--gut)) / 2); }
    .case .med.sqg.c1 .mi, .case .med.sqg.big .m0, .case .med.sqg.big-r .m0 { width: min(100%, 52dvh); }
  }
</style>

<style>
  /* registre des rubriques (14/11) : ligne fixe et statique en bas de l'écran, centrée, sur la ligne de la flèche ; rubrique en
     cours entre parenthèses. Sans fond (16/11) : une bande de flou progressif sur toute la largeur le détache de ce qui passe
     dessous (image du fil), invisible sur le fond uni. */
  :global(.reg) { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: flex; justify-content: center; gap: 10px; padding: 56px var(--m) 43px; color: var(--mu); white-space: nowrap; visibility: hidden; pointer-events: none; }
  :global(.reg)::before { content: ''; position: absolute; inset: 0; z-index: -1; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    mask-image: linear-gradient(to top, #000 45%, transparent); -webkit-mask-image: linear-gradient(to top, #000 45%, transparent); }
  :global(.reg.on) { visibility: visible; }
  :global(.reg a) { position: relative; pointer-events: auto; transition: color .2s; }
  :global(.reg a[aria-current]) { color: var(--ac); }
  /* les parenthèses sont toujours là (invisibles) : la ligne garde la même largeur, rien ne bouge quand la rubrique change */
  :global(.reg a)::before { content: '('; color: transparent; } :global(.reg a)::after { content: ')'; color: transparent; }
  :global(.reg a[aria-current])::before, :global(.reg a[aria-current])::after { color: var(--ac); }
  @media (hover: hover) { :global(.reg a:hover) { color: var(--fg); } }
  @media (max-width: 760px) { :global(.reg) { display: none; } }
  /* lien du libellé (projet précédent) : tout le libellé, parenthèses comprises (la zone déborde d'un signe de chaque côté et de
     8 px en hauteur, sans rien déplacer ; au-dessus de la parenthèse fermante, dessinée après lui), souligné au survol */
  :global(.case .lab .cr) { position: relative; z-index: 1; display: inline-block; padding: 8px 1ch; margin: -8px -1ch; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color .2s; }
  @media (hover: hover) { :global(.case .lab .cr:hover) { text-decoration-color: currentColor; } }
  .lab { grid-column: 1 / 4; align-self: first baseline; }

  /* page de garde : très grand titre en bas, fiche dessous */
  .s1 .head { height: 100%; align-content: stretch; grid-template-rows: auto 1fr auto auto; row-gap: 24px; padding-top: calc(var(--head) + 24px); padding-bottom: 32px; }
  .s1 .lab { grid-row: 1; }
  .case-h1 { grid-column: 1 / -1; grid-row: 3; font-weight: 500; font-size: min(10.5vw, 17dvh); line-height: .86; letter-spacing: -0.05em; margin-left: -.05em; }
  /* l'objet du projet (le même que sur la page Projets), centré dans la moitié droite, au-dessus du titre ; il flotte
     doucement. Même surface pour tous (comme sur la scène) : la largeur suit ses proportions (--a : racine de largeur / hauteur) */
  .cobj { grid-column: 7 / 13; grid-row: 1 / 3; align-self: center; justify-self: center; width: calc(min(32vw, 42dvh) * var(--a, 1)); transform-origin: 50% 50%; will-change: transform; pointer-events: none; }
  .cobj .cfl { display: block; animation: kk-float 6.5s ease-in-out infinite; }
  .cobj :global(.shape) { display: block; width: 100%; height: auto; rotate: -4deg; filter: drop-shadow(0 30px 26px rgba(0, 0, 0, .22)); }
  @keyframes kk-float { 0%, 100% { translate: 0 -7px; } 50% { translate: 0 7px; } }
  @media (prefers-reduced-motion: reduce) { .cobj .cfl { animation: none; } }
  .fiche { grid-column: 1 / -1; grid-row: 4; display: grid; grid-template-columns: subgrid; border-top: 1px solid var(--ln); padding-top: 12px; }
  .fiche > div { grid-column: span 3; }
  .fiche dd { margin-top: 4px; }

  /* projet suivant : un bandeau orange en bas de l'écran (il dépasse sous le dernier écran, comme le pied de page), titre et
     anneau en blanc ; l'anneau se remplit puis ouvre le projet suivant */
  .nx { background: var(--ac); color: #fff; }
  .nxb { min-height: 34dvh; grid-template-rows: auto 1fr auto; row-gap: 8px; padding-top: 24px; padding-bottom: 28px; }
  .nx .lab { grid-row: 1; grid-column: 1 / -1; color: inherit; opacity: .85; }
  .next-title { grid-row: 2; grid-column: 1 / 10; align-self: end; font-weight: 500; font-size: min(7vw, 12dvh); line-height: .9; letter-spacing: -0.04em; }
  .nfoot { grid-row: 3; grid-column: 1 / 10; opacity: .85; }
  .ring { grid-row: 1 / -1; grid-column: 10 / -1; align-self: center; justify-self: end; position: relative; width: 140px; height: 140px; display: grid; place-items: center; color: #fff; }
  .ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring circle { fill: none; stroke-width: 1.5; }
  .ring .track0 { stroke: rgb(255 255 255 / .4); }
  .ring .arc { stroke: currentColor; stroke-dasharray: 339.3; stroke-dashoffset: 339.3; transform: rotate(-90deg); transform-origin: 60px 60px; }
  .vl { display: inline-block; white-space: nowrap; }

  @media (max-width: 760px) {
    .lab { grid-column: 1 / -1; }
    .s1 .head { grid-template-rows: auto 1fr auto auto; row-gap: 16px; padding-top: calc(var(--head) + 20px); padding-bottom: min(32px, 4dvh); }
    .case-h1 { font-size: min(15vw, 12dvh); }
    .next-title { font-size: min(11vw, 8dvh); grid-column: 1 / -1; }
    .nfoot { grid-column: 1 / -1; }
    .cobj { grid-column: 1 / -1; grid-row: 2; width: calc(min(52vw, 30dvh) * var(--a, 1)); }
    .fiche { grid-template-columns: 1fr 1fr; gap: 12px var(--gut); border-top: 0; padding-top: 0; }
    .fiche > div { grid-column: auto; }
    .nxb { min-height: 30dvh; }
    .ring { grid-row: 1; grid-column: 1 / -1; align-self: start; width: 72px; height: 72px; }
  }
</style>
