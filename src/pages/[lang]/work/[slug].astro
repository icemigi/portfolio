---
// Étude de cas en « one scroll » : la page défile librement et chaque bloc s'anime selon sa position dans l'écran.
// Ouverture (titre devant l'image) → phrase qui s'allume mot à mot → fiche → scènes : le texte de chaque chapitre,
// centré et épinglé, s'allume mot à mot comme l'accroche, pendant que ses images passent en parallaxe sur les bords,
// devant et derrière lui, chacune avec sa fiche « → » → mot qui se resserre au milieu.
// Moteur : scripts/story.ts.
// Fin : continuer à faire défiler remplit l'anneau, puis ouvre le projet suivant (titre continu).
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../../data/ui';
import { projects } from '../../../data/projects';
import { media, type Img } from '../../../data/media';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const index = projects.findIndex((p) => p.slug === Astro.params.slug);
const project = projects[index];
const c = project[lang];
const next = projects[(index + 1) % projects.length];
const nc = next[lang];
const N = pad(projects.length);
const M = media[project.slug];
const gals = [...(M?.gal ?? [])];
const vid = (src: string) => /\.(mp4|webm)$/i.test(src);
type Ch = { h: string; paras: { t?: string; p: string }[] };
const chapters: Ch[] = [
  ...(c.text ? [{ h: fr ? 'Le projet' : 'The project', paras: c.text.map((p) => ({ p })) }] : []),
  ...(c.blocks?.length ? [{ h: fr ? 'En bref' : 'In short', paras: c.blocks.map((b) => ({ t: b.k, p: b.v })) }] : []),
  ...c.sections,
];
// toutes les images vont dans les scènes : elles passent en parallaxe devant et derrière le texte, sur les bords
const flat = gals.flat();
const C = chapters.length, n = flat.length; // répartition régulière : 8 images sur 7 chapitres → 1,1,1,1,1,1,2
const scenes = chapters.map((ch, i) => ({ ...ch, imgs: flat.slice(Math.round((i * n) / C), Math.round(((i + 1) * n) / C)) }));
// placement des images d'une scène : bords gauche / droit en alternance, une sur deux devant le texte (plus rapide),
// l'autre derrière (plus lente) ; jamais en pleine largeur
const place = (i: number, k: number, m: number, g: Img) => {
  const left = (i + k) % 2 === 0;
  const front = k % 2 === 1;
  const w = (g.h > g.w * 1.15 ? 22 : 32) * (front ? 0.85 : 1);
  const x = left ? 3 + ((i * 7 + k * 5) % 6) : 100 - w - 3 - ((i * 5 + k * 7) % 6);
  const y = 14 + ((k + 0.5) / m) * 62;
  return { style: `--x:${x}vw;--y:${y.toFixed(1)}%;--w:${w}vw`, front, side: left ? -1 : 1, speed: front ? -0.45 : 0.25 };
};
// chaque scène fait entrer ses images autrement (jamais deux fois la même à la suite, et décalé d'un projet à l'autre) :
// parallaxe simple, glissement depuis le bord, dévoilement par le bas, croissance, croisement
const VARIANTS = ['par', 'slide', 'mask', 'grow', 'cross'] as const;
const variant = (i: number) => VARIANTS[(i + index) % VARIANTS.length];
// longueur d'une scène : assez pour allumer tous les mots, et pour laisser passer ses images
const run = (sc: { paras: { t?: string; p: string }[]; imgs: Img[] }) => {
  const nw = sc.paras.reduce((a, p) => a + ((p.t ?? '') + ' ' + p.p).split(/\s+/).length, 0);
  return Math.round(Math.max(110, Math.min(240, nw * 1.3), sc.imgs.length * 70));
};
const wordsOf = (str: string) => str.split(' ').filter(Boolean);
const mid = Math.floor(scenes.length / 2);
// le mot qui se resserre au centre : le premier « choix clé », sinon le sous-titre du projet
const key = c.sections.flatMap((s) => s.paras).find((x) => x.t)?.t?.replace(/[.:]$/, '') || c.short;
const words = c.lead.split(' ');
const cap = (i: Img) => i.cap?.[lang];
const im = (i: Img, cls = '') => vid(i.src)
  ? `<video class="${cls}" src="${i.src}" width="${i.w}" height="${i.h}" autoplay muted loop playsinline></video>`
  : `<img class="${cls}" src="${i.src}" width="${i.w}" height="${i.h}" alt="${c.title.replace(/"/g, '')}" loading="lazy" decoding="async" />`;
---
<Base lang={lang} title={c.title} description={c.lead} path={`work/${project.slug}/`} active="work">
  <Fragment slot="head">
    <script is:inline>
      // arrivée par « Projet suivant » : drapeau lu tout de suite, puis effacé
      try { window.kkArriving = sessionStorage.getItem('kk-next') === '1'; sessionStorage.removeItem('kk-next'); } catch (e) { window.kkArriving = false; }
      // titre continu (transition entre documents) : seulement pour l'ouverture du projet suivant
      addEventListener('pageswap', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkLeavingNext) { e.viewTransition.skipTransition(); return; }
        const h = document.querySelector('.next-title .vt'); if (h) h.style.viewTransitionName = 'case-title';
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkArriving) { e.viewTransition.skipTransition(); return; }
        const h = document.querySelector('.case-h1 .vt'); if (h) h.style.viewTransitionName = 'case-title';
      });
    </script>
  </Fragment>
  <main class="story" data-story>
    <!-- 1. ouverture : le titre passe devant l'image, qui monte plus lentement que lui -->
    <section class="hero">
      {M && <div class="hero-img" data-fx="par" data-speed="-0.35"><Fragment set:html={im(M.cover, 'cov')} /></div>}
      <div class="hero-txt g" data-fx="par" data-speed="0.25">
        <p class="no mono mu par">{pad(index + 1)} / {N}</p>
        <h1 class="case-h1" id="case-title"><span class="vt">{c.title}</span></h1>
        <p class="mono mu sub">{c.short} — {project.yearLabel}</p>
      </div>
    </section>

    <!-- 2. la phrase s'allume mot à mot pendant qu'on fait défiler (écran épinglé) -->
    <section class="pin lead-pin" data-pin="words">
      <div class="stick g"><p class="lead">{words.map((w) => <span class="w">{w} </span>)}</p></div>
    </section>

    <!-- 3. fiche -->
    <section class="fiche-s g" data-fx="rise-soft">
      <dl class="fiche mono">
        <div><dt class="mu">{t.meta.year}</dt><dd>{c.meta.year}</dd></div>
        <div><dt class="mu">{t.meta.context}</dt><dd>{c.meta.context}</dd></div>
        <div><dt class="mu">{t.meta.role}</dt><dd>{c.meta.role}</dd></div>
        <div><dt class="mu">{t.meta.tools}</dt><dd>{c.meta.tools}</dd></div>
      </dl>
    </section>

    {scenes.map((sc, i) => {
      return (
        <Fragment>
          <section class="pin scene" data-pin="words" style={`height:calc(100vh + ${run(sc)}vh)`}>
            <div class="stick g">
              <div class="txt">
                <p class="k mono par">({pad(i + 1)} — {sc.h.toLowerCase()})</p>
                <div class="v">{sc.paras.map((p) => <p>{p.t && <b>{wordsOf(p.t).map((w) => <span class="w">{w} </span>)}</b>}{wordsOf(p.p).map((w) => <span class="w">{w} </span>)}</p>)}</div>
              </div>
            </div>
            {sc.imgs.map((g, k) => {
              const pl = place(i, k, sc.imgs.length, g);
              return (
                <figure class={`fl ${pl.front ? 'front' : 'back'}`} style={pl.style} data-fx="fl" data-v={variant(i)} data-side={pl.side} data-k={k} data-speed={pl.speed}>
                  <Fragment set:html={im(g)} />
                  {cap(g) && <figcaption class="mono">→ {cap(g)}</figcaption>}
                </figure>
              );
            })}
          </section>
          {i === mid && (
            <section class="pin close-pin" data-pin="close"><div class="stick"><p class="close">{key}</p></div></section>
          )}
          {project.generator && i === scenes.length - 2 && (
            <section class="gen g" data-fx="rise-soft">
              <p class="k mono par">({fr ? 'générateur — entrez une clé, obtenez son blason' : 'generator — enter a key, get its coat of arms'})</p>
              <iframe src={project.generator} title={fr ? 'Générateur héraldique' : 'Heraldry generator'} loading="lazy"></iframe>
            </section>
          )}
        </Fragment>
      );
    })}

    <!-- fin : continuer à faire défiler remplit l'anneau et ouvre le projet suivant -->
    <section class="nx g" aria-labelledby="next-l">
      <p class="k mono par" id="next-l">({t.next.toLowerCase()} {pad(((index + 1) % projects.length) + 1)}/{N})</p>
      <div class="tt"><h2 class="next-title"><span class="vt">{nc.title}</span></h2><p class="mono mu">{nc.short} — {next.yearLabel}</p></div>
      <a class="ring" href={`/${lang}/work/${next.slug}/`} data-next aria-label={`${t.next} : ${nc.title}`}>
        <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="54" class="track" /><circle cx="60" cy="60" r="54" class="arc" data-arc /></svg>
        <span class="mono" aria-hidden="true">{t.nextShort}</span>
      </a>
    </section>
  </main>
</Base>

<style is:global>
  @view-transition { navigation: auto; }
  /* Titre continu : le titre du projet suivant glisse jusqu'à sa place de titre, sans fondu ni déformation
     (même texte, même taille, une seule ligne : seul le déplacement est animé). L'ancienne page disparaît net,
     la nouvelle arrive une fois le titre posé. */
  .vt { display: inline-block; white-space: nowrap; }
  ::view-transition-group(case-title) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-title) { animation: none; opacity: 0; }
  ::view-transition-new(case-title) { animation: none; }
  ::view-transition { background: #f3f3f3; }
  ::view-transition-old(root) { animation: none; opacity: 0; }
  ::view-transition-new(root) { animation: kk-vt-in .9s both; }
  @keyframes kk-vt-in { 0%, 70% { opacity: 0; } 100% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
</style>

<style>
  .story { position: relative; }
  /* 1. ouverture */
  .hero { position: relative; height: 125vh; }
  .hero-img { position: absolute; left: 50%; top: 18vh; width: min(62vw, 980px); translate: -50% 0; z-index: 1; }
  .hero-img :global(.cov) { display: block; width: 100%; height: auto; max-height: 78vh; object-fit: cover; box-shadow: 0 30px 60px rgba(0, 0, 0, .14); }
  .hero-txt { position: absolute; left: 0; right: 0; top: 58vh; z-index: 2; row-gap: 10px; mix-blend-mode: difference; color: #f3f3f3; }
  .hero-txt .no, .hero-txt .sub { grid-column: 1 / -1; color: #f3f3f3; }
  .case-h1 { grid-column: 1 / -1; font-weight: 500; font-size: clamp(64px, 13vw, 220px); line-height: .9; letter-spacing: -0.05em; }
  .vt { display: inline-block; white-space: nowrap; }
  /* 2. phrase épinglée */
  .pin { position: relative; }
  .lead-pin { height: 160vh; }
  .stick { position: sticky; top: 0; height: 100vh; display: grid; align-content: center; }
  .lead { grid-column: 2 / 12; font-weight: 500; font-size: clamp(30px, 4.2vw, 64px); line-height: 1.08; letter-spacing: -0.03em; }
  .lead .w { opacity: .12; transition: opacity .25s; }
  .lead .w.on { opacity: 1; }
  /* 3. fiche */
  .fiche-s { padding-block: 4vh 6vh; }
  .fiche { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); column-gap: var(--gut); }
  .fiche dd { margin-top: 4px; }
  /* scènes : le texte, centré et épinglé, s'allume mot à mot ; les images passent en parallaxe
     devant (plus vite) et derrière (plus lentement), sur les bords, jamais en pleine largeur */
  .scene { overflow-x: clip; }
  .scene .stick { z-index: 2; pointer-events: none; mix-blend-mode: difference; color: #f3f3f3; }
  .scene .stick .par { color: inherit; }
  .txt { grid-column: 3 / 11; }
  .txt .k { margin-bottom: 22px; }
  .txt .v { font-weight: 500; font-size: clamp(20px, 1.85vw, 30px); line-height: 1.22; letter-spacing: -0.02em; }
  .txt .v p + p { margin-top: .7em; }
  .txt .v b { font-weight: 500; }
  .txt .v b .w.on { color: var(--mu); }
  .v .w { opacity: .12; transition: opacity .25s; }
  .v .w.on { opacity: 1; }
  .fl { position: absolute; left: var(--x); top: var(--y); width: var(--w); z-index: 1; will-change: transform; }
  .fl.front { z-index: 3; }
  .fl :global(img), .fl :global(video) { display: block; width: 100%; height: auto; box-shadow: 0 24px 50px rgba(0, 0, 0, .14); }
  .fl.back :global(img), .fl.back :global(video) { box-shadow: 0 12px 30px rgba(0, 0, 0, .08); }
  figcaption { margin-top: 10px; color: var(--mu); }
  /* le mot qui se resserre au centre, puis s'efface */
  .close-pin { height: 190vh; }
  .close-pin .stick { place-items: center; text-align: center; overflow: hidden; }
  .close { font-weight: 500; font-size: clamp(48px, 9vw, 150px); line-height: 1; letter-spacing: -0.04em; white-space: nowrap; will-change: transform, letter-spacing, opacity; }
  /* générateur */
  .gen { row-gap: 16px; padding-block: 12vh; }
  .gen .k { grid-column: 2 / 12; }
  .gen iframe { grid-column: 2 / 12; width: 100%; aspect-ratio: 16 / 9; max-height: calc(100dvh - var(--head) - 120px); border: 1px solid var(--ln); background: #fff; }
  /* fin */
  .nx { min-height: 100vh; align-items: center; row-gap: 32px; padding-block: 20vh 30vh; }
  .nx .k { grid-column: 1 / 4; align-self: start; padding-top: 22px; }
  .nx .tt { grid-column: 4 / 10; }
  .next-title { font-weight: 500; font-size: 56px; line-height: 60px; letter-spacing: -0.035em; }
  .nx .tt .mono { margin-top: 12px; }
  .ring { grid-column: 10 / 13; justify-self: end; position: relative; width: 160px; height: 160px; display: grid; place-items: center; }
  .ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring circle { fill: none; stroke-width: 1.5; }
  .ring .track { stroke: var(--ln); }
  .ring .arc { stroke: var(--fg); stroke-dasharray: 339.3; stroke-dashoffset: 339.3; transform: rotate(-90deg); transform-origin: 60px 60px; }
  @media (max-width: 760px) {
    .hero { height: 120vh; } .hero-img { width: 86vw; top: 16vh; } .hero-txt { top: 52vh; }
    .lead { grid-column: 1 / -1; } .lead-pin { height: 180vh; }
    .fiche { grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    .txt { grid-column: 1 / -1; } .txt .v { font-size: 17px; }
    .fl { --w: 34vw !important; } .fl.front { --w: 28vw !important; }
    .gen .k, .gen iframe { grid-column: 1 / -1; }
    .close-pin { height: 200vh; }
    .nx .k, .nx .tt { grid-column: 1 / -1; } .next-title { font-size: 9.6vw; line-height: 1.04; }
    .ring { grid-column: 1 / -1; justify-self: start; width: 120px; height: 120px; }
  }
</style>

<script>
  import { initStory } from '../../../scripts/story';
  initStory(document.querySelector<HTMLElement>('[data-story]')!);
</script>
