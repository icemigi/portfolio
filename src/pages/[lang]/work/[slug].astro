---
// Étude de cas, en écrans : titre · accroche en grand · rubriques (regroupées deux à deux quand elles sont courtes)
// · bandes de visuels qui défilent à l'horizontale · projet suivant. Chaque écran porte un seul libellé entre parenthèses,
// comme (services) sur « à propos ». Fin : l'anneau se remplit en 3,5 s puis ouvre le projet suivant (le titre glisse
// et grandit jusqu'à devenir le titre de la page suivante).
import Base from '../../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../../data/ui';
import { projects } from '../../../data/projects';
import { media, type Img } from '../../../data/media';
import { captions } from '../../../data/captions';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const index = projects.findIndex((p) => p.slug === Astro.params.slug);
const project = projects[index];
const c = project[lang];
const next = projects[(index + 1) % projects.length];
const nc = next[lang];
const N = pad(projects.length);

type Para = { t?: string; p: string };
type Block =
  | { kind: 'hook'; k: string; p: string }
  | { kind: 'rub'; k: string; paras: Para[] }
  | { kind: 'split'; k: string; paras: Para[]; img: Img }
  | { kind: 'list'; k: string; items: { k: string; v: string }[] }
  | { kind: 'band'; imgs: Img[] }
  | { kind: 'ph' }
  | { kind: 'gen'; src: string };
const M = media[project.slug];
// grandes images : une version 800 px (public/work/**/<nom>-800.webp) pour les téléphones
const ss = (im: { src: string; w: number }) => (im.w > 1000 ? `${im.src.replace(/\.webp$/, '-800.webp')} 800w, ${im.src} ${im.w}w` : undefined);
const vid = (src: string) => /\.(mp4|webm)$/i.test(src); // boucle vidéo = « GIF » léger
const len = (ps: Para[]) => ps.reduce((n, x) => n + (x.t?.length ?? 0) + x.p.length, 0);

// rubriques : le canevas habituel (7 rubriques) se lit en 4 temps ; deux rubriques courtes partagent un écran
const S = c.sections;
type Group = { k: string; paras: Para[]; list?: boolean };
const groups: Group[] = [];
if (c.text) groups.push({ k: fr ? 'le projet' : 'the project', paras: c.text.map((p) => ({ p })) });
if (S.length === 7) {
  const names = fr ? ['contexte', 'démarche', 'choix clés', 'résultat'] : ['context', 'process', 'key decisions', 'outcome'];
  [[0, 1], [2, 3], [4], [5, 6]].forEach((g, gi) => {
    const ps = g.flatMap((i) => S[i].paras);
    if (g.length === 1 || len(ps) <= 720) groups.push({ k: names[gi], paras: ps });
    else g.forEach((i) => groups.push({ k: S[i].h.toLowerCase(), paras: S[i].paras }));
  });
} else S.forEach((s) => groups.push({ k: s.h.toLowerCase(), paras: s.paras }));
groups.forEach((g) => { if (g.paras.length > 1 && g.paras.every((x) => x.t)) g.list = true; });

// visuels : une image accompagne la dernière rubrique (texte à gauche, image à droite) ; le reste part en une ou deux bandes
const pool: Img[] = M ? [M.cover, ...(M.gal ?? []).flat().filter((im) => im.src !== M.cover.src)] : [];
const lastG = groups[groups.length - 1];
const splitImg = pool.length > 3 && lastG && !lastG.list && len(lastG.paras) < 520 ? pool.pop()! : null;
const bands: Img[][] = pool.length > 7 ? [pool.slice(0, Math.ceil(pool.length / 2)), pool.slice(Math.ceil(pool.length / 2))] : pool.length ? [pool] : [];

const blocks: Block[] = [{ kind: 'hook', k: fr ? 'en bref' : 'in short', p: c.lead }];
const asBlock = (g: Group, i: number): Block =>
  g.list ? { kind: 'list', k: g.k, items: g.paras.map((x) => ({ k: x.t!.replace(/[\s.:]+$/, ''), v: x.p })) }
  : splitImg && i === groups.length - 1 ? { kind: 'split', k: g.k, paras: g.paras, img: splitImg }
  : { kind: 'rub', k: g.k, paras: g.paras };
// placement des bandes : après la première rubrique, puis après la liste (choix clés) ou à mi-parcours
const b2at = Math.max(1, groups.findIndex((g) => g.list) >= 0 ? groups.findIndex((g) => g.list) : Math.floor(groups.length / 2));
groups.forEach((g, i) => {
  blocks.push(asBlock(g, i));
  if (i === 0) blocks.push(bands[0] ? { kind: 'band', imgs: bands[0] } : { kind: 'ph' });
  if (i === b2at && bands[1] && i < groups.length - 1) blocks.push({ kind: 'band', imgs: bands[1] });
  if (project.generator && i === groups.length - 2) blocks.push({ kind: 'gen', src: project.generator });
});
if (bands[1] && !blocks.some((b) => b.kind === 'band' && b.imgs === bands[1])) blocks.splice(blocks.length - 1, 0, { kind: 'band', imgs: bands[1] });
if (c.blocks?.length) blocks.push({ kind: 'list', k: fr ? 'en bref' : 'in short', items: c.blocks });

// textes alternatifs et légendes : celle de captions.ts, sinon « visuel 03/19 »
const allImgs = [...bands.flat(), ...(splitImg ? [splitImg] : [])];
const imgTotal = allImgs.length;
const imgNo = (im: Img) => allImgs.indexOf(im) + 1;
const capOf = (im: Img) => captions[im.src]?.[lang] || `${fr ? 'visuel' : 'visual'} ${pad(imgNo(im))}/${pad(imgTotal)}`;
// données structurées : l'étude comme œuvre, signée par la personne décrite dans Base (#me)
const home = new URL('/', Astro.site ?? 'https://kerningkastle.com').href;
const workLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: c.title, description: c.lead, inLanguage: lang,
  url: new URL(`/${lang}/work/${project.slug}/`, home).href,
  ...(M ? { image: new URL(M.cover.src, home).href } : {}),
  ...(project.years.length ? { dateCreated: String(project.years[0]) } : {}),
  creator: { '@id': `${home}#me` }, isPartOf: { '@id': `${home}#site` },
};
---
<Base lang={lang} title={c.title} description={c.lead.length < 110 ? `${c.lead} ${c.meta.role} · ${c.meta.tools}.` : c.lead} path={`work/${project.slug}/`} active="work">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
    <script is:inline>
      // arrivée par « Projet suivant » : drapeau lu tout de suite, puis effacé
      try { window.kkArriving = sessionStorage.getItem('kk-next') === '1'; sessionStorage.removeItem('kk-next'); } catch (e) { window.kkArriving = false; }
      // navigateurs sans transition entre pages (Firefox, Zen…) : la page arrive titre d'abord, par un repli en JS (voir plus bas)
      window.kkXVT = 'CSSViewTransitionRule' in window && 'onpagereveal' in window;
      if (window.kkArriving && !window.kkXVT) document.documentElement.classList.add('kk-flip');
      // titre continu (transition entre documents) : seulement pour l'ouverture du projet suivant
      addEventListener('pageswap', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkLeavingNext || !window.kkXVT) { e.viewTransition.skipTransition(); return; }
        const h = document.querySelector('.next-title .vt'); if (h) h.style.viewTransitionName = 'case-title';
        const l = document.querySelector('.nx [data-cl] .vl'); if (l) l.style.viewTransitionName = 'case-lab';
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        if (!window.kkArriving || !window.kkXVT) { e.viewTransition.skipTransition(); return; }
        const h = document.querySelector('.case-h1 .vt'); if (h) h.style.viewTransitionName = 'case-title';
        const l = document.querySelector('.s1 [data-cl] .vl'); if (l) l.style.viewTransitionName = 'case-lab';
      });
    </script>
  </Fragment>

  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label={fr ? 'Visuel agrandi' : 'Enlarged visual'}>
    <img alt="" decoding="async" />
    <p class="lbc mono"><span data-lbc></span><span class="mu" data-lbn></span></p>
  </div>

  <div class="screens-host case" data-screens>
    <section class="scr s1" aria-labelledby="case-title">
      <div class="head g">
        <p class="lab mono mu par s1-late" data-cl><span class="vl">{fr ? 'projet' : 'project'} {pad(index + 1)}/{N}</span></p>
        <h1 class="case-h1" id="case-title"><span class="vt">{c.title}</span></h1>
        <dl class="fiche mono s1-late">
          <div><dt class="mu">{t.meta.year}</dt><dd>{c.meta.year}</dd></div>
          <div><dt class="mu">{t.meta.context}</dt><dd>{c.meta.context}</dd></div>
          <div><dt class="mu">{t.meta.role}</dt><dd>{c.meta.role}</dd></div>
          <div><dt class="mu">{t.meta.tools}</dt><dd>{c.meta.tools}</dd></div>
        </dl>
      </div>
    </section>

    {blocks.map((b) =>
      b.kind === 'hook' ? (
        <section class="scr">
          <div class="in g">
            <h2 class="lab mono mu par">{b.k}</h2>
            <p class="bd t56" data-hola data-fit>{b.p}</p>
          </div>
        </section>
      ) : b.kind === 'rub' ? (
        <section class="scr">
          <div class="in g">
            <h2 class="lab mono mu par">{b.k}</h2>
            <div class="bd txt t28" data-hola data-fit>{b.paras.map((p) => <p>{p.t && <b>{p.t} </b>}{p.p}</p>)}</div>
          </div>
        </section>
      ) : b.kind === 'split' ? (
        <section class="scr">
          <div class="in g sp">
            <h2 class="lab mono mu par" data-caplab>{b.k}</h2>
            <div class="bd txt t28" data-hola data-fit>{b.paras.map((p) => <p>{p.t && <b>{p.t} </b>}{p.p}</p>)}</div>
            <figure class="spi" data-enter data-no-ascii>
              <img class="md" src={b.img.src} srcset={ss(b.img)} sizes="(max-width: 760px) 100vw, 40vw" width={b.img.w} height={b.img.h} alt={`${c.title} — ${capOf(b.img)}`} data-cap={capOf(b.img)} data-n={`${pad(imgNo(b.img))}/${pad(imgTotal)}`} loading="lazy" decoding="async" />
            </figure>
          </div>
        </section>
      ) : b.kind === 'list' ? (
        <section class="scr">
          <div class="in g">
            <h2 class="lab mono mu par">{b.k}</h2>
            <ul class="bd idx" data-hola data-fit>
              {b.items.map((it, i) => (
                <li><span class="mono mu n">{pad(i + 1)}</span><h3 class="t28">{it.k}</h3><p class="mono mu dl">{it.v}</p></li>
              ))}
            </ul>
          </div>
        </section>
      ) : b.kind === 'band' ? (
        <section class="scr bandscr" data-still data-band>
          <div class="in g">
            <p class="lab mono mu par" data-caplab>{fr ? 'visuels' : 'visuals'}</p>
            <div class="band" data-enter data-no-ascii>
              <div class="track" data-track>
                {b.imgs.map((im) => vid(im.src)
                  ? <video class="md" src={im.src} width={im.w} height={im.h} autoplay muted loop playsinline preload="metadata" aria-label={c.title}></video>
                  : <img class="md" src={im.src} srcset={ss(im)} sizes="(max-width: 760px) 80vw, 50vw" width={im.w} height={im.h} alt={`${c.title} — ${capOf(im)}`} data-cap={capOf(im)} data-n={`${pad(imgNo(im))}/${pad(imgTotal)}`} loading="lazy" decoding="async" />)}
              </div>
            </div>
          </div>
        </section>
      ) : b.kind === 'gen' ? (
        <section class="scr">
          <div class="in g">
            <p class="lab mono mu par">{fr ? 'générateur' : 'generator'}</p>
            <div class="bd gen">
              <p class="mono mu">{fr ? 'entrez une clé, obtenez son blason' : 'enter a key, get its coat of arms'}</p>
              <iframe src={b.src} title={fr ? 'Générateur héraldique' : 'Heraldry generator'} loading="lazy"></iframe>
            </div>
          </div>
        </section>
      ) : (
        <section class="scr bandscr" data-still>
          <div class="in g">
            <p class="lab mono mu par">{fr ? 'visuels' : 'visuals'}</p>
            <div class="band"><div class="track">{[0, 1, 2].map(() => <div class="ph md" role="img" aria-label={t.visual}><i aria-hidden="true">{t.visual}</i></div>)}</div></div>
          </div>
        </section>
      ),
    )}

    <section class="scr nx" aria-labelledby="next-l">
      <div class="in g">
        <p class="lab mono mu par" id="next-l" data-cl><span class="vl">{t.next} {pad(((index + 1) % projects.length) + 1)}/{N}</span></p>
        <div class="bd tt">
          <h2 class="next-title t56"><span class="vt">{nc.title}</span></h2>
          <p class="mono mu">{nc.short} — {next.yearLabel}</p>
        </div>
        <a class="ring" href={`/${lang}/work/${next.slug}/`} data-next aria-label={`${t.next} : ${nc.title}`}>
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="54" class="track0" /><circle cx="60" cy="60" r="54" class="arc" data-arc /></svg>
          <span class="mono" aria-hidden="true">{t.nextShort}</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  @view-transition { navigation: auto; }
  /* Titre continu : le titre du projet suivant glisse jusqu'à sa place de titre, sans fondu ni déformation
     (même texte, même taille, une seule ligne : seul le déplacement est animé). L'ancienne page disparaît net,
     la nouvelle arrive une fois le titre posé. */
  .vt { display: inline-block; white-space: nowrap; }
  ::view-transition-group(case-title) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-title) { animation: none; opacity: 0; }
  ::view-transition-new(case-title) { animation: none; }
  ::view-transition-group(case-lab) { animation-duration: .9s; animation-timing-function: cubic-bezier(.7, 0, .2, 1); }
  ::view-transition-old(case-lab) { animation: kk-vt-out .45s both; }
  ::view-transition-new(case-lab) { animation: kk-vt-in .9s both; }
  @keyframes kk-vt-out { to { opacity: 0; } }
  ::view-transition { background: var(--bg); }
  ::view-transition-old(root) { animation: none; opacity: 0; }
  ::view-transition-new(root) { animation: kk-vt-in .9s both; }
  @keyframes kk-vt-in { 0%, 70% { opacity: 0; } 100% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }
  /* repli sans transition entre pages : le titre attend d'être replacé à son ancienne position, le menu arrive après lui */
  html.kk-flip .case-h1 .vt, html.kk-flip .site-header { opacity: 0; }
</style>

<style>
  /* Gabarit projet : un libellé entre parenthèses en colonnes 1 à 3 (comme « à propos »), le contenu sur l'axe de la colonne 4. */
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .bd { grid-column: 4 / 11; align-self: first baseline; }

  /* page de garde : très grand titre en bas, fiche dessous ; le numéro et la fiche arrivent après le titre */
  .s1 .head { height: 100%; align-content: stretch; grid-template-rows: auto 1fr auto auto; row-gap: 24px; padding-top: calc(var(--head) + 24px); padding-bottom: 32px; }
  .s1 .lab { grid-row: 1; }
  .case-h1 { grid-column: 1 / -1; grid-row: 3; font-weight: 500; font-size: min(10.5vw, 17dvh); line-height: .86; letter-spacing: -0.05em; margin-left: -.05em; }
  .fiche { grid-column: 1 / -1; grid-row: 4; display: grid; grid-template-columns: subgrid; border-top: 1px solid var(--ln); padding-top: 12px; }
  .fiche > div { grid-column: span 3; }
  .fiche dd { margin-top: 4px; }

  .txt p + p { margin-top: .7em; }
  .txt b { font-weight: 500; }

  /* texte et image côte à côte */
  .sp .bd { grid-column: 4 / 8; }
  .spi { grid-column: 9 / -1; align-self: center; margin: 0; }
  .spi img { display: block; width: auto; max-width: 100%; height: auto; max-height: calc(100dvh - var(--head) - 140px); }

  /* index (choix clés) : numéro, intitulé, explication */
  .idx { display: grid; grid-template-columns: subgrid; row-gap: 20px; }
  .idx > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 4px; align-items: baseline; }
  .idx .n { font-size: 12px; grid-column: 1; grid-row: 1; }
  .idx h3 { grid-column: 2 / -1; font-weight: 500; }
  .idx .dl { grid-column: 2 / -1; font-size: 12px; text-transform: none; }

  /* bande de visuels : les images à la même hauteur, côte à côte, qui défilent à l'horizontale (molette, pavé, doigt) ;
     elle part de l'axe de la colonne 4 et file jusqu'au bord droit de l'écran */
  .bandscr .in { row-gap: 20px; }
  .bandscr .lab { align-self: start; }
  .band { grid-column: 4 / -1; margin-right: calc(-1 * var(--m)); overflow: hidden; }
  .track { display: flex; gap: var(--gut); width: max-content; padding-right: var(--m); will-change: transform; }
  .track .md { display: block; height: min(66dvh, 760px); width: auto; flex: none; }
  .track .ph.md { aspect-ratio: 4 / 3; }
  .track img.md { cursor: zoom-in !important; }
  .band { touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .band img { -webkit-user-drag: none; }
  .lab .cap { text-transform: none; }

  .gen { display: grid; row-gap: 16px; grid-column: 4 / -1; }
  .gen iframe { width: 100%; aspect-ratio: 16 / 9; max-height: calc(100dvh - var(--head) - 180px); border: 1px solid var(--ln); background: #fff; }

  /* zoom */
  .spi img { cursor: zoom-in !important; }
  .lb { position: fixed; inset: 0; z-index: 70; display: grid; place-items: center; padding: calc(var(--head) + 8px) var(--m) 56px; background: color-mix(in srgb, var(--bg) 96%, transparent); }
  .lb[hidden] { display: none; }
  .lb img { max-width: 100%; max-height: calc(100dvh - var(--head) - 64px); width: auto; height: auto; object-fit: contain; cursor: zoom-out !important; }
  .lbc { position: absolute; left: var(--m); bottom: 20px; right: var(--m); display: flex; justify-content: space-between; font-size: 12px; text-transform: none; }

  /* projet suivant : le titre attend en haut ; à l'ouverture il descend et grandit jusqu'à devenir le titre de la page de garde */
  .nx .in { position: relative; align-content: start; }
  .nx .tt > .mono { margin-top: 12px; }
  .ring { position: absolute; right: var(--m); bottom: 40px; width: 160px; height: 160px; display: grid; place-items: center; }
  .ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring circle { fill: none; stroke-width: 1.5; }
  .ring .track0 { stroke: var(--ln); }
  .ring .arc { stroke: var(--fg); stroke-dasharray: 339.3; stroke-dashoffset: 339.3; transform: rotate(-90deg); transform-origin: 60px 60px; }
  .vl { display: inline-block; white-space: nowrap; }

  @media (max-width: 760px) {
    .lab, .bd, .sp .bd, .spi, .gen { grid-column: 1 / -1; }
    .s1 .head { grid-template-rows: auto 1fr auto auto; row-gap: 16px; padding-top: calc(var(--head) + 20px); padding-bottom: min(32px, 4dvh); }
    .case-h1 { font-size: min(15vw, 12dvh); }
    .fiche { grid-template-columns: 1fr 1fr; gap: 12px var(--gut); border-top: 0; padding-top: 0; }
    .fiche > div { grid-column: auto; }
    .spi img { max-height: 38dvh; }
    .sp { row-gap: 20px; }
    .idx { grid-template-columns: 1fr auto; row-gap: min(20px, 2.4dvh); }
    .idx h3 { grid-column: 1; grid-row: 1; }
    .idx .n { grid-column: 2; grid-row: 1; justify-self: end; }
    .idx .dl { grid-column: 1 / -1; grid-row: 2; }
    /* téléphone : la bande déborde des deux côtés, elle avance seule et se fait glisser au doigt */
    .band { grid-column: 1 / -1; margin-inline: calc(-1 * var(--m)); }
    .track .md { height: min(52dvh, 120vw); }
    .nx .in { align-content: start; padding-top: calc(var(--head) + 56px); }
    .nx .lab { position: absolute; top: calc(var(--head) + 20px); left: var(--m); }
    .ring { width: 112px; height: 112px; bottom: min(72px, 9dvh); left: var(--m); right: auto; }
  }
</style>

<script>
  import { letters, fadeMono, reduced } from '../../../scripts/motion';
  const run = () => {
    const api = window.kkScreens!;
    const host = document.querySelector<HTMLElement>('[data-screens]')!;
    const last = api.count - 1;
    const ring = document.querySelector<HTMLAnchorElement>('[data-next]')!;
    const arc = document.querySelector<SVGCircleElement>('[data-arc]')!;
    const RING = 3500;
    let fill: Animation | null = null;
    const phone = matchMedia('(max-width: 760px)');

    // arrivée par « Projet suivant », sans transition entre pages : le titre part de là où il était sur la page précédente
    // (position mémorisée) et glisse jusqu'à sa place — même trajet et même courbe que la transition native
    const root = document.documentElement;
    if (root.classList.contains('kk-flip')) {
      const h = document.querySelector<HTMLElement>('.case-h1 .vt')!, hd = document.querySelector<HTMLElement>('.site-header');
      let from: { x: number; y: number; w?: number } | null = null;
      try { from = JSON.parse(sessionStorage.getItem('kk-next-r') || 'null'); sessionStorage.removeItem('kk-next-r'); } catch { /* */ }
      const r = h.getBoundingClientRect();
      root.classList.remove('kk-flip');
      const k = from?.w ? from.w / r.width : 1;
      if (from) h.animate([{ transformOrigin: '0 0', transform: `translate(${from.x - r.left}px, ${from.y - r.top}px) scale(${k})` }, { transformOrigin: '0 0', transform: 'none' }], { duration: 1000, easing: 'cubic-bezier(.7, 0, .2, 1)' });
      hd?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, delay: 620, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' });
    }

    // texte : s'il ne tient pas dans son écran (téléphone, fenêtre basse), il descend par paliers jusqu'à tenir
    const fit = () => document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
      const scr = el.closest<HTMLElement>('.scr')!;
      const big = el.classList.contains('idx') ? [...el.querySelectorAll<HTMLElement>('h3')] : [el];
      if (!big.length) return;
      big.forEach((b) => { b.style.fontSize = ''; });
      const min = innerWidth <= 760 ? 14 : 17;
      let f = parseFloat(getComputedStyle(big[0]).fontSize);
      while (scr.scrollHeight > scr.clientHeight + 1 && f > min) {
        f -= 2;
        big.forEach((b) => { b.style.fontSize = f + 'px'; });
      }
    });
    // titre de garde : ramené à la largeur de l'écran s'il est trop long
    const fitTitle = () => {
      const h = document.querySelector<HTMLElement>('.case-h1'), v = h?.querySelector<HTMLElement>('.vt');
      if (!h || !v) return;
      h.style.fontSize = '';
      const room = h.clientWidth, w = v.getBoundingClientRect().width;
      if (w > room) h.style.fontSize = parseFloat(getComputedStyle(h).fontSize) * room / w * 0.98 + 'px';
    };
    let ft = 0;
    const refit = () => { fitTitle(); fit(); };
    refit(); document.fonts.ready.then(refit);
    addEventListener('resize', () => { clearTimeout(ft); ft = window.setTimeout(refit, 150); });

    // page de garde : rien au-dessus du titre avant lui — le numéro et la fiche arrivent une fois le titre posé
    const s1 = api.el(0);
    const arriving = (window as any).kkArriving;
    if (!reduced()) s1.querySelectorAll<HTMLElement>('.s1-late').forEach((el, i) =>
      el.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 420, delay: (arriving ? 1150 : 1000) + i * 120, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' }));
    if (arriving) letters(s1, 650, '.case-h1');

    const open = () => {
      if ((window as any).kkLeavingNext) return;
      (window as any).kkLeavingNext = !reduced();
      try { if (!reduced()) sessionStorage.setItem('kk-next', '1'); } catch { /* */ }
      // sans transition entre pages : tout s'efface autour du titre du projet suivant, qui reste seul à l'écran ; on note sa place
      if (!reduced() && !(window as any).kkXVT) {
        const h = document.querySelector<HTMLElement>('.next-title .vt'), b = h?.getBoundingClientRect();
        try { if (b) sessionStorage.setItem('kk-next-r', JSON.stringify({ x: b.left, y: b.top, w: b.width })); } catch { /* */ }
        const fade = [...document.querySelectorAll<HTMLElement>('.site-header, .more-arrow, .nx .lab, .nx .tt > p, .nx .ring')];
        Promise.all(fade.map((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 280, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' }).finished))
          .then(() => { location.href = ring.href; });
        return;
      }
      location.href = ring.href;
    };
    const stop = () => { if (fill) { fill.onfinish = null; fill.cancel(); fill = null; } };
    const start = () => {
      stop();
      if (reduced()) return; // pas d'ouverture automatique : l'anneau s'ouvre au clic
      fill = arc.animate([{ strokeDashoffset: 339.3 }, { strokeDashoffset: 0 }], { duration: RING, easing: 'linear', fill: 'forwards' });
      if (document.hidden) fill.pause();
      dispatchEvent(new CustomEvent('kk:sound', { detail: 'ring' }));
      fill.onfinish = open;
    };
    host.addEventListener('screens:enter', (e) => { if ((e as CustomEvent).detail.index === last) start(); });
    host.addEventListener('screens:leave', (e) => { if ((e as CustomEvent).detail.from === last) stop(); });
    host.addEventListener('screens:beyond', open);
    ring.addEventListener('click', (e) => { e.preventDefault(); open(); });
    document.addEventListener('visibilitychange', () => { if (!fill) return; document.hidden ? fill.pause() : fill.play(); });
    // un clic ailleurs (menu…) annule le minuteur
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-next]')) stop(); }, true);
    addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) { (window as any).kkLeavingNext = false; stop(); } });
    if (api.current() === last) start();

    // préchargement : les images de l'écran d'après, et la page du projet suivant à l'approche de la fin
    let pre = false;
    host.addEventListener('screens:enter', (e) => {
      const i = (e as CustomEvent).detail.index;
      api.el(i + 1)?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((m) => { m.loading = 'eager'; });
      if (!pre && i >= last - 2) { pre = true; const l = document.createElement('link'); l.rel = 'prefetch'; l.href = ring.href; document.head.appendChild(l); }
    });

    // ---------- entrée des images : une montée courte, en cascade, pendant la fin du glissement ----------
    const play = (scr: HTMLElement, delay: number) => {
      if (reduced()) return;
      scr.querySelector<HTMLElement>('[data-enter]')?.querySelectorAll<HTMLElement>('.md').forEach((m, i) => {
        if (i > 3) return; // au-delà, les images sont hors champ
        const a = m.animate([{ opacity: 0, transform: 'translateX(40px)' }, { opacity: 1, transform: 'none' }], { duration: 700, delay: i * 90, easing: 'cubic-bezier(.2,.7,.2,1)', fill: 'backwards' });
        a.startTime = (document.timeline.currentTime as number) + delay;
      });
    };
    host.addEventListener('screens:leave', (e) => { const el = api.el((e as CustomEvent).detail.to); if (el) play(el, 220); });

    // ---------- bandes de visuels ----------
    // Le défilement vertical reste celui du site (un geste = un écran). La bande avance seule, lentement, en boucle ;
    // elle ralentit et s'arrête sous la souris, et se fait glisser à la main (souris ou doigt) pour aller plus vite.
    const SPEED = 38; // px/s
    document.querySelectorAll<HTMLElement>('[data-band]').forEach((scr) => {
      const band = scr.querySelector<HTMLElement>('.band')!, track = scr.querySelector<HTMLElement>('[data-track]')!;
      // boucle sans couture : la série est doublée (copies masquées aux lecteurs d'écran)
      const orig = [...track.children] as HTMLElement[];
      orig.forEach((el) => {
        const k = el.cloneNode(true) as HTMLElement;
        k.setAttribute('aria-hidden', 'true'); k.setAttribute('data-clone', '');
        if (k instanceof HTMLImageElement) { k.alt = ''; k.loading = 'lazy'; }
        track.appendChild(k);
      });
      let x = 0, v = 0, last = 0, raf = 0, hover = false, drag = false, sx = 0, sx0 = 0, moved = 0, vDrag = 0, lastPx = 0, lastT = 0;
      const loopW = () => { const f = track.children[orig.length] as HTMLElement | undefined; return f ? f.offsetLeft - (track.children[0] as HTMLElement).offsetLeft : track.scrollWidth / 2; };
      const set = () => { const L = loopW(); if (L > 0) x = ((x % L) + L) % L; track.style.transform = `translate3d(${-x}px,0,0)`; (window as any).kkCapAt?.(); };
      const active = () => api.el(api.current()) === scr && !document.hidden;
      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
        if (!drag) {
          const want = hover || reduced() ? 0 : SPEED;
          v += (want - v) * Math.min(1, dt * 3);       // accélère et freine en douceur
          vDrag *= Math.pow(0.04, dt);                    // élan d'un lancer à la main
          x += (v + vDrag) * dt;
          set();
        }
        raf = active() ? requestAnimationFrame(tick) : 0;
        if (!raf) last = 0;
      };
      const kick = () => { if (!raf && active()) raf = requestAnimationFrame(tick); };
      host.addEventListener('screens:enter', kick);
      host.addEventListener('screens:leave', (e) => { if (api.el((e as CustomEvent).detail.to) === scr) { v = reduced() ? 0 : SPEED; requestAnimationFrame(kick); } });
      document.addEventListener('visibilitychange', kick);
      band.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
      band.addEventListener('pointerleave', () => { hover = false; });
      // glisser à la main : seulement à l'horizontale (touch-action: pan-y laisse le geste vertical au site)
      band.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        drag = true; moved = 0; sx = e.clientX; sx0 = x; lastPx = e.clientX; lastT = performance.now(); vDrag = 0;
        band.setPointerCapture(e.pointerId); document.documentElement.classList.add('grabbing');
      });
      band.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const now = performance.now();
        moved = Math.max(moved, Math.abs(e.clientX - sx));
        x = sx0 - (e.clientX - sx); set();
        if (now > lastT) { vDrag = -(e.clientX - lastPx) / ((now - lastT) / 1000); lastPx = e.clientX; lastT = now; }
      });
      const end = () => { if (!drag) return; drag = false; document.documentElement.classList.remove('grabbing'); if (performance.now() - lastT > 80) vDrag = 0; vDrag = Math.max(-3000, Math.min(3000, vDrag)); kick(); };
      band.addEventListener('pointerup', end); band.addEventListener('pointercancel', end);
      // un glissement n'ouvre pas le zoom
      band.addEventListener('click', (e) => { if (moved > 6) { e.stopPropagation(); e.preventDefault(); } }, true);
      band.addEventListener('dragstart', (e) => e.preventDefault());
      set(); kick();
    });

    // ---------- légende au survol : elle remplace le libellé de l'écran (recalculée aussi quand la bande défile sous la souris) ----------
    let px = -1, py = -1;
    addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; capAt(); }, { passive: true });
    const bases = new Map<HTMLElement, string>();
    document.querySelectorAll<HTMLElement>('[data-caplab]').forEach((l) => bases.set(l, l.textContent || ''));
    const capAt = () => {
      const el = px < 0 ? null : document.elementFromPoint(px, py)?.closest<HTMLImageElement>('img[data-cap]');
      bases.forEach((base, l) => {
        const mine = el && l.closest('.in')?.contains(el);
        const txt = mine ? (el!.dataset.cap!.endsWith(el!.dataset.n!) ? el!.dataset.cap! : `${el!.dataset.cap} — ${el!.dataset.n}`) : base;
        if (l.textContent !== txt) l.textContent = txt;
      });
    };
    (window as any).kkCapAt = capAt;

    // ---------- zoom ----------
    const lb = document.querySelector<HTMLElement>('[data-lb]')!, lbImg = lb.querySelector('img')!;
    const lbc = lb.querySelector<HTMLElement>('[data-lbc]')!, lbn = lb.querySelector<HTMLElement>('[data-lbn]')!;
    const all = [...document.querySelectorAll<HTMLImageElement>('img[data-cap]:not([data-clone])')];
    let at = -1;
    const show = (i: number) => {
      at = (i + all.length) % all.length;
      const m = all[at];
      lbImg.src = m.getAttribute('data-real') || m.getAttribute('src') || ''; lbImg.width = m.width; lbImg.height = m.height;
      const cap = m.dataset.cap || '', n = m.dataset.n || '';
      lbc.textContent = cap; lbn.textContent = cap.endsWith(n) ? '' : n;
    };
    const block = (e: Event) => {
      e.stopPropagation();
      if (e.type === 'wheel') { close(); return; }
      if (e.type !== 'keydown') return;
      const k = (e as KeyboardEvent).key;
      if (k === 'Escape') close();
      else if (k === 'ArrowRight' || k === 'ArrowDown') show(at + 1);
      else if (k === 'ArrowLeft' || k === 'ArrowUp') show(at - 1);
      e.preventDefault();
    };
    const EVS = ['wheel', 'keydown', 'touchstart'] as const;
    const openLb = (m: HTMLImageElement) => {
      show(all.indexOf(m));
      lb.hidden = false;
      EVS.forEach((t) => addEventListener(t, block, { capture: true, passive: false }));
      if (reduced()) return;
      const a = m.getBoundingClientRect(), b = lbImg.getBoundingClientRect();
      if (b.width) lbImg.animate([{ transformOrigin: '0 0', transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.width / b.width})` }, { transformOrigin: '0 0', transform: 'none' }], { duration: 560, easing: 'cubic-bezier(.7, 0, .2, 1)' });
      lb.animate([{ backgroundColor: 'transparent' }, {}], { duration: 360, easing: 'ease-out' });
      lb.querySelector('.lbc')?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 380, fill: 'backwards' });
    };
    function close() {
      if (lb.hidden) return;
      EVS.forEach((t) => removeEventListener(t, block, { capture: true }));
      if (reduced()) { lb.hidden = true; return; }
      lb.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, easing: 'ease-in' }).finished.then(() => { lb.hidden = true; });
    }
    document.querySelectorAll<HTMLImageElement>('img[data-cap]').forEach((m) => m.addEventListener('click', () => {
      const o = all.find((a) => a.dataset.n === m.dataset.n) || m;
      if (o === m) { openLb(m); return; }
      // copie dans la boucle : le zoom part de l'image cliquée, mais la navigation suit la série d'origine
      show(all.indexOf(o)); const tmp = all[at]; all[at] = m; openLb(m); all[at] = tmp;
    }));
    lb.addEventListener('click', close);
  };
  if (window.kkScreens) run(); else document.addEventListener('kk:screens', run, { once: true });
</script>
