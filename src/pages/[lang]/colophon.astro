---
// Colophon : comme à la fin des manuscrits, la page où le scribe dit comment le livre a été fait.
// Un écran par rubrique (libellé en colonne 1, texte sur l'axe de la colonne 4), et l'« achevé d'écrire » daté du build.
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { languages, getLangFromParam } from '../../data/ui';
import { execSync } from 'node:child_process';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const fr = lang === 'fr';
let rev = '';
try { rev = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { /* hors dépôt */ }
const built = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' }).format(new Date());

// volontairement bref : on dit de quoi le site est fait, pas comment (une partie reste au scribe)
const R: [string, string[]][] = fr
  ? [
      ['Colophon', ['Comme à la fin d\'un manuscrit, quelques lignes sur la façon dont ce site a été fait. Pas toutes.']],
      ['Écriture', ['Composé en Geist et Geist Mono, de Vercel et basement.studio.']],
      ['Fabrication', ['Écrit à la main, sans framework ni cookie, servi par GitHub Pages.']],
      ['Le portrait', ['Une seule photo, mise en relief. Le reste est un secret d\'atelier.']],
      ['Son et mouvement', ['Aucun fichier son : tout est synthétisé dans votre navigateur, au rythme de la page.']],
    ]
  : [
      ['Colophon', ['As at the end of a manuscript, a few lines on how this site was made. Not all of them.']],
      ['Type', ['Set in Geist and Geist Mono, by Vercel and basement.studio.']],
      ['Making', ['Handwritten, with no framework and no cookies, served by GitHub Pages.']],
      ['The portrait', ['A single photo, turned into relief. The rest is a workshop secret.']],
      ['Sound and motion', ['No sound files: everything is synthesised in your browser, in time with the page.']],
    ];
const fin = fr
  ? `Ici finit le site. Achevé d'écrire à Paris, le ${built}${rev ? ` (version ${rev})` : ''}.`
  : `Here ends the site. Finished writing in Paris, on ${built}${rev ? ` (version ${rev})` : ''}.`;
---
<Base lang={lang} title="Colophon" description={fr ? 'Colophon de kerningkastle.com : caractères, fabrication, portrait en relief, son et mouvement.' : 'Colophon of kerningkastle.com: type, making, the relief portrait, sound and motion.'} path="colophon/">
  <div class="screens-host" data-screens>
    {R.map(([k, ps], i) => (
      <section class="scr" aria-labelledby={`co-${i}`}>
        <div class="in g">
          <h2 class="lab mono mu par" id={`co-${i}`}>{i === 0 ? <span>{k}</span> : <span><span class="ru">¶</span> {k}</span>}</h2>
          <div class="bd">{ps.map((p) => <p class={i === 0 ? 't56' : 't28'}>{p}</p>)}</div>
        </div>
      </section>
    ))}
    <section class="scr last" aria-label={fr ? 'Achevé d\'écrire' : 'Finished writing'}>
      <div class="in g"><p class="bd t28 fin">{fin}</p></div>
      <Footer lang={lang} class="line" />
    </section>
  </div>
</Base>

<style>
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .lab .ru { color: var(--ac); }
  .bd { grid-column: 4 / 12; align-self: first baseline; }
  .bd p + p { margin-top: 1em; }
  .fin { font-style: normal; }
  .last { display: flex; flex-direction: column; }
  .last .in { flex: 1; min-height: 0; }
  @media (max-width: 760px) {
    .lab, .bd { grid-column: 1 / -1; }
    .lab { margin-bottom: 20px; }
  }
</style>
