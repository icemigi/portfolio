---
// /xx/lab/ : la liste des pièces du Lab, sobre (titres en t28, sans filets ; glissement et flèche des lignes comme la liste
// des projets). Ordinateur : au survol, un aperçu suit le curseur et fait tourner la pièce en direct ; au clic, il s'étend
// jusqu'au plein écran puis la pièce s'ouvre (page autonome, chargement complet) — scripts/views/lab.ts.
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, getLangFromParam, pad } from '../../data/ui';
import { labItems } from '../../data/lab';
import { av } from '../../data/avif';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const items = labItems(lang);
const DESC = fr ? 'Le Lab de kerningkastle : expériences typographiques et génératives (lettres qui tombent, qui poussent), générateur héraldique, quiz et Letteroastd.' : 'The kerningkastle Lab: type and generative experiments (falling letters, growing letters), heraldry generator, quiz and Letteroastd.';
---
<Base lang={lang} title={t.nav.lab} description={DESC} path="lab/" active="lab">
  <div class="screens-host" data-screens>
    <section class="scr lb" aria-labelledby="lb-t">
      <div class="in g">
        <h1 class="lab mono mu par" id="lb-t">{`${t.nav.lab} ${pad(items.length)}`}</h1>
        <ol class="ll" data-lablist>
          {items.map((x, i) => (
            <li>
              <a class="row" href={x.href} data-astro-reload data-id={x.id} data-cover={av(`/lab/covers/${x.id}.webp`)} data-live={x.live}>
                <span class="n mono ac">({pad(i + 1)})</span>
                <span class="t t28">{x.title}</span>
                {x.wip && <span class="wip">{t.wip}</span>}
                <span class="c mono mu">{x.cat.toLowerCase()}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="scr" data-peek data-still aria-label={fr ? 'Pied de page' : 'Footer'}><Footer lang={lang} /></section>
  </div>
  <div class="lpv" data-lpv aria-hidden="true"><img alt="" decoding="async" data-no-ascii /></div>
</Base>

<style>
  .lb .in { min-height: 100%; align-content: center; padding-top: var(--head); }
  .lb .lab { position: absolute; left: var(--m); top: calc(var(--head) + 16px); margin: 0; }
  .ll { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; }
  .row { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gut); align-items: baseline; padding: 10px 0; }
  .row .n { grid-column: 1 / 3; font-size: 11px; }
  .row .t { grid-column: 3 / 8; }
  /* pièce en travaux (style .wip global) : sa place dans la grille */
  .row .wip { grid-column: 8 / 10; justify-self: start; }
  .row .c { grid-column: 10 / 13; justify-self: end; font-size: 11px; }
  .row :is(.t, .n, .c, .wip) { transition: opacity .3s var(--out), transform .35s var(--out); }
  @media (hover: hover) { .ll:hover .row:not(:hover) :is(.t, .n, .c, .wip) { opacity: .35; } }
  .row:focus-visible { outline: 1px solid var(--ac); outline-offset: 4px; }

  /* aperçu : un écran entier réduit (lab.ts le place et l'agrandit) */
  .lpv { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .lpv { display: block; position: fixed; left: 0; top: 0; z-index: 30; width: 100vw; height: 100vh; transform-origin: 0 0; overflow: hidden;
      pointer-events: none; opacity: 0; transition: opacity .25s var(--out); background: var(--bg); box-shadow: 0 40px 120px -30px rgba(0, 0, 0, .45); }
    .lpv:global(.on) { opacity: 1; }
    .lpv img, .lpv :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; border: 0; }
    .lpv :global(iframe) { opacity: 0; transition: opacity .4s var(--out); }
    .lpv :global(iframe.ready) { opacity: 1; }
  }
  @media (max-width: 760px) {
    /* la liste commence sous le libellé « (lab 08) », jamais dessous */
    .lb .in { padding-top: calc(var(--head) + 56px); }
    .row .n { grid-column: 1 / 2; }
    .row .t { grid-column: 2 / 5; }
    .row .wip { grid-column: 2 / 5; }
    .row .c { grid-column: 2 / 5; justify-self: start; }
  }
</style>
