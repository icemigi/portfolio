---
// /xx/lab/ : une galerie de pochettes, à la façon du Cover Flow d'iTunes mais allégée : la pièce du centre de face,
// les autres inclinées et estompées de chaque côté. La molette fait passer une pochette par geste, comme les écrans du site (molette roulée sans pause : elles s'enchaînent) ;
// arrivé au bout, un nouveau geste passe à l'écran suivant. Flèches, glisser ou clic sur une
// pochette de côté pour parcourir ; clic sur celle du centre (ou Entrée) pour ouvrir la pièce.
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, getLangFromParam, pad } from '../../data/ui';
import { rooms, labApps } from '../../data/lab';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const items = [
  ...rooms.map((r) => ({ id: r.id, title: r[lang].title.replace(/^\[|\]$/g, '').replace(/ — .*$/, ''), cat: r[lang].cat, year: r.year, href: `/${lang}/lab/${r.id}/` })),
  ...labApps.map((a) => ({ id: a.id, title: a[lang].title, cat: a[lang].cat, year: a.year, href: `${a.src}?lang=${lang}` })),
];
const N = items.length;
const start = Math.floor((N - 1) / 2);
---
<Base lang={lang} title={t.nav.lab} description={fr ? 'Le Lab de kerningkastle : expériences typographiques et génératives (lettres qui tombent, qui poussent, type modulaire), générateur héraldique, quiz et Letteroastd.' : 'The kerningkastle Lab: type and generative experiments (falling letters, growing letters, modular type), heraldry generator, quiz and Letteroastd.'} path="lab/" active="lab">
  <div class="screens-host" data-screens>
    <section class="scr" data-still aria-labelledby="lb-t">
      <div class="cf" data-cf data-start={start}>
        <h1 class="lab mono mu par" id="lb-t">{t.nav.lab} {pad(N)}</h1>
        <div class="stage" data-stage>
          {items.map((x, i) => (
            <a class="cv" href={x.href} aria-label={`${x.title} — ${x.cat}, ${x.year}`} draggable="false" tabindex={i === start ? 0 : -1}>
              <img src={`/lab/covers/${x.id}.webp`} width="600" height="600" alt="" draggable="false" decoding="async" />
            </a>
          ))}
        </div>
        <div class="cap" aria-live="polite">
          {items.map((x, i) => (
            <p class:list={['ci', { on: i === start }]}>
              <span class="t t28">{x.title}</span>
              <span class="mono mu">{x.cat.toLowerCase()} · {x.year}</span>
            </p>
          ))}
          <p class="ct mono"><span class="ac" data-n>({pad(start + 1)})</span> <span class="mu">/ {pad(N)}</span></p>
        </div>
      </div>
    </section>
    <section class="scr" data-peek data-still aria-label={fr ? 'Pied de page' : 'Footer'}><Footer lang={lang} /></section>
  </div>
</Base>

<style>
  .cf { --s: min(46dvh, 34vw, 480px); position: relative; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding-top: var(--head); overflow: hidden; }
  .cf .lab { position: absolute; left: var(--m); top: calc(var(--head) + 16px); margin: 0; }
  .stage { position: relative; width: 100%; height: var(--s); touch-action: pan-y; user-select: none; cursor: grab; }
  .stage.drag { cursor: grabbing; }
  .cv { position: absolute; left: calc(50% - var(--s) / 2); top: 0; width: var(--s); will-change: transform; -webkit-user-drag: none; }
  .cv img { display: block; width: 100%; height: auto; background: #ddd; box-shadow: 0 0 0 1px rgba(0, 0, 0, .06), 0 24px 50px -24px rgba(0, 0, 0, .35); }
  /* estompe : un voile de la couleur du fond (opaque, donc on ne voit pas les pochettes de derrière à travers) */
  .cv::after { content: ''; position: absolute; inset: 0; background: var(--bg); opacity: var(--f, 0); pointer-events: none; }
  .cv:focus-visible { outline: 2px solid var(--ac); outline-offset: 6px; }
  /* légende : titre et catégorie de la pièce du centre, compteur à droite comme une pagination */
  .cap { position: relative; width: var(--s); height: 3.4em; margin-top: min(32px, 4dvh); }
  .ci { position: absolute; left: 0; top: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .45s var(--out); pointer-events: none; }
  .ci.on { opacity: 1; transform: none; }
  .ci .t { font-size: clamp(18px, 2.6dvh, 24px); }
  .ct { position: absolute; right: 0; top: .35em; margin: 0; }
  @media (max-width: 760px) {
    .cf { --s: min(64vw, 38dvh); }
    .cap { height: 5em; }
    .ct { position: absolute; left: 0; right: auto; top: 3.4em; }
  }
</style>

<script>
  import { reduced } from '../../scripts/motion';
  import { wheelGesture } from '../../scripts/gesture';
  const root = document.querySelector<HTMLElement>('[data-cf]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('.cv')];
    const caps = [...root.querySelectorAll<HTMLElement>('.ci')];
    const num = root.querySelector<HTMLElement>('[data-n]')!;
    const N = cards.length;
    const still = reduced();
    let cur = Number(root.dataset.start) || 0, target = cur, raf = 0, shown = cur;
    const size = () => cards[0].offsetWidth;
    // pochettes de côté : inclinées à 45°, plus petites, de plus en plus estompées
    const place = () => {
      const S = size(), G0 = S * 0.78, G = S * 0.34, P = S * 3.2;
      cards.forEach((c, k) => {
        const d = k - cur, a = Math.abs(d), sg = Math.sign(d), near = Math.min(a, 1);
        const x = sg * (near * G0 + Math.max(a - 1, 0) * G);
        c.style.transform = `perspective(${P.toFixed(0)}px) translateX(${x.toFixed(1)}px) rotateY(${(-sg * near * 45).toFixed(2)}deg) scale(${(1 - near * 0.18).toFixed(3)})`;
        c.style.setProperty('--f', Math.min(0.85, Math.max(a - 0.4, 0) * 0.28).toFixed(3));
        c.style.zIndex = String(100 - Math.round(a * 10));
      });
      const i = Math.round(cur);
      if (i !== shown) {
        shown = i;
        cards.forEach((c, k) => (c.tabIndex = k === i ? 0 : -1));
        caps.forEach((c, k) => c.classList.toggle('on', k === i));
        num.textContent = `(${String(i + 1).padStart(2, '0')})`;
      }
    };
    const loop = () => {
      cur += (target - cur) * 0.13;
      if (Math.abs(target - cur) < 0.001) cur = target;
      place();
      raf = cur !== target ? requestAnimationFrame(loop) : 0;
    };
    const go = (i: number) => {
      const n = Math.max(0, Math.min(N - 1, i));
      if (n === target) return;
      dispatchEvent(new CustomEvent('kk:sound', { detail: 'tick' }));
      target = n;
      if (still) { cur = target; place(); return; }
      if (!raf) raf = requestAnimationFrame(loop);
    };
    place();
    addEventListener('resize', place);

    // molette : comme les écrans du site, un geste = une pochette, et une molette roulée sans pause enchaîne les pochettes.
    // La galerie ne prend la molette que si son écran est en place (pas pendant que le pied de page est affiché) ;
    // au bout, le geste suivant part à l'écran suivant, mais l'inertie du geste en cours ne fait pas sauter l'écran.
    const screen = root.closest<HTMLElement>('.scr');
    const gesture = wheelGesture(() => true);
    let mine = 0;
    root.addEventListener('wheel', (e) => {
      if (screen && Math.abs(screen.getBoundingClientRect().top) > 2) return;
      // Firefox : une molette compte en lignes (deltaMode 1) ou en pages (2), pas en pixels
      const k = e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? innerHeight : 1;
      const dl = (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY) * k, now = performance.now();
      const can = dl > 0 ? target < N - 1 : target > 0;
      if (!can && now - mine > 300) return;
      e.preventDefault(); e.stopPropagation(); mine = now; // la galerie prend la molette : la page ne défile pas
      const step = gesture(now, dl);
      if (step) go(target + step);
    }, { passive: false });

    // clic : de côté = au centre ; au centre = ouvrir
    let moved = false;
    cards.forEach((c, k) => c.addEventListener('click', (e) => { if (moved || k !== target) { e.preventDefault(); if (!moved) go(k); } }));
    // clavier : flèches gauche/droite (haut/bas restent au site)
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault(); go(target + (e.key === 'ArrowRight' ? 1 : -1)); cards[target].focus({ preventScroll: true });
    });
    // glisser horizontalement (souris ou doigt)
    let sx = 0, s0 = 0, down = false;
    stage.addEventListener('pointerdown', (e) => { down = true; moved = false; sx = e.clientX; s0 = target; });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (!moved && Math.abs(dx) > 6) { moved = true; stage.classList.add('drag'); }
      if (moved) go(Math.round(s0 - dx / (size() * 0.4)));
    });
    addEventListener('pointerup', () => { down = false; stage.classList.remove('drag'); setTimeout(() => (moved = false), 0); });
  }
</script>
