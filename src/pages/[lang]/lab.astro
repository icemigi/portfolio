---
// /xx/lab/ : un index, comme la page Projets. Chaque ligne « (01) titre · catégorie · année » ouvre la pièce en pleine page ;
// sur ordinateur, au survol, un aperçu vivant de la pièce (la pièce elle-même, réduite) suit le curseur.
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { ui, languages, getLangFromParam, pad } from '../../data/ui';
import { rooms, labApps } from '../../data/lab';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const fr = lang === 'fr';
const items = [
  ...rooms.map((r) => ({ title: r[lang].title.replace(/^\[|\]$/g, '').replace(/ — .*$/, ''), cat: r[lang].cat, year: r.year, href: `/${lang}/lab/${r.id}/`, pv: r.src ?? `/${lang}/lab/${r.id}/?embed` })),
  ...labApps.map((a) => ({ title: a[lang].title, cat: a[lang].cat, year: a.year, href: a.src, pv: a.src })),
];
---
<Base lang={lang} title={t.nav.lab} description={fr ? 'Le Lab de kerningkastle : expériences typographiques et génératives (lettres qui tombent, qui poussent, type modulaire), générateur héraldique, quiz et Letteroastd.' : 'The kerningkastle Lab: type and generative experiments (falling letters, growing letters, modular type), heraldry generator, quiz and Letteroastd.'} path="lab/" active="lab">
  <div class="screens-host" data-screens>
    <section class="scr" data-still aria-labelledby="lb-t">
      <div class="in g">
        <h1 class="lab mono mu par" id="lb-t">{t.nav.lab} {pad(items.length)}</h1>
        <p class="lg-i t56">{fr ? 'Des expériences, des générateurs et des fontes.' : 'Experiments, generators and typefaces.'}</p>
        <ol class="rows lg-l" data-lab>
          {items.map((x, i) => (
            <li>
              <a class="row" href={x.href} data-pv={x.pv}>
                <span class="n mono">({pad(i + 1)})</span>
                <span class="t t28">{x.title}</span>
                <span class="d mono mu">{x.cat}</span>
                <span class="y mono mu">{x.year}</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="pv" aria-hidden="true" data-pvbox></div>
      </div>
    </section>
    <section class="scr" data-peek data-still aria-label={fr ? 'Pied de page' : 'Footer'}><Footer lang={lang} /></section>
  </div>
</Base>

<style>
  .lg-i, .lg-l { grid-column: 1 / -1; }
  .lg-l { margin-top: min(56px, 6dvh); }
  .row .n { color: var(--ac); }
  .in { position: relative; }
  .pv { display: none; }
  @media (hover: hover) and (pointer: fine) {
    /* aperçu : la pièce rendue à 1200 × 800 puis réduite, sans interaction */
    .pv { display: block; position: absolute; left: 0; top: 0; z-index: 5; width: 420px; height: 280px; overflow: hidden; pointer-events: none; background: #f3f3f3;
      box-shadow: 0 18px 40px rgba(0, 0, 0, .18); opacity: 0; scale: .9; transition: opacity .25s, scale .45s var(--out); will-change: transform; }
    .pv.on { opacity: 1; scale: 1; }
    .pv :global(iframe) { position: absolute; left: 0; top: 0; width: 1200px; height: 800px; border: 0; transform: scale(.35); transform-origin: 0 0; }
  }
</style>

<script>
  // aperçu vivant : la pièce survolée est chargée dans une iframe réduite, qui suit le curseur avec un léger retard ;
  // une seule iframe à la fois, retirée quand la souris quitte la liste (rien ne tourne en arrière-plan)
  const list = document.querySelector<HTMLElement>('[data-lab]');
  const box = document.querySelector<HTMLElement>('[data-pvbox]');
  if (list && box && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const host = box.parentElement!;
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0, first = true, cur = '';
    const loop = () => {
      x += (tx - x) * 0.18; y += (ty - y) * 0.18;
      box.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) rotate(${((tx - x) * 0.03).toFixed(2)}deg)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(loop) : 0;
    };
    list.querySelectorAll<HTMLAnchorElement>('[data-pv]').forEach((a) => a.addEventListener('pointerenter', () => {
      const src = a.dataset.pv!;
      if (src !== cur) { cur = src; box.innerHTML = `<iframe src="${src}" tabindex="-1" loading="eager" title=""></iframe>`; }
      box.classList.add('on');
    }));
    list.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      tx = Math.min(e.clientX - r.left + 32, r.width - 440); ty = e.clientY - r.top - 140;
      if (first) { x = tx; y = ty; first = false; }
      if (!raf) raf = requestAnimationFrame(loop);
    });
    list.addEventListener('pointerleave', () => { first = true; box.classList.remove('on'); setTimeout(() => { if (!box.classList.contains('on')) { box.innerHTML = ''; cur = ''; } }, 300); });
  }
</script>
