---
// À propos : quatre écrans plein cadre, libellé en colonne 1, contenu sur l'axe de la colonne 4.
import Base from '../../layouts/Base.astro';
import Affiche from '../../components/Affiche.astro';
import ContactScreen from '../../components/ContactScreen.astro';
import { ui, languages, getLangFromParam } from '../../data/ui';
import { aboutIntro, aboutVigs, services, stack, stackVigs, stackBanners, path, pathVigs, aboutLabels } from '../../data/about';
import Banners from '../../components/Banners.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const L = aboutLabels[lang];
// (services) : chaque service renvoie aux projets qui le montrent (la section se lit comme un index, pas comme une liste vide)
const SEEN: string[][] = [['music-identities', 'bms-esport'], ['asaphr', 'music-identities'], ['bms-esport', 'sports-aventure'], ['algorithmic-heraldry']];
const P = (slug: string) => projects.find((x) => x.slug === slug);
---
<Base lang={lang} title={t.nav.about} description={aboutIntro[lang].replace(/\{[^}]*\}\s?/g, '')} path="about/" active="about">
  <div class="screens-host" data-screens data-letters-slow>
    <section class="scr" aria-labelledby="ab-1">
      <div class="in g">
        <h1 class="lab mono mu par" id="ab-1">{L.about}</h1>
        <div class="bd intro" data-spec-zone><Affiche text={aboutIntro[lang]} vigs={aboutVigs} lang={lang} /></div>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-2">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-2">{L.services}</h2>
        <ul class="bd svc" data-hola>
          {services[lang].map(([h, d], i) => (
            <li>
              <span class="mono mu n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t56">{h}</h3>
              <p class="mono mu dl">{d.toLowerCase()}</p>
              <p class="mono seen"><span class="mu">{lang === 'fr' ? 'vu dans' : 'seen in'}</span>{SEEN[i].filter(P).map((s) => <a class="lk" href={`/${lang}/work/${s}/`}>{P(s)![lang].title}</a>)}{i === 3 && <a class="lk" href={`/${lang}/lab/`}>Lab</a>}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-st">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-st">{L.stack}</h2>
        <div class="bd"><Affiche text={stack[lang]} vigs={stackVigs} lang={lang} class="stk" /><Banners items={stackBanners} /></div>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-3">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-3">{L.path}</h2>
        <div class="bd"><Affiche text={path[lang]} vigs={pathVigs} lang={lang} /><p class="cvl mono"><a class="lk" href={`/${lang}/cv/`}>{lang === 'fr' ? 'cv complet' : 'full cv'} &gt;_</a></p></div>
      </div>
    </section>

    <ContactScreen lang={lang} id="ab-4" />
  </div>
  {/* au survol du texte d'intro : la lettre survolée ouverte comme dans un éditeur de fontes — contour, nœuds, poignées (le portrait est sur l'accueil, pas de redite) */}
  <div class="spec" data-spec aria-hidden="true">
    <p class="sh mono"><span class="sn"></span><span class="su"></span></p>
    <svg class="sv" width="252" height="262"></svg>
    <p class="sf mono"><span class="sb"></span></p>
  </div>
</Base>

<style>
  /* libellé et texte partagent la même ligne de base : aucune marge posée à l'œil */
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .bd { grid-column: 4 / 12; align-self: first baseline; }
  /* services : un index — numéro, grand mot, ce qu'il contient, et les projets où le voir ; chaque élément tombe sur une colonne du site */
  .svc { display: grid; grid-template-columns: subgrid; row-gap: 22px; }
  .svc > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 4px; align-items: baseline; }
  .svc .n { font-size: 12px; grid-column: 1; grid-row: 1 / 3; }
  .svc h3 { grid-column: 2 / 6; transition: translate .5s var(--out); }
  .svc .dl { grid-column: 2 / 6; font-size: 12px; }
  .svc .seen { grid-column: 6 / -1; grid-row: 1 / 3; align-self: center; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; }
  .svc .seen .mu { width: 100%; }
  /* 07/11 : au survol, le lien passe à l'orange au lieu de glisser */
  .svc .seen .lk { transition: color .2s; }
  @media (hover: hover) { .svc .seen .lk:hover { transform: none; color: var(--ac); } }
  @media (hover: hover) { .svc > li:hover h3 { translate: 10px 0; } }
  .cvl { margin-top: 40px; }
  /* éditeur de glyphe : souris seulement. Entrée sèche, sans rebond (power3.out) */
  .spec { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .spec { display: grid; gap: 6px; position: fixed; left: 0; top: 0; z-index: 60; width: 276px; padding: 10px 12px 10px;
      background: var(--fg); color: var(--bg); pointer-events: none; opacity: 0; scale: .6; transform-origin: 0 0;
      transition: opacity .32s cubic-bezier(.215, .61, .355, 1), scale .42s cubic-bezier(.215, .61, .355, 1); will-change: transform, opacity, scale; }
    .spec.on { opacity: 1; scale: 1; }
    .spec .sh, .spec .sf { display: flex; justify-content: space-between; font-size: 11px; line-height: 14px; text-transform: none; }
    .spec .su { color: var(--ac); }
    .spec .sf { color: #8a8a8a; white-space: pre; }
    .spec svg { display: block; overflow: visible; }
    .spec :global(.mt) { stroke: #3a3a3a; stroke-width: 1; }
    .spec :global(.mt.b) { stroke: #5a5a5a; }
    .spec :global(.ml) { fill: #6f6f6f; font: 9px 'Geist Mono', ui-monospace, monospace; }
    .spec :global(.sbx) { stroke: #3a3a3a; stroke-dasharray: 2 3; }
    .spec :global(.ol) { fill: rgba(243, 243, 243, .07); stroke: var(--bg); stroke-width: 1.2; stroke-linejoin: round; }
    .spec :global(.hd) { stroke: var(--ac); stroke-width: .9; }
    .spec :global(.of) { fill: var(--fg); stroke: var(--ac); stroke-width: 1.2; }
    .spec :global(.on) { fill: var(--fg); stroke: var(--bg); stroke-width: 1.3; }
    .spec :global(.on.st) { fill: var(--ac); stroke: var(--ac); }
    /* dessin : le contour se trace, les nœuds éclosent en cascade, les poignées sortent de leur nœud */
    .spec.draw :global(.ol) { stroke-dasharray: 1; stroke-dashoffset: 1; fill-opacity: 0; animation: bz-trace .55s cubic-bezier(.215, .61, .355, 1) forwards; }
    .spec.draw :global(.pt) { transform-box: fill-box; transform-origin: center; scale: 0; animation: bz-pop .26s cubic-bezier(.215, .61, .355, 1) forwards; animation-delay: var(--d); }
    .spec.draw :global(.hd) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: bz-trace .3s cubic-bezier(.215, .61, .355, 1) forwards; animation-delay: var(--d); }
    @keyframes bz-trace { to { stroke-dashoffset: 0; fill-opacity: 1; } }
    @keyframes bz-pop { to { scale: 1; } }
    /* dans le texte : la lettre survolée passe en contour, comme sélectionnée */
    .intro :global(.bz-sel) { color: transparent; -webkit-text-stroke: 1.2px var(--fg); }
  }
  @media (prefers-reduced-motion: reduce) { .spec.draw :global(*) { animation: none !important; stroke-dashoffset: 0 !important; scale: 1 !important; } }


  @media (max-width: 760px) {
    .lab, .bd { grid-column: 1 / -1; }
    .lab { margin-bottom: 20px; }
    /* services : posés en bas de l'écran comme les autres textes, sur la grille de 4 colonnes — le mot, son numéro à droite, ce qu'il contient juste dessous */
    .svc { row-gap: min(28px, 3.2dvh); }
    .svc > li { row-gap: min(6px, .7dvh); }
    .svc h3 { grid-column: 1 / 4; grid-row: 1; }
    .svc .n { grid-column: 4; grid-row: 1; justify-self: end; }
    .svc .dl { grid-column: 1 / -1; grid-row: 2; }
    .svc .seen { display: none; }
  }
</style>

<script>
  import { reduced } from '../../scripts/motion';
  import GL from '../../data/glyphs-geist.json';
  // fiche de spécimen qui suit la souris au survol du texte d'intro : la lettre sous le pointeur, en grand, dans sa propre fonte,
  // avec son code Unicode. Position amortie, inclinaison selon la vitesse ; entrée et sortie en CSS (échelle et opacité)
  const card = document.querySelector<HTMLElement>('[data-spec]');
  const zone = document.querySelector<HTMLElement>('[data-spec-zone]');
  if (card && zone && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const svg = card.querySelector<SVGSVGElement>('.sv')!, nm = card.querySelector<HTMLElement>('.sn')!, u = card.querySelector<HTMLElement>('.su')!, sb = card.querySelector<HTMLElement>('.sb')!;
    let sel: Element | null = null;
    // contour du glyphe (unités de la fonte -> pixels de la fiche) : lignes de hauteur, approches, contour, poignées, nœuds
    const SW = 252, SH = 262, TOP = 760, BOT = -300;              // de la capitale (marge) à la descendante
    const draw = (ch: string) => {
      const gl = (GL.g as Record<string, { w: number; c: number[][][] }>)[ch];
      if (!gl) return false;
      const k = SH / (TOP - BOT), w = gl.w * k, ox = (SW - w) / 2;
      const X = (v: number) => +(ox + v * k).toFixed(1), Y = (v: number) => +((TOP - v) * k).toFixed(1);
      let xmin = Infinity, xmax = -Infinity;
      let path = '', hd = '', pts = '', i = 0;
      const dly = (n: number) => `--d:${Math.min(360, 160 + n * 7)}ms`;
      for (const c of gl.c) {
        const n = c.length;
        c.forEach((p) => { xmin = Math.min(xmin, p[0]); xmax = Math.max(xmax, p[0]); });
        path += `M${X(c[0][0])} ${Y(c[0][1])}`;
        for (let j = 1; j <= n; j++) {
          const p = c[j % n];
          if (p[2] === 2) { const q = c[(j + 1) % n], r = c[(j + 2) % n]; path += `C${X(p[0])} ${Y(p[1])} ${X(q[0])} ${Y(q[1])} ${X(r[0])} ${Y(r[1])}`; j += 2; }
          else path += `L${X(p[0])} ${Y(p[1])}`;
        }
        path += 'Z';
        // poignées : chaque point hors courbe est relié au nœud voisin auquel il appartient
        c.forEach((p, j) => {
          if (p[2] !== 2) return;
          const a = c[(j - 1 + n) % n][2] !== 2 ? c[(j - 1 + n) % n] : c[(j + 1) % n];
          hd += `<line class="hd" pathLength="1" style="${dly(i)}" x1="${X(a[0])}" y1="${Y(a[1])}" x2="${X(p[0])}" y2="${Y(p[1])}"/>`;
        });
        c.forEach((p, j) => {
          const st = j === 0 ? ' st' : '', s = `style="${dly(i++)}"`;
          pts += p[2] === 2 ? `<circle class="pt of" ${s} cx="${X(p[0])}" cy="${Y(p[1])}" r="2.4"/>`
            : p[2] === 1 ? `<circle class="pt on${st}" ${s} cx="${X(p[0])}" cy="${Y(p[1])}" r="3.2"/>`
            : `<rect class="pt on${st}" ${s} x="${X(p[0]) - 3}" y="${Y(p[1]) - 3}" width="6" height="6"/>`;
        });
      }
      const ln = (v: number, lab: string, b = false) => `<line class="mt${b ? ' b' : ''}" x1="-12" x2="${SW + 12}" y1="${Y(v)}" y2="${Y(v)}"/><text class="ml" x="${SW + 10}" y="${Y(v) - 3}" text-anchor="end">${lab}</text>`;
      svg.innerHTML = ln(GL.cap, `${GL.cap}`) + ln(GL.xh, `${GL.xh}`) + ln(0, '0', true) + ln(GL.desc, `${GL.desc}`)
        + `<line class="sbx" x1="${X(0)}" x2="${X(0)}" y1="0" y2="${SH}"/><line class="sbx" x1="${X(gl.w)}" x2="${X(gl.w)}" y1="0" y2="${SH}"/>`
        + (path ? `<path class="ol" pathLength="1" d="${path}"/>` : '') + hd + pts;
      sb.textContent = gl.c.length ? `L ${Math.round(xmin)}   W ${gl.w}   R ${Math.round(gl.w - xmax)}` : `W ${gl.w}`;
      card.classList.remove('draw'); void card.offsetWidth; card.classList.add('draw'); // relance le dessin à chaque lettre
      return true;
    };
    const still = reduced();
    let tx = 0, ty = 0, x = 0, y = 0, r = 0, on = false, raf = 0, last = '';
    const OFF = 14; // le pointeur se tient au coin supérieur gauche de la fiche, à quelques pixels
    // lettre sous le pointeur : chaque caractère du texte est déjà isolé dans un span (évitement du curseur, apparition) ;
    // sinon, recherche dans les nœuds texte (tolérance d'une demi-hauteur : les lettres s'écartent de la souris).
    // Pas de caretRangeFromPoint : le site est en user-select: none, qui le neutralise.
    const charAt = (px: number, py: number): { ch: string; el: Element } | null => {
      const el = document.elementFromPoint(px, py);
      if (!el || !zone.contains(el) || el.closest('.mono, .vi, .door, img')) return null;
      const t = (el.textContent || '').trim();
      if ([...t].length === 1) return { ch: t, el };
      const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const rg = document.createRange();
      while (w.nextNode()) {
        const n = w.currentNode, v = n.nodeValue || '';
        for (let i = 0; i < v.length; i++) {
          if (/\s/.test(v[i])) continue;
          rg.setStart(n, i); rg.setEnd(n, i + 1);
          const b = rg.getBoundingClientRect(), m = b.height * 0.25;
          if (px >= b.left - m && px <= b.right + m && py >= b.top && py <= b.bottom) return { ch: v[i], el: n.parentElement! };
        }
      }
      return null;
    };
    const show = (px: number, py: number) => {
      const hit = charAt(px, py);
      if (!hit) return;
      const host = hit.el.closest('.hc') || hit.el;               // lettre isolée dans le texte (évitement du curseur)
      if (host !== sel && [...(host.textContent || '')].length === 1) { sel?.classList.remove('bz-sel'); sel = host; sel.classList.add('bz-sel'); }
      if (hit.ch === last || !draw(hit.ch)) return;
      last = hit.ch;
      nm.textContent = hit.ch;
      u.textContent = 'U+' + hit.ch.codePointAt(0)!.toString(16).toUpperCase().padStart(4, '0');
      if (on) dispatchEvent(new CustomEvent('kk:sound', { detail: 'key' })); // une touche à chaque nouvelle lettre
    };
    const tick = () => {
      const k = still ? 1 : 0.16;
      const px = x; x += (tx - x) * k; y += (ty - y) * k;
      const rt = still ? 0 : Math.max(-14, Math.min(14, (x - px) * 0.9));
      r += (rt - r) * 0.12;
      const w = card.offsetWidth, h = card.offsetHeight;
      const left = Math.min(x + OFF, innerWidth - w - 12);
      const top = Math.min(y + OFF, innerHeight - h - 12);
      card.style.transform = `translate3d(${left}px, ${top}px, 0) rotate(${r.toFixed(2)}deg)`;
      const moving = Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3 || Math.abs(r - rt) > 0.05;
      raf = moving ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    // la fiche n'apparaît que sur une lettre (pas dans les blancs ni sur les vignettes)
    const move = (e: PointerEvent) => {
      tx = e.clientX; ty = e.clientY; show(tx, ty);
      if (!on && last && charAt(tx, ty)) {
        if (getComputedStyle(card).opacity === '0') { x = tx; y = ty; } // apparaît sous le pointeur, sans glisser depuis l'ancien endroit
        on = true; card.classList.add('on');
      }
      kick();
    };
    zone.addEventListener('pointerenter', move);
    zone.addEventListener('pointermove', move);
    const hide = () => { on = false; card.classList.remove('on'); sel?.classList.remove('bz-sel'); sel = null; last = ''; kick(); };
    zone.addEventListener('pointerleave', hide);
    addEventListener('blur', hide);
    // changement d'écran (molette) : le texte s'en va, la fiche aussi
    addEventListener('wheel', () => { if (on && !zone.matches(':hover')) hide(); }, { passive: true });
  }
</script>
