---
// À propos : quatre écrans plein cadre, libellé en colonne 1, contenu sur l'axe de la colonne 4.
import Base from '../../layouts/Base.astro';
import Affiche from '../../components/Affiche.astro';
import ContactScreen from '../../components/ContactScreen.astro';
import { ui, languages, getLangFromParam } from '../../data/ui';
import { aboutIntro, aboutVigs, services, stack, stackVigs, stackBanners, path, pathVigs, aboutLabels } from '../../data/about';
import Banners from '../../components/Banners.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const L = aboutLabels[lang];
// (services) : chaque service renvoie aux projets qui le montrent (la section se lit comme un index, pas comme une liste vide)
const SEEN: string[][] = [['music-identities', 'bms-esport'], ['asaphr', 'music-identities'], ['bms-esport', 'sports-aventure'], ['algorithmic-heraldry']];
const P = (slug: string) => projects.find((x) => x.slug === slug);
---
<Base lang={lang} title={t.nav.about} description={aboutIntro[lang].replace(/\{[^}]*\}\s?/g, '')} path="about/" active="about">
  <div class="screens-host free" data-screens data-no-arrow data-letters-slow>
    <section class="scr" aria-labelledby="ab-1">
      <div class="in g">
        <h1 class="lab mono mu par" id="ab-1">{L.about}</h1>
        <div class="bd intro" data-focus-zone><Affiche text={aboutIntro[lang]} vigs={aboutVigs} lang={lang} sentences /></div>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-2">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-2">{L.services}</h2>
        <ul class="bd svc" data-hola>
          {services[lang].map(([h, d], i) => (
            <li>
              <span class="mono mu n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t56">{h}</h3>
              <p class="mono mu dl">{d.toLowerCase()}</p>
              <p class="mono seen"><span class="mu">{lang === 'fr' ? 'vu dans' : 'seen in'}</span>{SEEN[i].filter(P).map((s) => <a class="lk" href={`/${lang}/work/${s}/`}>{P(s)![lang].title}</a>)}{i === 3 && <a class="lk" href={`/${lang}/lab/`}>Lab</a>}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-st">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-st">{L.stack}</h2>
        <div class="bd"><Affiche text={stack[lang]} vigs={stackVigs} lang={lang} class="stk" /><Banners items={stackBanners} /></div>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-3">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-3">{L.path}</h2>
        <div class="bd"><Affiche text={path[lang]} vigs={pathVigs} lang={lang} /><p class="cvl mono"><a class="lk" href={`/${lang}/cv/`}>{lang === 'fr' ? 'cv complet' : 'full cv'} &gt;_</a></p></div>
      </div>
    </section>

    <ContactScreen lang={lang} id="ab-4" />
  </div>
</Base>

<style>
  /* défilement libre : l'introduction garde la hauteur de l'écran, les autres blocs prennent leur hauteur */
  .screens-host > .scr:first-child > .in { min-height: 100svh; padding-block: calc(var(--head) + 24px) 64px; }
  /* libellé et texte partagent la même ligne de base : aucune marge posée à l'œil */
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .bd { grid-column: 4 / 12; align-self: first baseline; }
  /* services : un index — numéro, grand mot, ce qu'il contient, et les projets où le voir ; chaque élément tombe sur une colonne du site */
  .svc { display: grid; grid-template-columns: subgrid; row-gap: 22px; }
  .svc > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 4px; align-items: baseline; }
  .svc .n { font-size: 12px; grid-column: 1; grid-row: 1 / 3; }
  .svc h3 { grid-column: 2 / 6; transition: translate .5s var(--out); }
  .svc .dl { grid-column: 2 / 6; font-size: 12px; }
  .svc .seen { grid-column: 6 / -1; grid-row: 1 / 3; align-self: center; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; }
  .svc .seen .mu { width: 100%; }
  /* 07/11 : au survol, le lien passe à l'orange au lieu de glisser */
  .svc .seen .lk { transition: color .2s; }
  @media (hover: hover) { .svc .seen .lk:hover { transform: none; color: var(--ac); } }
  @media (hover: hover) { .svc > li:hover h3 { translate: 10px 0; } }
  .cvl { margin-top: 40px; }
  /* intro : chaque phrase montre ce qu'elle dit au survol */
  .intro { position: relative; }
  .intro :global(.snt) { transition: color .35s var(--out); }
  .intro[data-on='0'] :global(.snt.on) { color: transparent; -webkit-text-stroke: 1.2px var(--fg); }
  .intro[data-on='0'] :global(.snt.on .note) { color: var(--mu); -webkit-text-stroke: 0; }
  .intro :global(.caret) { position: absolute; width: 4px; background: var(--ac); opacity: 0; pointer-events: none; }
  .intro[data-on='1'] :global(.caret) { opacity: 1; animation: caret 1.06s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .intro :global(.door.ajar .rt) { transform: scaleX(.72); }
  .intro :global(.door.ajar .lf) { transform: scaleX(.94); }
  @media (prefers-reduced-motion: reduce) { .intro[data-on='1'] :global(.caret) { animation: none; } }


  @media (max-width: 760px) {
    .lab, .bd { grid-column: 1 / -1; }
    .lab { margin-bottom: 20px; }
    /* services : posés en bas de l'écran comme les autres textes, sur la grille de 4 colonnes — le mot, son numéro à droite, ce qu'il contient juste dessous */
    .svc { row-gap: min(28px, 3.2dvh); }
    .svc > li { row-gap: min(6px, .7dvh); }
    .svc h3 { grid-column: 1 / 4; grid-row: 1; }
    .svc .n { grid-column: 4; grid-row: 1; justify-self: end; }
    .svc .dl { grid-column: 1 / -1; grid-row: 2; }
    .svc .seen { display: none; }
  }
</style>

<script>
  // intro : au survol, chaque phrase montre ce qu'elle dit, sans rien ajouter ni faire bouger la mise en page (souris seulement)
  // 1re « je pars de la lettre » : elle passe en contour, comme une lettre ouverte dans un éditeur de fontes
  // 2e « j'écris du code » : un curseur de saisie clignote au bout de la phrase
  // 3e « les choses que j'aime » : la porte (vers Ce que j'aime) s'entrouvre
  const zone = document.querySelector<HTMLElement>('[data-focus-zone]');
  if (zone && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const caret = document.createElement('i'); caret.className = 'caret'; caret.setAttribute('aria-hidden', 'true'); zone.appendChild(caret);
    let cur: HTMLElement | null = null;
    const place = (s: HTMLElement) => {
      const rs = [...s.getClientRects()].filter((r) => r.width > 2), r = rs[rs.length - 1], z = zone.getBoundingClientRect();
      if (r) caret.style.cssText = `left:${r.right - z.left + 4}px;top:${r.top - z.top + r.height * 0.14}px;height:${r.height * 0.72}px`;
    };
    const set = (s: HTMLElement | null) => {
      if (s === cur) return;
      cur?.classList.remove('on'); cur = s; cur?.classList.add('on');
      const k = cur?.dataset.s;
      zone.dataset.on = k ?? '';
      if (k === '1' && cur) place(cur);
      zone.querySelector('.door')?.classList.toggle('ajar', k === '2');
    };
    zone.addEventListener('pointermove', (e) => set((e.target as Element).closest?.<HTMLElement>('.snt') ?? cur));
    zone.addEventListener('pointerleave', () => set(null));
  }

  // ---------- défilement libre : blocs écrits en lignes masquées à leur entrée (rembobinés en remontant) ----------
  import { initFlow, enterOnce, maskIn, contactIn } from '../../scripts/flow';
  initFlow();
  enterOnce(document.querySelectorAll<HTMLElement>('.screens-host > .scr:not(:first-child):not(.last) :is(.lab, .svc li, .bd > :not(.fanions):not(.cvl), .cvl)'));
  maskIn(document.querySelectorAll<HTMLElement>('.screens-host > .scr :is(.fanions)'), 30);
  contactIn();
</script>
