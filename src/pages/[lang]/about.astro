---
// À propos : quatre écrans plein cadre, libellé en colonne 1, contenu sur l'axe de la colonne 4.
import Base from '../../layouts/Base.astro';
import Affiche from '../../components/Affiche.astro';
import ContactScreen from '../../components/ContactScreen.astro';
import { ui, languages, getLangFromParam } from '../../data/ui';
import { aboutIntro, aboutVigs, services, stack, stackVigs, stackBanners, path, pathVigs, aboutLabels } from '../../data/about';
import Banners from '../../components/Banners.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const L = aboutLabels[lang];
// (services) : chaque service renvoie aux projets qui le montrent (la section se lit comme un index, pas comme une liste vide)
const SEEN: string[][] = [['music-identities', 'bms-esport'], ['asaphr', 'music-identities'], ['bms-esport', 'sports-aventure'], ['algorithmic-heraldry']];
const P = (slug: string) => projects.find((x) => x.slug === slug);
---
<Base lang={lang} title={t.nav.about} description={aboutIntro[lang].replace(/\{[^}]*\}\s?/g, '')} path="about/" active="about">
  <div class="screens-host" data-screens>
    <section class="scr" aria-labelledby="ab-1">
      <div class="in g">
        <h1 class="lab mono mu par" id="ab-1">{L.about}</h1>
        <div class="bd intro" data-pt-zone><Affiche text={aboutIntro[lang]} vigs={aboutVigs} lang={lang} /></div>
      </div>
    </section>

    {/* écran tactile : le portrait a son propre écran, calé sur la grille ; à la souris, le script le sort d'ici et il suit le pointeur */}
    <section class="scr pts" data-still aria-label={lang === 'fr' ? 'Portrait' : 'Portrait'}>
      <div class="in g">
        <img class="pt" src="/portrait-720.webp" srcset="/portrait-360.webp 360w, /portrait-720.webp 720w" sizes="(max-width: 760px) 100vw, 240px" alt={lang === 'fr' ? 'Portrait de Kern en armure, dans un cadre enluminé' : 'Portrait of Kern in armour, in an illuminated frame'} width="360" height="492" decoding="async" data-pt data-no-ascii />
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-2">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-2">{L.services}</h2>
        <ul class="bd svc" data-hola>
          {services[lang].map(([h, d], i) => (
            <li>
              <span class="mono mu n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t56">{h}</h3>
              <p class="mono mu dl">{d.toLowerCase()}</p>
              <p class="mono seen"><span class="mu">{lang === 'fr' ? 'vu dans' : 'seen in'}</span>{SEEN[i].filter(P).map((s) => <a class="lk" href={`/${lang}/work/${s}/`}>{P(s)![lang].title}</a>)}{i === 3 && <a class="lk" href={`/${lang}/lab/`}>Lab</a>}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-st">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-st">{L.stack}</h2>
        <div class="bd"><Affiche text={stack[lang]} vigs={stackVigs} lang={lang} class="stk" /><Banners items={stackBanners} /></div>
      </div>
    </section>

    <section class="scr" aria-labelledby="ab-3">
      <div class="in g">
        <h2 class="lab mono mu par" id="ab-3">{L.path}</h2>
        <div class="bd"><Affiche text={path[lang]} vigs={pathVigs} lang={lang} /><p class="cvl mono"><a class="lk" href={`/${lang}/cv/`}>{lang === 'fr' ? 'cv complet' : 'full cv'} &gt;_</a></p></div>
      </div>
    </section>

    <ContactScreen lang={lang} id="ab-4" />
  </div>
</Base>

<style>
  /* libellé et texte partagent la même ligne de base : aucune marge posée à l'œil */
  .lab { grid-column: 1 / 4; align-self: first baseline; }
  .bd { grid-column: 4 / 12; align-self: first baseline; }
  /* services : un index — numéro, grand mot, ce qu'il contient, et les projets où le voir ; chaque élément tombe sur une colonne du site */
  .svc { display: grid; grid-template-columns: subgrid; row-gap: 22px; }
  .svc > li { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 4px; align-items: baseline; }
  .svc .n { font-size: 12px; grid-column: 1; grid-row: 1 / 3; }
  .svc h3 { grid-column: 2 / 6; transition: translate .5s var(--out); }
  .svc .dl { grid-column: 2 / 6; font-size: 12px; }
  .svc .seen { grid-column: 6 / -1; grid-row: 1 / 3; align-self: center; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; }
  .svc .seen .mu { width: 100%; }
  /* 07/11 : au survol, le lien passe à l'orange au lieu de glisser */
  .svc .seen .lk { transition: color .2s; }
  @media (hover: hover) { .svc .seen .lk:hover { transform: none; color: var(--ac); } }
  @media (hover: hover) { .svc > li:hover h3 { translate: 10px 0; } }
  .cvl { margin-top: 40px; }
  /* portrait, écran tactile : sur l'axe de la colonne 4, pleine largeur sur téléphone, jamais plus haut que l'écran visible */
  .pt { grid-column: 4 / 10; width: min(100%, calc((100dvh - var(--head) - 88px) * .7317)); height: auto; }
  /* à la souris : il apparaît au survol du texte d'intro et suit le pointeur. Entrée sèche, sans rebond (power3.out) */
  @media (hover: hover) and (pointer: fine) {
    .pts { display: none; }
    .pt { position: fixed; left: 0; top: 0; z-index: 60; width: min(240px, 30dvh); margin: 0; pointer-events: none;
      opacity: 0; scale: .6; transform-origin: 0 0; transition: opacity .32s cubic-bezier(.215, .61, .355, 1), scale .42s cubic-bezier(.215, .61, .355, 1); will-change: transform, opacity, scale; filter: drop-shadow(0 18px 30px rgba(0, 0, 0, .18)); }
    .pt.on { opacity: 1; scale: 1; }
  }


  @media (max-width: 760px) {
    .lab, .bd { grid-column: 1 / -1; }
    .lab { margin-bottom: 20px; }
    .pt { grid-column: 1 / -1; }
    /* services : quatre modules égaux qui remplissent l'écran, sur la grille de 4 colonnes — le mot en haut, son numéro à droite, ce qu'il contient en bas */
    .svc { row-gap: 0; height: calc(100dvh - var(--head) - min(56px, 7dvh) - min(72px, 9dvh)); grid-template-rows: repeat(4, minmax(0, 1fr)); }
    .svc > li { grid-template-rows: auto minmax(0, 1fr); row-gap: 0; border-top: 1px solid var(--ln); padding: min(14px, 1.7dvh) 0; }
    .svc h3 { grid-column: 1 / 4; grid-row: 1; }
    .svc .n { grid-column: 4; grid-row: 1; justify-self: end; }
    .svc .dl { grid-column: 1 / -1; grid-row: 2; align-self: end; }
    .svc .seen { display: none; }
  }
</style>

<script>
  import { reduced } from '../../scripts/motion';
  // portrait qui suit la souris au survol du texte d'intro : position amortie, inclinaison selon la vitesse ;
  // entrée et sortie en CSS (échelle et opacité, sans rebond)
  const pt = document.querySelector<HTMLImageElement>('[data-pt]');
  const zone = document.querySelector<HTMLElement>('[data-pt-zone]');
  if (pt && zone && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.body.appendChild(pt); // hors des écrans (transformés) : position fixe = fenêtre
    const still = reduced();
    let tx = 0, ty = 0, x = 0, y = 0, r = 0, on = false, raf = 0;
    const OFF = 14; // le pointeur se tient au coin supérieur gauche du portrait, à quelques pixels
    const tick = () => {
      const k = still ? 1 : 0.16;
      const px = x; x += (tx - x) * k; y += (ty - y) * k;
      const rt = still ? 0 : Math.max(-14, Math.min(14, (x - px) * 0.9));
      r += (rt - r) * 0.12;
      const w = pt.offsetWidth, h = pt.offsetHeight;
      // coin supérieur gauche au pointeur ; près des bords droit et bas, le portrait se cale pour rester visible
      const left = Math.min(x + OFF, innerWidth - w - 12);
      const top = Math.min(y + OFF, innerHeight - h - 12);
      pt.style.transform = `translate3d(${left}px, ${top}px, 0) rotate(${r.toFixed(2)}deg)`;
      const moving = Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3 || Math.abs(r - rt) > 0.05;
      raf = moving ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    zone.addEventListener('pointerenter', (e) => {
      tx = e.clientX; ty = e.clientY;
      if (!on && getComputedStyle(pt).opacity === '0') { x = tx; y = ty; } // apparaît sous le pointeur, sans glisser depuis l'ancien endroit
      on = true; pt.classList.add('on'); kick();
    });
    zone.addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; kick(); });
    const hide = () => { on = false; pt.classList.remove('on'); kick(); };
    zone.addEventListener('pointerleave', hide);
    addEventListener('blur', hide);
    // changement d'écran (molette) : le texte s'en va, le portrait aussi
    addEventListener('wheel', () => { if (on && !zone.matches(':hover')) hide(); }, { passive: true });
  }
</script>
