---
// Archive. Ordinateur : une pile d'affiches jetées sur la table — chaque cran de molette (pavé, flèches) en jette une
// de plus, à une place et un angle fixes (tirés au sort une fois pour toutes), sur toute la largeur de l'écran ;
// remonter les reprend une à une ; barre de progression cliquable + compteur ;
// Pièce ouverte en grand, adresse propre (#01).
// Téléphone : la même pile, au doigt. Pas de pied de page.
import Base from '../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../data/ui';
import { pieces } from '../../data/archive';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const cap = (i: number) => pieces[i].cat[lang] + (pieces[i].year ? ` (${pieces[i].year})` : ''); // catégorie (année)
// téléphone : le paquet de cartes reprend les angles de la pile d'ordinateur (même tirage), resserrés pour rester dans l'écran ; le décalage vertical revient tous les 6
const rnd = (n: number) => { const v = Math.sin(n * 127.1 + 311.7) * 43758.5453; return v - Math.floor(v); };
const tilt = (i: number) => ((i === 0 ? -2 : (rnd(i + 7) - 0.5) * 18) * 0.4).toFixed(2);
---
<Base lang={lang} title={t.nav.archive} description={lang === 'fr' ? `Archive de kerningkastle, 2020 à 2026 : ${pieces.length} pièces de direction artistique musicale (pochettes), projets concepts, lettrages et logos, en pile à feuilleter.` : `kerningkastle archive, 2020 to 2026: ${pieces.length} pieces of music art direction (covers), concept projects, lettering and logos, in a pile to flip through.`} path="archive/" active="archive">
  <div class="arc pile" data-arc data-own-wheel>
    <section class="band">
      <h1 class="ttl mono mu par">{t.archiveCount} {pad(pieces.length)}</h1>
      <ol class="track" data-track>
        {/* téléphone : repères de calage, fixes (le calage se trompe de cible sur un élément sticky) */}
        {pieces.map((_, i) => <li class="sn" style={`--i:${i}`} aria-hidden="true"></li>)}
        {pieces.map((p, i) => (
          <li class="pc" id={pad(i + 1)} style={`--o:${i % 6};--a:${tilt(i)}deg`}>
            <a href={`#${pad(i + 1)}`} data-open={i} aria-label={cap(i)}>
              <span class="ph im" style={`--r:${p.w / p.h}`}></span>
              <span class="mono mu c">{cap(i)}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="intro t56" aria-hidden="true"><span>{lang === 'fr' ? 'Tout le reste.' : 'Everything else.'}</span></p>
      <div class="pst" data-stage aria-hidden="true"><canvas class="cv-base"></canvas><canvas class="cv-fly"></canvas></div>
      <span class="hint-r mono" data-hint aria-hidden="true"><span>→</span></span>
      <div class="prog" data-prog role="slider" tabindex="0" aria-label={t.archiveCount} aria-valuemin="1" aria-valuemax={pieces.length} aria-valuenow="1">
        <span class="bar" data-bar></span>{/* même texte que le script au départ (ordinateur : 00, aucune pièce ; téléphone : la première) : rien ne bouge à son arrivée */}<em class="mono mu" data-count><span class="c-d">00 / {pad(pieces.length)}</span><span class="c-m">01 / {pad(pieces.length)} — {cap(0)}</span></em>
      </div>
    </section>
  </div>

  {/* données des pièces pour le script (catégories, proportions, images) */}
  <script type="application/json" id="archive-data" set:html={JSON.stringify({ caps: pieces.map((p) => p.cat[lang] + (p.year ? ` (${p.year})` : '')), ratios: pieces.map((p) => p.w / p.h), srcs: pieces.map((p) => p.src) })} />
  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label={t.archiveCount}>
    <button class="x bp bx hit" type="button" data-close>{t.close.toLowerCase()}</button>
    <figure><span class="ph big" data-big></span><figcaption class="mono mu" data-cap></figcaption></figure>
    <button class="arw bp ba" type="button" data-step="-1" aria-label={t.prev}>←</button>
    <button class="arw bp ba" type="button" data-step="1" aria-label={t.nextShort}>→</button>
  </div>
</Base>



<style>
  .arc { position: fixed; inset: 0; overflow: hidden; }
  .band { position: relative; height: 100dvh; }
  .ttl { position: absolute; left: var(--m); top: calc(var(--head) + 16px); }
  .track { position: absolute; left: var(--m); top: calc(var(--head) + 72px); bottom: 96px; display: flex; gap: 40px; align-items: flex-end; will-change: transform; }
  .pc { height: 100%; display: flex; align-items: flex-end; }
  .pc a { display: block; }
  .im { display: block; height: min(560px, calc(100dvh - var(--head) - 200px)); aspect-ratio: var(--r); }
  .im img { width: 100%; height: 100%; object-fit: cover; }
  /* année de création, en bas à droite de l'image */
  .c { display: block; margin-top: 10px; white-space: nowrap; }
  /* flèche discrète : la bande se fait défiler ; disparaît au premier geste */
  .hint-r { position: absolute; right: var(--m); bottom: 26px; width: 44px; height: 44px; display: grid; place-items: center end; color: var(--mu); transition: opacity .3s; pointer-events: none; }
  .hint-r.gone { opacity: 0; }
  .hint-r span { animation: kk-nudge 2.4s var(--out) infinite; }
  @keyframes kk-nudge { 0%, 60%, 100% { transform: none; } 30% { transform: translateX(5px); } }
  @media (max-width: 760px) { .hint-r { display: none; } }
  .prog { position: absolute; left: var(--m); right: var(--m); bottom: 40px; height: 24px; cursor: pointer; }
  .prog::before { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--ln); }
  .bar { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--ac); transform-origin: 0 50%; transform: scaleX(0); }
  .prog em { position: absolute; right: 0; top: -8px; font-style: normal; }
  .prog .c-m { display: none; }
  @media (max-width: 760px) { .prog .c-d { display: none; } .prog .c-m { display: inline; } }

  /* ---------- ordinateur : la pile, dessinée sur deux toiles (dessous figé + affiches en mouvement) ---------- */
  .pst { display: none; }
  /* arrivée (ordinateur) : la phrase au centre de la table, sous la pile ; les affiches jetées la recouvrent */
  .intro { display: none; }
  @media (min-width: 761px) {
    .intro { display: grid; place-items: center; position: absolute; left: 0; right: 0; top: var(--head); bottom: 84px; margin: 0; font-weight: 500; text-align: center; pointer-events: none; }
    .intro .w { display: inline-block; }
  }

  @media all {
    .track { display: none; }
    .pst { display: block; position: absolute; left: 0; right: 0; top: var(--head); bottom: 84px; }
    .pst canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
    .cv-fly { touch-action: none; }
  }

  .lb { position: fixed; inset: 0; z-index: 80; background: var(--bg); display: grid; place-items: center; }
  .lb[hidden] { display: none; }
  .lb figure { display: grid; justify-items: start; gap: 10px; }
  .big { display: block; height: min(72dvh, 720px); max-width: calc(100vw - 2 * var(--m) - 120px); }
  .x { position: absolute; right: var(--m); top: calc(var(--head) + 8px); }
  /* flèches nues : un signe, rien autour */
  .arw { position: absolute; bottom: 32px; padding: 12px 0; }
  [data-step='-1'] { left: var(--m); } [data-step='1'] { right: var(--m); }


  /* téléphone : paquet de cartes — chaque pièce vient se poser sur la précédente (sticky), un geste = exactement une carte */
  @media (max-width: 760px) {
    .pst { display: none; }
    .track { display: block; touch-action: none; left: 0; right: 0; top: calc(var(--head) + 40px); bottom: 72px; overflow-y: auto; scroll-snap-type: y mandatory; overscroll-behavior: contain; scrollbar-width: none; will-change: auto; }
    .track::-webkit-scrollbar { display: none; }
    .sn { position: absolute; left: 0; width: 1px; height: 100%; top: calc(var(--i) * 100%); scroll-snap-align: start; scroll-snap-stop: always; pointer-events: none; }
    .pc { position: sticky; top: calc(var(--o) * 5px); height: 100%; padding-inline: var(--m); align-items: center; }
    .pc a { width: 100%; transform: rotate(var(--a)); }
    .c { display: none; } /* la légende de la carte du dessus est dans le compteur : les légendes ne s'empilent pas */
    .im { height: auto; margin-inline: auto; width: min(calc(100% - 16px), calc((100dvh - var(--head) - 172px) * var(--r))); box-shadow: 0 10px 22px rgba(0, 0, 0, .14); }
    .big { height: auto; width: calc(100vw - 2 * var(--m)); max-width: none; }
    .arw { bottom: 20px; }
  }
</style>

