---
// Archive. Ordinateur : une pile d'affiches jetées sur la table — chaque cran de molette (pavé, flèches) en jette une
// de plus, à une place et un angle fixes (tirés au sort une fois pour toutes), sur toute la largeur de l'écran ;
// remonter les reprend une à une ; barre de progression cliquable + compteur ;
// Pièce ouverte en grand, adresse propre (#01).
// Téléphone : la même pile, au doigt. Pas de pied de page.
import Base from '../../layouts/Base.astro';
import { ui, languages, getLangFromParam, pad } from '../../data/ui';
import { pieces } from '../../data/archive';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
const cap = (i: number) => pieces[i].cat[lang] + (pieces[i].year ? ` (${pieces[i].year})` : ''); // catégorie (année)
---
<Base lang={lang} title={t.nav.archive} description={lang === 'fr' ? `Archive de kerningkastle, 2020 à 2025 : ${pieces.length} pièces de direction artistique musicale (pochettes), projets concepts, lettrages et logos, en pile à feuilleter.` : `kerningkastle archive, 2020 to 2025: ${pieces.length} pieces of music art direction (covers), concept projects, lettering and logos, in a pile to flip through.`} path="archive/" active="archive">
  <div class="arc pile" data-arc data-own-wheel>
    <section class="band">
      <h1 class="ttl mono mu par">{t.archiveCount} {pad(pieces.length)}</h1>
      <ol class="track" data-track>
        {pieces.map((p, i) => (
          <li class="pc" id={pad(i + 1)}>
            <a href={`#${pad(i + 1)}`} data-open={i} aria-label={cap(i)}>
              <span class="ph im" style={`--r:${p.w / p.h}`}></span>
              <span class="mono mu c">{cap(i)}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="edge" aria-hidden="true"></div>
      <div class="pst" data-stage aria-hidden="true"><canvas class="cv-base"></canvas><canvas class="cv-fly"></canvas></div>
      <span class="hint-r mono" data-hint aria-hidden="true"><span>→</span></span>
      <div class="prog" data-prog role="slider" tabindex="0" aria-label={t.archiveCount} aria-valuemin="1" aria-valuemax={pieces.length} aria-valuenow="1">
        <span class="bar" data-bar></span><em class="mono mu" data-count>01 / {pad(pieces.length)}</em>
      </div>
    </section>
  </div>

  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label={t.archiveCount}>
    <button class="x bp bx hit" type="button" data-close>{t.close.toLowerCase()}</button>
    <figure><span class="ph big" data-big></span><figcaption class="mono mu" data-cap></figcaption></figure>
    <button class="arw bp ba" type="button" data-step="-1" aria-label={t.prev}>←</button>
    <button class="arw bp ba" type="button" data-step="1" aria-label={t.nextShort}>→</button>
  </div>
</Base>

<script is:inline define:vars={{ caps: pieces.map((p) => p.cat[lang] + (p.year ? ` (${p.year})` : '')), ratios: pieces.map((p) => p.w / p.h), srcs: pieces.map((p) => p.src) }}>
  window.kkArchive = { caps, ratios, srcs };
</script>
<script>
  const hint = document.querySelector('[data-hint]');
  const gone = () => hint?.classList.add('gone');
  ['wheel', 'keydown', 'pointerdown', 'touchstart'].forEach((e) => addEventListener(e, gone, { once: true, passive: true }));
</script>

<style>
  .arc { position: fixed; inset: 0; overflow: hidden; }
  .band { position: relative; height: 100dvh; }
  .ttl { position: absolute; left: var(--m); top: calc(var(--head) + 16px); }
  .track { position: absolute; left: var(--m); top: calc(var(--head) + 72px); bottom: 96px; display: flex; gap: 40px; align-items: flex-end; will-change: transform; }
  .pc { height: 100%; display: flex; align-items: flex-end; }
  .pc a { display: block; }
  .im { display: block; height: min(560px, calc(100dvh - var(--head) - 200px)); aspect-ratio: var(--r); }
  .im img { width: 100%; height: 100%; object-fit: cover; }
  /* année de création, en bas à droite de l'image */
  .c { display: block; margin-top: 10px; white-space: nowrap; }
  /* flèche discrète : la bande se fait défiler ; disparaît au premier geste */
  .hint-r { position: absolute; right: var(--m); bottom: 26px; width: 44px; height: 44px; display: grid; place-items: center end; color: var(--mu); transition: opacity .3s; pointer-events: none; }
  .hint-r.gone { opacity: 0; }
  .hint-r span { animation: kk-nudge 2.4s var(--out) infinite; }
  @keyframes kk-nudge { 0%, 60%, 100% { transform: none; } 30% { transform: translateX(5px); } }
  @media (max-width: 760px) { .hint-r { display: none; } }
  .edge { position: absolute; top: 0; bottom: 0; right: 0; width: 120px; background: linear-gradient(90deg, rgba(243, 243, 243, 0), var(--bg)); pointer-events: none; }
  .prog { position: absolute; left: var(--m); right: var(--m); bottom: 40px; height: 24px; cursor: pointer; }
  .prog::before { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--ln); }
  .bar { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--ac); transform-origin: 0 50%; transform: scaleX(0); }
  .prog em { position: absolute; right: 0; top: -8px; font-style: normal; }

  /* ---------- ordinateur : la pile, dessinée sur deux toiles (dessous figé + affiches en mouvement) ---------- */
  .pst { display: none; }
  @media all {
    .track { display: none; }
    .edge { display: none; }
    .pst { display: block; position: absolute; left: 0; right: 0; top: var(--head); bottom: 84px; }
    .pst canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
    .cv-fly { touch-action: none; }
  }

  .lb { position: fixed; inset: 0; z-index: 80; background: var(--bg); display: grid; place-items: center; }
  .lb[hidden] { display: none; }
  .lb figure { display: grid; justify-items: start; gap: 10px; }
  .big { display: block; height: min(72dvh, 720px); max-width: calc(100vw - 2 * var(--m) - 120px); }
  .x { position: absolute; right: var(--m); top: calc(var(--head) + 8px); }
  /* flèches nues : un signe, rien autour */
  .arw { position: absolute; bottom: 32px; padding: 12px 0; }
  [data-step='-1'] { left: var(--m); } [data-step='1'] { right: var(--m); }


  /* téléphone (essai) : la même pile, qu'on fait avancer en glissant le doigt vers le haut */
  @media (max-width: 760px) {
    .pst { bottom: 72px; }
    .big { height: auto; width: calc(100vw - 2 * var(--m)); max-width: none; }
    .arw { bottom: 20px; }
  }
</style>

<script>
  import { reduced } from '../../scripts/motion';
  const root = document.querySelector<HTMLElement>('[data-arc]')!;
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const prog = document.querySelector<HTMLElement>('[data-prog]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const items = [...track.querySelectorAll<HTMLElement>('.pc')];
  const desktop = () => true; // la pile vaut aussi sur téléphone (essai du 02/11)
  const phone = () => matchMedia('(max-width: 760px)').matches;
  const P = (n: number) => String(n).padStart(2, '0');
  let x = 0, target = 0, raf = 0;

  // ---------- la pile ----------
  // Dessinée sur deux toiles : la pile posée est peinte une fois sur la toile du dessous (elle ne coûte plus rien,
  // quel que soit le nombre d'affiches) ; seules les affiches en vol, celle qu'on tient ou celle qui s'ouvre
  // sont redessinées à chaque image, sur la toile du dessus.
  const STEP = 120; // un cran de molette = une affiche
  const max = () => (items.length - 1) * STEP;
  const index = () => Math.max(0, Math.min(items.length - 1, Math.floor(target / STEP + 0.001)));
  const rnd = (n: number) => { const v = Math.sin(n * 127.1 + 311.7) * 43758.5453; return v - Math.floor(v); };
  const K = (window as any).kkArchive as { caps: string[]; ratios: number[]; srcs: string[] };
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const base = stage.querySelector<HTMLCanvasElement>('.cv-base')!, fly = stage.querySelector<HTMLCanvasElement>('.cv-fly')!;
  const bx = base.getContext('2d')!, fx = fly.getContext('2d')!;
  type Card = { i: number; x0: number; y0: number; rot: number; dx: number; dy: number; img: HTMLImageElement };
  let order: number[] = []; // affiches posées, de dessous à dessus
  let air: { i: number; t0: number; kind: 'in' | 'out' }[] = [];
  let hold: { i: number; sx: number; sy: number; dx0: number; dy0: number; moved: boolean } | null = null;
  let lifted = -1, dirty = false, W = 0, H = 0, dpr = 1, raf2 = 0, shown = 0;
  const cards: Card[] = items.map((_, i) => {
    const img = new Image(); img.decoding = 'async';
    img.onload = () => { if (order.includes(i)) { dirty = true; go(); } };
    return { i, x0: i === 0 ? .5 : .14 + rnd(i) * .72, y0: i === 0 ? .5 : .32 + rnd(i + 99) * .36, rot: ((i === 0 ? -2 : (rnd(i + 7) - .5) * 18) * Math.PI) / 180, dx: 0, dy: 0, img };
  });
  // vignettes chargées au fil de la pile (celles posées + les 4 suivantes), pas toutes à l'ouverture de la page
  const want = (i: number) => { const c = cards[i]; if (c && !c.img.src && K.srcs[i]) c.img.src = K.srcs[i].replace('/archive/', '/archive/s/'); };
  const size = (i: number) => { const r = K.ratios[i], w = Math.min(Math.min(400, innerHeight * (phone() ? .42 : .52)) * r, innerWidth * (phone() ? .62 : .34)); return [w, w / r]; };
  // sur téléphone, la pile se resserre vers le centre (les affiches y sont plus grandes que l'écran n'est large)
  const pos = (c: Card) => [(phone() ? .5 + (c.x0 - .5) * .45 : c.x0) * W + c.dx, c.y0 * H + c.dy];
  const paint = (g: CanvasRenderingContext2D, c: Card, x: number, y: number, rot: number, s = 1, alpha = 1) => {
    const [w, h] = size(c.i);
    g.save(); g.translate(x, y); g.rotate(rot); g.scale(s, s); g.globalAlpha = alpha;
    g.shadowColor = 'rgba(0,0,0,.14)'; g.shadowBlur = 22; g.shadowOffsetY = 10; g.fillStyle = '#d4d4d4'; g.fillRect(-w / 2, -h / 2, w, h);
    g.shadowColor = 'transparent';
    const im = c.img;
    if (im.complete && im.naturalWidth) {
      const ir = im.naturalWidth / im.naturalHeight, r = w / h; let sw = im.naturalWidth, sh = im.naturalHeight, sx = 0, sy = 0;
      if (ir > r) { sw = sh * r; sx = (im.naturalWidth - sw) / 2; } else { sh = sw / r; sy = (im.naturalHeight - sh) / 2; }
      g.drawImage(im, sx, sy, sw, sh, -w / 2, -h / 2, w, h);
    }
    g.restore();
  };
  const off = (i: number) => i === lifted || hold?.i === i || air.some((a) => a.i === i && a.kind === 'in');
  const bake = () => { bx.setTransform(dpr, 0, 0, dpr, 0, 0); bx.clearRect(0, 0, W, H); for (const i of order) if (!off(i)) { const c = cards[i], [x, y] = pos(c); paint(bx, c, x, y, c.rot); } };
  const fit = () => { const r = stage.getBoundingClientRect(); W = r.width; H = r.height; dpr = Math.min(2, devicePixelRatio || 1); for (const cv of [base, fly]) { cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr); } dirty = true; go(); };
  const go = () => { if (!raf2) raf2 = requestAnimationFrame(tick); };
  const ease = (p: number) => 1 - Math.pow(1 - p, 3);
  function tick(now: number) {
    raf2 = 0;
    if (dirty) { dirty = false; bake(); }
    fx.setTransform(dpr, 0, 0, dpr, 0, 0); fx.clearRect(0, 0, W, H);
    for (const a of [...air]) {
      const c = cards[a.i], [x, y] = pos(c), p = (now - a.t0) / (a.kind === 'in' ? 520 : 420);
      if (p < 0) continue;
      if (p >= 1) {
        air.splice(air.indexOf(a), 1);
        if (a.kind === 'in') {
          // posée : peinte directement sur la pile si rien de déjà posé n'est au-dessus d'elle, sinon la pile est repeinte
          const k = order.indexOf(a.i);
          if (k >= 0 && order.slice(k + 1).every((j) => off(j)) && a.i !== lifted && hold?.i !== a.i) { bx.setTransform(dpr, 0, 0, dpr, 0, 0); paint(bx, c, x, y, c.rot); } else dirty = true;
        }
        continue;
      }
      if (a.kind === 'in') { const e = ease(p), s = rnd(a.i + 3) > .5 ? 1 : -1, r0 = (s * 24 * Math.PI) / 180; paint(fx, c, x + s * 140 * (1 - e), y + innerHeight * .75 * (1 - e), r0 + (c.rot - r0) * e, 1 + .12 * (1 - e)); }
      else { const e = p * p * p, s = rnd(a.i + 3) > .5 ? 1 : -1, r0 = (s * 24 * Math.PI) / 180; paint(fx, c, x + s * 140 * e, y + innerHeight * .75 * e, c.rot + (r0 - c.rot) * e, 1 + .12 * e); } // le même geste à l'envers
    }
    if (hold?.moved) { const c = cards[hold.i], [x, y] = pos(c); paint(fx, c, x, y, c.rot, 1.03); }
    if (air.length || dirty) go();
  }
  const pile = () => {
    if (!desktop()) return;
    const n = index() + 1, now = performance.now();
    for (let i = 0; i < Math.min(items.length, n + 4); i++) want(i);
    if (n > shown) for (let i = shown; i < n; i++) { order = order.filter((o) => o !== i); order.push(i); air = air.filter((a) => a.i !== i); if (!reduced()) air.push({ i, t0: now + (i - shown) * 45, kind: 'in' }); else dirty = true; }
    else for (let i = shown - 1; i >= n; i--) { order = order.filter((o) => o !== i); air = air.filter((a) => a.i !== i); if (!reduced()) air.push({ i, t0: now + (shown - 1 - i) * 30, kind: 'out' }); dirty = true; }
    shown = n; go();
  };
  // quelle affiche est sous le pointeur (la plus haute)
  const hit = (cx: number, cy: number) => {
    const r = stage.getBoundingClientRect(), px = cx - r.left, py = cy - r.top;
    for (let k = order.length - 1; k >= 0; k--) {
      const c = cards[order[k]], [x, y] = pos(c), [w, h] = size(c.i), co = Math.cos(-c.rot), si = Math.sin(-c.rot);
      const lx = (px - x) * co - (py - y) * si, ly = (px - x) * si + (py - y) * co;
      if (Math.abs(lx) <= w / 2 && Math.abs(ly) <= h / 2) return c.i;
    }
    return -1;
  };
  // ---------- glisser-déposer ----------
  fly.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    const i = hit(e.clientX, e.clientY); if (i < 0) return;
    if (e.pointerType === 'touch') { const sx = e.clientX, sy = e.clientY; fly.addEventListener('pointerup', (u) => { if (Math.hypot(u.clientX - sx, u.clientY - sy) < 8) open(i); }, { once: true }); return; }
    fly.setPointerCapture(e.pointerId);
    hold = { i, sx: e.clientX, sy: e.clientY, dx0: cards[i].dx, dy0: cards[i].dy, moved: false };
  });
  fly.addEventListener('pointermove', (e) => {
    if (!hold) { fly.classList.toggle('stage', hit(e.clientX, e.clientY) >= 0); return; }
    const mx = e.clientX - hold.sx, my = e.clientY - hold.sy;
    if (!hold.moved && Math.hypot(mx, my) < 5) return;
    if (!hold.moved) { hold.moved = true; order = order.filter((o) => o !== hold!.i); order.push(hold.i); dirty = true; document.documentElement.classList.add('grabbing'); }
    cards[hold.i].dx = hold.dx0 + mx; cards[hold.i].dy = hold.dy0 + my; go();
  });
  const drop = () => {
    if (!hold) return;
    const h = hold; hold = null;
    document.documentElement.classList.remove('grabbing');
    if (h.moved) { dirty = true; go(); } else open(h.i);
  };
  fly.addEventListener('pointerup', drop);
  fly.addEventListener('pointercancel', drop);
  fly.addEventListener('pointerleave', () => { if (!hold) fly.classList.remove('stage'); });
  if (desktop()) fit();
  addEventListener('resize', () => { if (desktop()) fit(); });

  let lastK = 0;
  const render = () => {
    const m = max(); bar.style.transform = `scaleX(${m ? x / m : 1})`;
    const k = index() + 1;
    if (k !== lastK) { lastK = k; count.textContent = `${P(k)} / ${P(items.length)} — ${(window as any).kkArchive.caps[k - 1]}`; prog.setAttribute('aria-valuenow', String(k)); pile(); }
  };
  const loop = () => {
    const ease = reduced() ? 1 : 0.14;
    x += (target - x) * ease;
    if (Math.abs(target - x) < 0.5) x = target;
    render();
    raf = x !== target ? requestAnimationFrame(loop) : 0;
  };
  const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
  const seek = (v: number) => { target = Math.max(0, Math.min(max(), v)); kick(); };

  // molette : avance la bande
  addEventListener('wheel', (e) => {
    if (!desktop() || document.querySelector('[data-lb]:not([hidden])')) return;
    const d = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
    seek(target + d);
  }, { passive: true });
  addEventListener('keydown', (e) => {
    if (!desktop() || document.querySelector('[data-lb]:not([hidden])')) return;
    const step = STEP;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === 'PageDown') { e.preventDefault(); seek(target + step); }
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') { e.preventDefault(); seek(target - step); }
    if (e.key === 'Home') seek(0);
    if (e.key === 'End') seek(max());
  });
  // pavé tactile / doigt horizontal sur ordinateur tactile
  let tx = 0;
  // doigt : glisser vers le haut jette des affiches, vers le bas les reprend
  let ty = 0;
  root.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
  root.addEventListener('touchmove', (e) => {
    if (document.querySelector('[data-lb]:not([hidden])')) return;
    const ny = e.touches[0].clientY, d = (ty - ny) * 1.6; ty = ny;
    seek(target + d);
  }, { passive: true });
  prog.addEventListener('click', (e) => { const r = prog.getBoundingClientRect(); seek(((e.clientX - r.left) / r.width) * max()); });
  addEventListener('resize', () => { seek(target); render(); });

  // pièce ouverte
  const A = (window as any).kkArchive as { caps: string[]; ratios: number[]; srcs: string[] };
  const lb = document.querySelector<HTMLElement>('[data-lb]')!;
  const big = lb.querySelector<HTMLElement>('[data-big]')!;
  const cap = lb.querySelector<HTMLElement>('[data-cap]')!;
  let cur = -1, opener: HTMLElement | null = null;
  const show = (i: number, push = true) => {
    cur = (i + A.caps.length) % A.caps.length;
    big.style.aspectRatio = String(A.ratios[cur]);
    // l'image réduite (déjà chargée) s'affiche tout de suite, la grande prend le relais
    const small = A.srcs[cur] ? A.srcs[cur].replace('/archive/', '/archive/s/') : '';
    big.style.background = '#d4d4d4';
    big.innerHTML = '';
    if (A.srcs[cur]) {
      const k = cur, im = document.createElement('img');
      im.alt = A.caps[cur]; im.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
      im.src = cards[cur]?.img.complete ? cards[cur].img.src : small;
      big.appendChild(im);
      const hi = new Image(); hi.src = A.srcs[cur];
      hi.decode().then(() => { if (cur === k) im.src = hi.src; }).catch(() => {});
    }
    cap.textContent = `${P(cur + 1)} — ${A.caps[cur]}`;
    lb.hidden = false;
    if (push) history.replaceState(null, '', `#${P(cur + 1)}`);
    lb.querySelector<HTMLElement>('[data-close]')!.focus({ preventScroll: true });
  };
  // l'affiche posée sur la table, en coordonnées d'écran
  const cardAt = (i: number) => {
    if (!desktop() || !order.includes(i)) return null;
    const c = cards[i], [x, y] = pos(c), r = stage.getBoundingClientRect(), [w] = size(i);
    return { x: r.left + x, y: r.top + y, w, rot: c.rot };
  };
  const OUT = 'cubic-bezier(.2,.75,.25,1)';
  const fromCard = (i: number) => { const c = cardAt(i), b = big.getBoundingClientRect(); return c ? `translate(${c.x - (b.left + b.width / 2)}px, ${c.y - (b.top + b.height / 2)}px) rotate(${c.rot}rad) scale(${c.w / b.width})` : 'translateY(24px) scale(.94)'; };
  const chrome = () => [...lb.querySelectorAll<HTMLElement>('figcaption, .x, .arw')];
  const open = (i: number) => {
    show(i);
    if (reduced()) return;
    const t = fromCard(cur);
    if (cardAt(cur)) { lifted = cur; bake(); }
    big.animate([{ transform: t }, { transform: 'none' }], { duration: 620, easing: OUT });
    lb.animate([{ backgroundColor: 'rgba(243,243,243,0)' }, { backgroundColor: 'rgba(243,243,243,1)' }], { duration: 420, easing: 'ease-out' });
    chrome().forEach((el) => el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 380, fill: 'backwards' }));
  };
  const close = () => {
    const done = () => { lifted = -1; if (desktop()) bake(); lb.hidden = true; cur = -1; history.replaceState(null, '', location.pathname); opener?.focus(); };
    if (reduced() || lb.hidden) { done(); return; }
    const t = fromCard(cur), back = !!cardAt(cur);
    chrome().forEach((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, fill: 'forwards' }));
    lb.animate([{ backgroundColor: 'rgba(243,243,243,1)' }, { backgroundColor: 'rgba(243,243,243,0)' }], { duration: 480, easing: 'ease-in', fill: 'forwards' });
    big.animate([{ transform: 'none', opacity: 1 }, { transform: t, opacity: back ? 1 : 0 }], { duration: 520, easing: 'cubic-bezier(.6,0,.3,1)', fill: 'forwards' }).onfinish = () => {
      done(); lb.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    };
  };
  track.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLElement>('[data-open]');
    if (!a) return;
    e.preventDefault(); opener = a; show(Number(a.dataset.open));
  });
  lb.addEventListener('click', (e) => {
    const el = e.target as Element;
    if (el.closest('[data-close]') || el === lb) close();
    const s = el.closest<HTMLElement>('[data-step]'); if (s) { lifted = -1; dirty = true; go(); show(cur + Number(s.dataset.step)); if (cardAt(cur)) { lifted = cur; } }
  });
  addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { lifted = -1; show(cur + (e.key === 'ArrowRight' ? 1 : -1)); if (cardAt(cur)) lifted = cur; dirty = true; go(); }
  });
  const h = Number(location.hash.slice(1));
  if (h >= 1 && h <= A.caps.length) show(h - 1, false);
  render();
</script>
