---
// Accueil : trois écrans plein cadre (défilement forcé).
import Base from '../../layouts/Base.astro';
import ContactScreen from '../../components/ContactScreen.astro';
import Affiche from '../../components/Affiche.astro';
import ProjectStage from '../../components/ProjectStage.astro';
import Portrait3D from '../../components/Portrait3D.astro';
import { ui, languages, getLangFromParam } from '../../data/ui';
import { homeServices, homeVigs } from '../../data/about';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
---
<Base lang={lang} title="kerningkastle" description={`${t.phrase}. ${homeServices[lang].replace(/\{[^}]*\}\s?/g, '')}`} path="">
  <div class="screens-host" data-screens>
    <section class="scr s1" aria-label="kerningkastle">
      <div class="hero g">
        <div class="nw"><h1 class="name" id="name" aria-label="kerningkastle" data-hola="0.1 0.035 200" data-par="140"><span aria-hidden="true">kern</span><span class="l2" aria-hidden="true"><span>—ing</span><span>kast</span></span><span aria-hidden="true" data-le>le</span><span class="sr mono">kerningkastle</span></h1></div>
      </div>
      <Portrait3D lang={lang} id="pt3d" />
      <p class="bub" id="bub" aria-live="polite"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="msg"></span></p>
      <a class="phrase t28" href={`/${lang}/work/`} data-go="2" data-par="60" set:html={t.phrase.replace(' + ', ' <span class="ac">+</span> ')} />
    </section>

    <section class="scr" id="services" aria-labelledby="sv-l">
      <div class="in g">
        <div class="big">
          <h2 class="mono mu lab par" id="sv-l">{t.services}</h2>
          <div class="bt"><Affiche text={homeServices[lang]} vigs={homeVigs} lang={lang} /></div>
          <p class="more"><a class="bp hit" href={`/${lang}/about/`}>{t.more.toLowerCase()}</a></p>
        </div>
      </div>
    </section>

    <section class="scr s3" id="work" data-still aria-labelledby="pj-l">
      <ProjectStage lang={lang} title={t.work} id="pj-l" heading="h2" />
    </section>

    <ContactScreen lang={lang} id="ct-l" />
  </div>
</Base>

<style>
  /* le nom coupé sur trois lignes, la ligne du milieu remplit la largeur, la dernière déborde en bas */
  .s1 { overflow: hidden; }
  .hero { padding-top: calc(var(--head) + 9vh); } /* recalculé par le script : le « e » coupé au tiers bas */
  .nw { grid-column: 1 / -1; }
  .name { width: max-content; font-weight: 500; letter-spacing: -0.055em; line-height: .76; white-space: nowrap; font-size: 18vw; margin-left: -.04em; }
  .name > span { display: block; }
  .name > span:nth-child(2) { margin-left: -.06em; }
  .name .l2 > span { display: inline; }
  /* la phrase sur la même ligne que la flèche de défilement (centrée sur elle), juste à sa gauche */
  .phrase { position: absolute; right: calc(var(--m) + var(--col) + var(--gut)); bottom: 30px; text-align: right; } /* finit sur le bord droit de la colonne 11 ; la flèche occupe la 12 */
  /* la phrase mène aux projets (14/11) : soulignée en orange au survol */
  .phrase { text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 5px; transition: text-decoration-color .3s var(--out); }
  @media (hover: hover) { .phrase:hover { text-decoration-color: var(--ac); } }

  .big { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; }
  .lab { grid-column: 1 / 4; margin-bottom: 24px; align-self: start; }
  .bt, .more { grid-column: 4 / 12; }
  .more { margin-top: 32px; }


  /* portrait : en haut à droite, à cheval sur « kast » (position et taille calculées par le script, d'après le nom) */
  .s1 :global(.p3d) { z-index: 3; left: 0; top: 0; width: 28vw; }
  /* bulle de message : le chevalier écrit (trois points), puis son message arrive ; orange du site, texte blanc en Medium (choix assumé : contraste 2,4:1, phrases courtes), sur une ligne, queue vers lui */
  .bub { position: absolute; z-index: 4; left: 0; top: 0; white-space: nowrap; padding: 10px 15px 11px; border-radius: 21px; text-wrap: balance; background: var(--ac); color: #fff; font-weight: 500;
    font-size: 18px; line-height: 23px; letter-spacing: -.01em; pointer-events: none; opacity: 0; scale: .5; transform-origin: 100% 100%;
    transition: opacity .18s var(--out), scale .32s cubic-bezier(.34, 1.5, .6, 1), width .25s var(--out); }
  .bub::after { content: ''; position: absolute; right: -6px; bottom: 0; width: 18px; height: 16px; background: inherit;
    clip-path: path('M0 0 C 2 9, 8 14, 18 16 C 10 16, 4 14, 0 11 Z'); }
  .bub.on { opacity: 1; scale: 1; }
  .bub .dots { display: none; gap: 4px; padding: 6px 2px; }
  .bub.typing .dots { display: inline-flex; } .bub.typing .msg { display: none; }
  .bub .dots i { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: kk-dot 1.2s ease-in-out infinite; }
  .bub .dots i:nth-child(2) { animation-delay: .15s; } .bub .dots i:nth-child(3) { animation-delay: .3s; }
  @keyframes kk-dot { 0%, 60%, 100% { opacity: .35; translate: 0 0; } 30% { opacity: 1; translate: 0 -3px; } }
  /* nuit : la bulle reste orange, texte blanc */
  @media (hover: none), (max-width: 760px) { .bub { display: none; } }
  /* titre qui joue : la lettre survolée se remélange ; le signe tiré au hasard se pose par-dessus (la lettre devient
     transparente sans bouger), la mise en page ne change jamais */
  .name :global(.hc.sx) { color: transparent; }
  .name :global(.hc.sx)::after { content: attr(data-s); position: absolute; left: 50%; top: 0; translate: -50% 0; color: var(--fg); }
  :global(html.js) .s1:not(.placed) .nw, :global(html.js) .s1:not(.placed) .phrase, :global(html.js) .s1:not(.placed) :global(.p3d) { visibility: hidden; }
  @media (max-width: 760px) {
    .hero { padding-top: calc(var(--head) + 6vh); }
    /* téléphone : quatre lignes (kern / —ing / kast / le), le nom remplit l'écran */
    .name .l2 > span { display: block; }
    .name .l2 > span + span { margin-left: .06em; }
    .phrase { left: var(--m); text-align: left; bottom: 72px; } /* à gauche du portrait */
    .lab, .bt, .more { grid-column: 1 / -1; }
  }
</style>

