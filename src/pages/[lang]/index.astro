---
// Accueil : trois écrans plein cadre (défilement forcé).
import Base from '../../layouts/Base.astro';
import ContactScreen from '../../components/ContactScreen.astro';
import Affiche from '../../components/Affiche.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import { ui, languages, getLangFromParam, pad } from '../../data/ui';
import { projects } from '../../data/projects';
import { homeServices, homeVigs } from '../../data/about';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = getLangFromParam(Astro.params.lang);
const t = ui[lang];
---
<Base lang={lang} title="kerningkastle" description={`${t.phrase}. ${homeServices[lang].replace(/\{[^}]*\}\s?/g, '')}`} path="">
  <div class="screens-host" data-screens>
    <section class="scr s1" aria-label="kerningkastle">
      <div class="hero g">
        <div class="nw"><h1 class="name" id="name" aria-label="kerningkastle" data-hola="0.1 0.035 200" data-par="140"><span aria-hidden="true">kern</span><span class="l2" aria-hidden="true"><span>—ing</span><span>kast</span></span><span aria-hidden="true">le</span></h1></div>
      </div>
      <p class="phrase t28" data-par="60">{t.phrase}</p>
    </section>

    <section class="scr" id="services" aria-labelledby="sv-l">
      <div class="in g">
        <div class="big">
          <h2 class="mono mu lab par" id="sv-l">{t.services}</h2>
          <div class="bt"><Affiche text={homeServices[lang]} vigs={homeVigs} lang={lang} /></div>
          <p class="more mono"><a class="lk hit" href={`/${lang}/about/`}>{t.more} <span class="plus">+</span></a></p>
        </div>
      </div>
    </section>

    <section class="scr s3" id="work" aria-labelledby="pj-l">
      <div class="in g">
        <div class="pj">
          <h2 class="mono mu lab par" id="pj-l">{t.work} {pad(projects.length)}</h2>
          <div class="list"><ProjectRows lang={lang} /></div>
        </div>
      </div>
    </section>

    <ContactScreen lang={lang} id="ct-l" />
  </div>
</Base>

<style>
  /* le nom coupé sur trois lignes, la ligne du milieu remplit la largeur, la dernière déborde en bas */
  .s1 { overflow: hidden; }
  .hero { padding-top: calc(var(--head) + 9vh); } /* recalculé par le script : le « e » coupé au tiers bas */
  .nw { grid-column: 1 / -1; }
  .name { width: max-content; font-weight: 500; letter-spacing: -0.055em; line-height: .76; white-space: nowrap; font-size: 18vw; margin-left: -.04em; }
  .name > span { display: block; }
  .name > span:nth-child(2) { margin-left: -.06em; }
  .name .l2 > span { display: inline; }
  /* la phrase sur la même ligne que la flèche de défilement (centrée sur elle), juste à sa gauche */
  .phrase { position: absolute; right: calc(var(--m) + 30px); bottom: 30px; text-align: right; }

  .big, .pj { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; }
  .lab { grid-column: 1 / 4; margin-bottom: 24px; align-self: start; }
  .bt, .more { grid-column: 4 / 12; }
  .more { margin-top: 32px; }
  .list { grid-column: 4 / 13; }


  @media (max-width: 760px) {
    .hero { padding-top: calc(var(--head) + 6vh); }
    /* téléphone : quatre lignes (kern / —ing / kast / le), le nom remplit l'écran */
    .name .l2 > span { display: block; }
    .name .l2 > span + span { margin-left: .06em; }
    .phrase { left: var(--m); text-align: left; bottom: 72px; }
    .lab, .bt, .more, .list { grid-column: 1 / -1; }
  }
</style>

<script>
  // Le nom remplit la largeur (ligne du milieu), puis on le cale verticalement pour que le bas de l'écran
  // coupe « le » au premier tiers bas de l'œil du e : on reconnaît la lettre, la coupe reste franche.
    const n = document.getElementById('name')!, hero = n.closest<HTMLElement>('.hero')!, s1 = n.closest<HTMLElement>('.scr')!;
  const place = (k = 1) => {
    const W = n.parentElement!.clientWidth;
    n.style.fontSize = '100px';
    const w = n.getBoundingClientRect().width;
    const fs = Math.floor(((100 * W) / w) * 100 * k) / 100;
    n.style.fontSize = `${fs}px`;
    // ligne de base de « le » et hauteur d'x de la fonte, mesurées
    const last = n.lastElementChild as HTMLElement;
    const probe = document.createElement('i'); probe.style.cssText = 'display:inline-block;width:0;height:0;vertical-align:baseline';
    last.appendChild(probe);
    const ctx = document.createElement('canvas').getContext('2d')!;
    ctx.font = `500 ${fs}px Geist`;
    const xh = ctx.measureText('x').actualBoundingBoxAscent;
    hero.style.paddingTop = '0px';
    const base = probe.getBoundingClientRect().top - s1.getBoundingClientRect().top + s1.scrollTop;
    probe.remove();
    const H = s1.clientHeight;
    const head = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--head')) || 56;
    // bas de l'écran = ligne de base − tiers de la hauteur d'x ; jamais sous le menu
    const ph = document.querySelector<HTMLElement>('.s1 .phrase')!;
    // téléphone : le nom occupe toute la largeur jusqu'en bas, la phrase se place toujours au-dessus de lui ;
    // sur un écran court, le nom descend un peu plus (le « le » est coupé plus bas) plutôt que de passer sous la phrase
    const phone = matchMedia('(max-width: 760px)').matches;
    const min = head + 8 + (phone ? ph.offsetHeight + 36 : 0), need = base - xh / 3;
    // écran trop court pour le nom entier sous la phrase : on réduit le nom (une fois) au lieu de le couper davantage
    if (phone && k === 1 && H - need < min) return place(Math.max(0.6, (H - min) / need));
    const pad = Math.max(min, H - need);
    hero.style.paddingTop = `${pad}px`;
    if (phone || pad - head > ph.offsetHeight + 140) { ph.style.top = `${Math.round(pad - ph.offsetHeight - 24)}px`; ph.style.bottom = 'auto'; }
    else { ph.style.top = ''; ph.style.bottom = ''; }
  };
  document.fonts.ready.then(() => place());
  addEventListener('resize', () => place());
</script>
