---
// Racine : langue mémorisée, sinon langue du navigateur (français → /fr/, sinon /en/).
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>kerningkastle — Type designer + digital creative</title>
    <meta name="description" content="kerningkastle, type designer et créatif digital à Paris : dessin de caractères, identités, génératif et web. Type designer and digital creative based in Paris." />
    <link rel="canonical" href="https://kerningkastle.com/en/" />
    <link rel="alternate" hreflang="fr" href="https://kerningkastle.com/fr/" />
    <link rel="alternate" hreflang="en" href="https://kerningkastle.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://kerningkastle.com/en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (function () {
        var l = null;
        try { l = localStorage.getItem('kk-lang'); } catch (e) {}
        if (l !== 'fr' && l !== 'en') {
          var langs = navigator.languages || [navigator.language || 'en'];
          l = /^fr\b/i.test(langs[0] || '') ? 'fr' : 'en';
        }
        location.replace(location.pathname.replace(/\/?$/, '/') + l + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body>
    <p class="mono" style="padding: 40px"><a href="/en/">English</a> · <a href="/fr/" lang="fr">Français</a></p>
  </body>
</html>
