---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — kerningkastle</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main class="nf g">
      <a class="home" href="/" aria-label="kerningkastle"><img src="/logo-icon-128.webp" alt="" width="22" height="22" /></a>
      <p class="mono mu k">404</p>
      <div class="v">
        <p class="t28">This page does not exist.</p>
        <p class="t28 mu" lang="fr">Cette page n'existe pas.</p>
        <p class="links"><a class="bp" href="/en/">home</a><a class="bp" href="/fr/" lang="fr">accueil</a></p>
      </div>
      <!-- ticket à gratter : sous la couche, la pièce kerningkastle -->
      <div class="tk" data-tk>
        <img src="/logo-coin.webp" alt="kerningkastle coin" width="440" height="421" />
        <canvas aria-hidden="true"></canvas>
        <p class="mono win" data-win><span>(gagné : rien, mais bien joué)</span><span class="mu">(you won: nothing, but well played)</span></p>
      </div>
    </main>
  </body>
<script>
  // Ticket à gratter : une couche grise marquée « 404 » couvre la pièce ; passé la moitié grattée, elle tombe d'elle-même
  {
    const tk = document.querySelector<HTMLElement>('[data-tk]')!, c = tk.querySelector('canvas')!, x = c.getContext('2d')!;
    let done = false, n = 0;
    const cover = () => {
      const d = Math.min(2, devicePixelRatio || 1), w = tk.clientWidth, h = tk.clientHeight;
      c.width = w * d; c.height = h * d; x.setTransform(d, 0, 0, d, 0, 0);
      x.globalCompositeOperation = 'source-over'; x.fillStyle = '#c9c9c9'; x.fillRect(0, 0, w, h);
      x.fillStyle = '#b3b3b3'; x.font = `500 ${w * .42}px Geist, sans-serif`; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText('404', w / 2, h * .47);
      x.fillStyle = '#8f8f8f'; x.font = '400 11px "Geist Mono", monospace'; x.fillText('grattez · scratch', w / 2, h - 16);
    };
    const cleared = () => { const a = x.getImageData(0, 0, c.width, c.height).data; let z = 0; for (let i = 3; i < a.length; i += 64) if (a[i] < 40) z++; return z / (a.length / 64); };
    let lx = -1, ly = -1, down = false;
    const scratch = (e: PointerEvent) => {
      if (done || (e.pointerType !== 'mouse' && !down)) return;
      const b = c.getBoundingClientRect(), px = e.clientX - b.left, py = e.clientY - b.top;
      x.globalCompositeOperation = 'destination-out'; x.lineCap = 'round'; x.lineWidth = 34;
      x.beginPath(); x.moveTo(lx < 0 ? px : lx, ly < 0 ? py : ly); x.lineTo(px + .1, py); x.stroke();
      lx = px; ly = py;
      if (++n % 12 === 0 && cleared() > .5) { done = true; c.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 500, fill: 'forwards' }); tk.classList.add('won'); }
    };
    c.addEventListener('pointerdown', (e) => { down = true; lx = ly = -1; c.setPointerCapture(e.pointerId); scratch(e); });
    c.addEventListener('pointermove', scratch);
    c.addEventListener('pointerup', () => { down = false; lx = ly = -1; });
    c.addEventListener('pointerleave', () => { lx = ly = -1; });
    document.fonts.ready.then(cover);
  }
</script>
</html>

<style>
  .nf { min-height: 100dvh; align-content: center; position: relative; }
  .home { position: absolute; left: var(--m); top: 17px; }
  .k { grid-column: 1 / 4; padding-top: 10px; }
  .tk { grid-column: 4 / 8; position: relative; width: min(260px, 100%); aspect-ratio: 1; margin-bottom: 40px; display: grid; place-items: center; }
  .tk img { width: 74%; height: auto; }
  .tk canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; touch-action: none; cursor: crosshair; }
  .win { position: absolute; left: 0; top: calc(100% + 10px); display: grid; gap: 2px; opacity: 0; transition: opacity .4s .3s; text-transform: none; }
  .tk.won .win { opacity: 1; }
  .tk.won img { animation: kk-coin 1.2s cubic-bezier(.2, .7, .2, 1); }
  @keyframes kk-coin { from { transform: rotateY(540deg) scale(.9); } }
  @media (prefers-reduced-motion: reduce) { .tk.won img { animation: none; } }
  .v { grid-column: 4 / 12; }
  .links { display: flex; gap: 32px; margin-top: 32px; }
  .nf { align-content: center; row-gap: 48px; }
  @media (max-width: 760px) { .k, .v, .tk { grid-column: 1 / -1; } .k { margin-bottom: 16px; } }
</style>
