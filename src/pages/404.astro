---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — kerningkastle</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main class="nf g">
      <a class="home" href="/" aria-label="kerningkastle"><img src="/logo-kerningkastle-dark.svg" alt="" width="22" height="22" /></a>
      <p class="mono mu k">404</p>
      <div class="v">
        <p class="t28">This page does not exist.</p>
        <p class="t28 mu" lang="fr">Cette page n'existe pas.</p>
        <p class="links"><a class="bp" href="/en/">home</a><a class="bp" href="/fr/" lang="fr">accueil</a></p>
      </div>
    </main>
  </body>
</html>

<style>
  .nf { min-height: 100dvh; align-content: center; position: relative; }
  .home { position: absolute; left: var(--m); top: 17px; }
  .k { grid-column: 1 / 4; padding-top: 10px; }
  .v { grid-column: 4 / 12; }
  .links { display: flex; gap: 32px; margin-top: 32px; }
  @media (max-width: 760px) { .k, .v { grid-column: 1 / -1; } .k { margin-bottom: 16px; } }
</style>
