---
// Scène d'objets (ordinateur) : des objets en lévitation — composition libre, dérive lente, réaction à la souris,
// glisser-déposer ; ils tombent un à un quand la scène apparaît (scripts/views/stage.ts). Chaque objet est un lien.
// Composant de la scène Projets (ProjectStage.astro : page Projets et accueil).
// Téléphone : masquée (la page montre une liste à la place).
import ObjectShape, { type ObjectKind } from './ObjectShape.astro';
import { pad } from '../data/ui';
import { aspect } from '../data/objects';
export type SceneItem = { href: string; title: string; object: ObjectKind; wip?: string }; // wip : mention « en travaux »
// centre de l'objet en % de la scène, taille (côté du carré de même surface, en % de la largeur), rotation, profondeur
// (parallaxe) ; la largeur réelle suit les proportions de l'objet, pour qu'un objet haut ne paraisse pas plus gros qu'un large
interface Props { items: SceneItem[]; pos: number[][] }
const { items, pos } = Astro.props;
---
<div class="stage" data-scene>
  <ol class="objs">
    {items.map((it, i) => {
      const [x, y, s, r, z] = pos[i], w = s * Math.sqrt(aspect(it.object));
      return (
        <li class="obj" style={`--x:${x}%;--y:${y}%;--w:${w.toFixed(2)};--r:${r}deg;--d:${7 + i * 1.3}s`} data-depth={z}>
          <a href={it.href}>
            <span class="float"><ObjectShape kind={it.object} /></span>
            <span class="lb"><span class="ac mono">({pad(i + 1)})</span> {it.title}{it.wip && <span class="wip">{it.wip}</span>}</span>
          </a>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .stage { position: relative; flex: 1; min-height: 560px; }
  /* largeur : --w unités d'1 % de la largeur de l'écran, plafonnées par sa hauteur (1,6 % : écran 16/10) ; sur un écran plus bas
     ou plus large, les objets rapetissent au lieu de déborder sur les libellés */
  .obj { position: absolute; left: var(--x); top: var(--y); width: calc(var(--w) * min(1vw, 1.6dvh)); transform: translate(-50%, -50%); touch-action: none; }
  .obj a { display: flex; flex-direction: column; align-items: center; gap: 14px; cursor: grab; -webkit-user-drag: none; user-select: none; }
  .obj.drag a { cursor: grabbing; }
  .obj .float { display: block; width: 100%; will-change: transform; }
  .obj :global(.shape) { width: 100%; height: auto; transform: rotate(var(--r)); filter: drop-shadow(0 var(--sh, 26px) 22px rgba(0, 0, 0, .22)); pointer-events: none; }
  .obj .lb .wip { margin-left: 10px; }
  .obj .lb { white-space: nowrap; transition: transform .35s var(--out), opacity .6s var(--out); transition-delay: var(--ld, 0s); }
  @media (hover: hover) { .obj a:hover .lb { transform: translateX(6px); } }
  /* apparition : les libellés arrivent après leur objet ; survol : les autres objets s'effacent */
  :global(html.js) .stage:not(.in) .obj .lb { opacity: 0; transform: translateY(10px); }
  /* avant leur chute (stage.ts) : objets cachés dès le premier affichage */
  :global(html.js) .stage:not(.in) .obj .float { opacity: 0; }
  .obj .float { transition: opacity .45s var(--out); }
  .stage:global(.focus) .obj:not(:global(.hov)) .float { opacity: .65; }
  .stage:global(.focus) .obj:not(:global(.hov)) .lb { opacity: .65; }
  /* voyage vers l'étude : tout s'efface sauf l'objet choisi */
  .stage:global(.leaving) .obj:not(:global(.chosen)), .stage:global(.leaving) .obj .lb { opacity: 0 !important; transition: opacity .28s var(--out); }
  @media (max-width: 760px) { .stage { display: none; } }
</style>
