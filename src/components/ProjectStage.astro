---
// Scène des projets (14/11 : commune à la page Projets et à l'accueil). Ordinateur : les objets des projets en lévitation
// (composition libre, dérive lente, réaction à la souris, glisser-déposer ; un clic sans déplacement ouvre l'étude).
// Téléphone : la liste classique des projets à la place. Les objets tombent un à un quand la scène apparaît à l'écran.
import Scene from './Scene.astro';
import ProjectRows from './ProjectRows.astro';
import { pad, ui, type Lang } from '../data/ui';
import { projects } from '../data/projects';
interface Props { lang: Lang; title: string; id?: string; heading?: 'h1' | 'h2' }
const { lang, title, id = 'pj-t', heading = 'h1' } = Astro.props;
const H = heading;
// centre de l'objet en % de la scène, taille en % de la largeur, rotation, profondeur (parallaxe)
const POS = [[17, 40, 12, -6, 0.6], [38, 25, 18, 5, 1], [59, 33, 20, -3, 0.5], [81, 28, 13, 8, 0.9], [27, 72, 17, -4, 0.7], [50, 66, 13, 4, 0.8], [70, 70, 16, -5, 0.45], [88, 60, 14, 6, 1]];
---
<div class="page">
  <H class="ttl mono mu par" id={id}>{`${title} ${pad(projects.length)}`}</H>
  <Scene items={projects.map((p) => ({ href: `/${lang}/work/${p.slug}/`, title: p[lang].title, object: p.object, wip: p.wip ? ui[lang].wip : undefined }))} pos={POS} />
  <div class="mindex g"><div class="mlist"><ProjectRows lang={lang} /></div></div>
</div>

<style>
  .page { position: relative; min-height: 100%; height: 100%; display: flex; flex-direction: column; }
  .ttl { position: absolute; z-index: 2; left: var(--m); top: calc(var(--head) + 16px); }
  /* voyage vers l'étude : le libellé et le menu s'effacent avec les autres objets (Scene.astro) */
  :global(html:has(.stage.leaving)) .ttl, :global(html:has(.stage.leaving)) .site-header { opacity: 0; transition: opacity .28s var(--out); }
  .mindex { display: none; }

  @media (max-width: 760px) {
    /* la liste se cale en bas, mais jamais sous le libellé (place réservée en haut) ; plus longue que l'écran, elle défile */
    .page { justify-content: flex-end; height: auto; padding-top: calc(var(--head) + 48px); }
    .ttl { position: absolute; }
    .mindex { display: grid; padding-bottom: 72px; }
    .mlist { grid-column: 1 / -1; }
    /* numéros comme sur ordinateur : « (01) » en orange */
    .mlist :global(.row .n) { color: var(--ac); }
    .mlist :global(.row .n)::before { content: '('; } .mlist :global(.row .n)::after { content: ')'; position: static; opacity: 1; transform: none; color: inherit; } /* la flèche de survol (global.css) devient la parenthèse fermante */
  }
</style>

