---
// Stack en fanions de tissu. Chaque fanion = un vrai tissu simulé (maillage de points, intégration de Verlet,
// contraintes de distance, gravité, brise légère) et dessiné en WebGL avec un éclairage calculé sur les plis.
// Drap à la couleur du logiciel, logo détouré dans le bas, couture piquée, queue d'aronde.
// La souris passe = le vent qu'elle fait pousse le tissu. Sans WebGL ou avec « Réduire les animations » :
// fanions fixes en HTML (même dessin, sans mouvement).
interface Props { items: { id: string; name: string; bg: string; ink: string; mark: string }[] }
const { items } = Astro.props;
---
<div class="fanions" data-fanions aria-label="Stack">
  <canvas class="gl" aria-hidden="true"></canvas>
  <ul>
    {items.map((x, i) => (
      <li class="fn" style={`--n:${i}`} data-bg={x.bg} data-ink={x.ink} data-mark={`/stack/${x.mark}`} data-name={x.name.toLowerCase()}>
        <span class="cloth" style={`--bg:${x.bg};--ink:${x.ink}`}>
          <img src={`/stack/${x.mark}`} alt={x.name} decoding="async" />
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .fanions { position: relative; margin-top: 32px; }
  .gl { position: absolute; left: -60px; top: 0; height: calc(100% + 80px); width: calc(100% + 120px); max-width: none; /* la remise à zéro globale bornait le canvas à 100 % : le dernier fanion était coupé */ pointer-events: none; z-index: 2; }
  ul { display: flex; gap: clamp(10px, 1.2vw, 18px); padding: 0 8px; }
  .fn { flex: 1; min-width: 0; }
  /* version fixe (aussi la mise en page de référence pour le tissu) */
  .cloth { position: relative; display: flex; flex-direction: column; align-items: center; height: clamp(130px, 24vh, 250px); justify-content: flex-end; padding-bottom: 30%;
    background: var(--bg); color: var(--ink); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 85%, 0 100%); }
  .cloth img { width: 60%; aspect-ratio: 1; height: auto; object-fit: contain; }
  .fanions.live ul { visibility: hidden; }
  /* version fixe : simple fondu décalé */
  @media (prefers-reduced-motion: no-preference) {
    .fanions:not(.live) .fn .cloth { animation: kk-fade .5s ease-out backwards; animation-delay: calc(var(--n) * 60ms); }
  }
  @keyframes kk-fade { from { opacity: 0; transform: translateY(-10px); } }
  /* téléphone : pas de fanions, les icônes restent dans le texte ; ordinateur : l'inverse */
  @media (max-width: 760px) { .fanions { display: none; } }
  @media (min-width: 761px) { :global(.stk .vi.lg) { display: none; } }
</style>

