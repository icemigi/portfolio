---
// Stack en fanions de tissu. Chaque fanion = un vrai tissu simulé (maillage de points, intégration de Verlet,
// contraintes de distance, gravité, brise légère) et dessiné en WebGL avec un éclairage calculé sur les plis.
// Chacun sa forme et son motif (/public/fanions/<id>.svg), logo détouré dans le bas ; au survol (ou au toucher),
// le nom du logiciel et ce que j'en fais. La souris passe = le vent qu'elle fait pousse le tissu.
// Sans WebGL, sur téléphone ou avec « Réduire les animations » : fanions fixes en HTML (même dessin, sans mouvement).
import type { Lang } from '../data/ui';
import heights from '../data/fanions.json'; // hauteur de chaque dessin (76 de large), écrite par tools/fanions.py
interface Props { items: { id: string; name: string; mark: string; note: Record<Lang, string> }[]; lang: Lang; hint: string }
const { items, lang, hint } = Astro.props;
---
<div class="fanions" data-fanions role="group" aria-label="Stack" transition:persist="fanions">
  <canvas class="gl" aria-hidden="true"></canvas>
  <ul>
    {items.map((x, i) => (
      <li class="fn" style={`--n:${i}`} tabindex="0" aria-label={`${x.name}, ${x.note[lang]}`} data-name={x.name} data-note={`(${x.note[lang].toLowerCase()})`}>
        <span class="cloth">
          <img class="dr" src={`/fanions/${x.id}.svg`} width="76" height={heights[x.id as keyof typeof heights]} alt="" decoding="async" />
          <img class="mk" src={`/stack/${x.mark}`} alt="" decoding="async" />
        </span>
      </li>
    ))}
  </ul>
  <p class="cap" aria-hidden="true"></p>
  <p class="hint mono mu" aria-hidden="true">{hint}</p>
</div>

<style>
  /* le bas réserve la place de la légende : rien ne bouge quand elle change */
  .fanions { position: relative; margin-top: 48px; padding-bottom: 140px; }
  .gl { position: absolute; left: -60px; top: 0; height: calc(100% + 80px); width: calc(100% + 120px); max-width: none; /* la remise à zéro globale bornait le canvas à 100 % : le dernier fanion était coupé */ pointer-events: none; z-index: 2; }
  ul { --gap: clamp(10px, 1.2vw, 18px); display: flex; align-items: flex-start; gap: var(--gap); padding: 0 8px; }
  .fn { flex: 1; min-width: 0; outline: none; }
  /* version fixe (aussi la mise en page de référence pour le tissu) : le dessin à pleine largeur, à ses proportions (largeur et
     hauteur données dans le HTML : juste avant le chargement de l'image) ; chaque fanion a sa longueur */
  .cloth { position: relative; display: block; container-type: inline-size; }
  .dr { display: block; width: 100%; height: auto; }
  /* logo : boîte carrée de 60 % de la largeur, son bas à deux largeurs du haut (comme sur le tissu) : même ligne pour tous */
  .mk { position: absolute; left: 20%; top: 200cqw; width: 60%; aspect-ratio: 1; height: auto; object-fit: contain; translate: 0 -100%; }
  .fanions.live .cloth { visibility: hidden; }
  /* légende : à un endroit fixe sous les fanions (aligné sur le texte), le fanion survolé ou touché (banners.ts l'écrit et l'anime) ;
     sinon, l'invitation à survoler */
  .cap, .hint { position: absolute; z-index: 3; left: 0; bottom: 0; transition: opacity .2s, translate .2s cubic-bezier(.2,.7,.2,1); }
  /* même écriture que l'index des services : numéro et description en mono gris 12 px, nom en t56 */
  .cap { display: grid; grid-template-columns: auto auto; column-gap: 14px; row-gap: 4px; align-items: baseline; justify-content: start; opacity: 0; translate: 0 4px; pointer-events: none; white-space: nowrap; }
  /* contenu écrit par banners.ts : hors du gabarit, d'où :global */
  .cap :global(.n), .cap :global(.dl), .hint { font-size: 12px; }
  .cap :global(.dl) { grid-column: 2; }
  .fanions.on .cap { opacity: 1; translate: 0 0; }
  .fanions.on .hint { opacity: 0; }
  /* version fixe : simple fondu décalé */
  @media (prefers-reduced-motion: no-preference) {
    .fanions:not(.live) .fn .cloth { animation: kk-fade .5s ease-out backwards; animation-delay: calc(var(--n) * 60ms); }
  }
  @keyframes kk-fade { from { opacity: 0; transform: translateY(-10px); } }
  /* téléphone : deux rangées de cinq, légende au toucher */
  @media (max-width: 760px) {
    ul { flex-wrap: wrap; justify-content: center; row-gap: 48px; }
    .fn { flex: 0 0 calc((100% - 4 * var(--gap)) / 5); }
  }
</style>
