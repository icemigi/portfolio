---
// Sceau de cire rouge portant le cavalier (essai 1 retenu) — seule couleur du site.
interface Props { size?: number; label: string }
const { size = 180, label } = Astro.props;
const wax = '#8e1b14', hi = '#ff9b8a', lo = '#3d0805';
---
<svg class="seal" width={size} height={size} viewBox="0 0 320 320" role="img" aria-label={label}>
  <defs>
    <filter id="kk-blob" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="66" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="26" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <filter id="kk-relief" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="9" result="b" />
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="2" result="grain" />
      <feComposite in="b" in2="grain" operator="arithmetic" k1="0" k2="1" k3="0.06" k4="0" result="bump" />
      <feSpecularLighting in="bump" surfaceScale="7" specularConstant="0.9" specularExponent="22" lighting-color={hi} result="spec">
        <feDistantLight azimuth="225" elevation="42" />
      </feSpecularLighting>
      <feComposite in="spec" in2="SourceAlpha" operator="in" result="specIn" />
      <feComposite in="SourceGraphic" in2="specIn" operator="arithmetic" k1="0" k2="1" k3="0.55" k4="0" />
    </filter>
    <filter id="kk-emboss" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="1.6" result="a" />
      <feSpecularLighting in="a" surfaceScale="-4" specularConstant="1.1" specularExponent="18" lighting-color={hi} result="s">
        <feDistantLight azimuth="225" elevation="40" />
      </feSpecularLighting>
      <feComposite in="s" in2="SourceAlpha" operator="in" result="sIn" />
      <feFlood flood-color={lo} result="dark" />
      <feComposite in="dark" in2="SourceAlpha" operator="in" result="darkIn" />
      <feMerge><feMergeNode in="darkIn" /><feMergeNode in="sIn" /></feMerge>
    </filter>
    <filter id="kk-drop" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="3" dy="8" stdDeviation="8" flood-color="#000" flood-opacity=".28" />
    </filter>
    <clipPath id="kk-disc"><circle cx="160" cy="160" r="98" /></clipPath>
  </defs>
  <g filter="url(#kk-drop)">
    <g filter="url(#kk-relief)">
      <circle cx="160" cy="160" r="128" fill={wax} filter="url(#kk-blob)" />
      <circle cx="160" cy="160" r="102" fill={lo} opacity=".35" />
      <circle cx="160" cy="160" r="98" fill={wax} />
    </g>
    <circle cx="160" cy="160" r="98" fill="none" stroke={lo} stroke-width="2" opacity=".6" />
    <g filter="url(#kk-emboss)" clip-path="url(#kk-disc)">
      <image href="/logo-kerningkastle-dark.svg" x="78" y="78" width="164" height="164" />
    </g>
  </g>
</svg>
