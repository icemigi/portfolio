---
// Portrait en relief (WebGL2) : chevalier en maillage déplacé par sa profondeur, cadre enluminé devant,
// caméra en perspective qui suit la souris. Sans WebGL2 ou avec « Réduire les animations » : image fixe.
// Assets (public/portrait3d/) régénérés par le script export_web.py ; sources PNG dans assets/portrait3D/web/.
//   knight.webp : chevalier détouré, non découpé (le pochoir du cadre le découpe au rendu, dans le plan du cadre)
//   frame.webp  : cadre ; geo.png : R,G = profondeur 16 bits, B = pochoir ; nrm.png : R,G = pente (racine signée), B = visage
interface Props { lang: 'fr' | 'en'; class?: string; id?: string }
const { lang, class: cls = '', id } = Astro.props;
const alt = lang === 'fr' ? 'Portrait de Kern en armure, dans un cadre enluminé' : 'Portrait of Kern in armour, in an illuminated frame';
---
<figure class:list={['p3d', cls]} id={id} data-p3d>
  <img src="/portrait3d/portrait-fallback-m.webp" alt={alt} width="972" height="1327" decoding="async" fetchpriority="high" data-no-ascii />
  <canvas aria-hidden="true"></canvas>
</figure>

<style>
  /* légèrement incliné, comme sur la maquette (sens horaire) */
  .p3d { position: absolute; margin: 0; aspect-ratio: 1709 / 2334; pointer-events: none; rotate: var(--p3d-rot, 8deg); }
  /* image fixe (avant le rendu 3D, ou sans) : même marge transparente de 4 % que le cadre 3D — le dragon n'est jamais coupé */
  .p3d img { position: absolute; left: -4%; top: -4%; width: 108%; height: 108%; display: block; }
  /* le canvas déborde de 25 % : rotation, saut et dépassement de la volte-face restent dedans ; au repos le portrait couvre exactement l'image */
  .p3d canvas { position: absolute; left: -25%; top: -25%; width: 150%; height: 150%; display: block; opacity: 0; transition: opacity .3s; }
  .p3d.gl canvas { opacity: 1; }
  .p3d.gl img { visibility: hidden; transition: visibility 0s .3s; }
  .p3d.now canvas, .p3d.now img { transition: none; }
  .p3d.pre { opacity: 0; } /* avant son entrée (voir le script) */
  :global(html[data-theme='nuit']) .p3d img { filter: brightness(.55) sepia(.35); } /* image fixe, la nuit */
</style>

