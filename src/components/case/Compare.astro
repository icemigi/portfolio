---
// Avant / après à volet (plan réutilisable des études) : deux visuels de mêmes proportions superposés ; un curseur (input range,
// clavier et souris) découvre l'« avant » à gauche du volet (branché dans views/case.ts). Sans script, le volet reste au milieu. Posé sur la grille comme un
// visuel de MediaScreen (colonnes --s, sur tous les écrans).
// before / after : sorties de pic() avec leur texte alternatif ; labels : les deux mots affichés aux coins.
interface Item { src: string; srcset?: string; sizes: string; w: number; h: number; alt: string }
interface Props { label: string; before: Item; after: Item; labels: [string, string]; range: string; at?: string }
const { label, before, after, labels, range, at = '3 / 11' } = Astro.props;
---
<section class="scr mds" data-media>
  <div class="in g med sqg c1">
    <p class="lab mono mu par">{label}</p>
    <figure class="mi m0" style={`--s:${at};`}>
      <div class="cmp mf" data-cmp style={`aspect-ratio:${after.w} / ${after.h};`}>
        <img class="md" src={after.src} srcset={after.srcset} sizes={after.sizes} width={after.w} height={after.h} alt={after.alt} loading="lazy" decoding="async" />
        <img class="md bf" src={before.src} srcset={before.srcset} sizes={before.sizes} width={before.w} height={before.h} alt={before.alt} loading="lazy" decoding="async" />
        <span class="ln" aria-hidden="true"></span>
        <span class="tg mono l">{labels[0]}</span><span class="tg mono r">{labels[1]}</span>
        <input type="range" min="0" max="100" value="50" step="1" aria-label={range} />
      </div>
    </figure>
  </div>
</section>

<style>
  .cmp { --x: 50%; position: relative; overflow: hidden; }
  .cmp > img { display: block; width: 100%; height: auto; }
  .cmp > .bf { position: absolute; inset: 0; height: 100%; object-fit: cover; clip-path: inset(0 calc(100% - var(--x)) 0 0); }
  .cmp .ln { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; margin-left: -1px; background: var(--bg); pointer-events: none; }
  .cmp .ln::after { content: ''; position: absolute; top: 50%; left: 50%; width: 28px; height: 28px; margin: -14px 0 0 -14px; border-radius: 50%; background: var(--bg); box-shadow: 0 1px 6px rgb(0 0 0 / .25); }
  .cmp .tg { position: absolute; bottom: 10px; padding: 3px 6px; font-size: 11px; background: var(--bg); color: var(--fg); pointer-events: none; }
  .cmp .tg.l { left: 10px; } .cmp .tg.r { right: 10px; }
  .cmp input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  .cmp:has(input:focus-visible) { outline: 2px solid var(--fg); outline-offset: 3px; }
</style>
