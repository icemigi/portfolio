---
// kern.outdoor : le milieu de l'étude de cas (après la page de garde et l'accroche communes), cadré pour la personne qui
// regarde : une identité qui se reconnaît, un système, la vidéo, une ligne éditoriale, et des résultats.
//   chiffres            : en ouverture, ce que le compte a fait.
//   l'identité          : puis la charte (les quatre couleurs montent l'une après l'autre, puis les deux typos).
//   le système          : puis les carrousels, qui défilent seuls, décalés (jamais deux à la fois) ; un clic fait avancer.
//   la vidéo, la ligne éditoriale : écrans de texte.
//   chiffres            : en fin d'étude, le détail (datés).
// Textes : projects.ts (r : libellé, h : gros texte, p : note) ; chiffres, charte, carrousels : kern/data.ts.
// Les écrans des pièces portent data-k : views/kern.ts n'anime une pièce que tant que son écran est à l'écran.
import type { Img } from '../../data/media';
import { kernData } from './kern/data';
import TextScreen from './TextScreen.astro';
import SlotScreen from './SlotScreen.astro';
interface Props { lang: 'fr' | 'en'; c: any; M: { cover: Img; gal?: Img[][] }; pic: (im: Img, sizes: string) => any; rich: (t: string, cls?: string) => string }
const { lang, c, rich } = Astro.props;
const fr = lang === 'fr';
const S = c.sections as { r: string; h: string; paras: { p: string }[] }[];
const { PAL, CAR, FIG, SLOT, todo } = kernData(fr);
// médias à fournir, par écran (emplacements gris) : après les chiffres, puis après la pièce de chaque écran de texte
const TODO = { top: ['grid'], after: [['before', 'after'], ['formats', 'anatomy'], ['reel', 'overlay'], []] };
const slots = (keys: string[]) => keys.map((key) => SLOT[key]);
const T = S.map((s) => ({ k: s.r, big: rich(`${s.h}.`), note: rich(s.paras[0].p, 'note') }));
---
<section class="scr txs" data-k="chiffres">
  <div class="in g cen">
    <div class="pin">
      <h2 class="lab mono mu par">{fr ? 'en chiffres' : 'in figures'}</h2>
      <ul class="fig">{FIG.top.map(([v, k]) => <li><b class="phr t56">{v}</b><span class="mono mu note">{k}</span></li>)}</ul>
      <p class="mono mu note src">{FIG.src}</p>
    </div>
  </div>
</section>

<SlotScreen label={todo} slots={slots(TODO.top)} />

{T.map((t, i) => (
  <>
    <TextScreen {...t} />

    {i === 0 && (
      <section class="scr mds" data-media data-k="charte">
        <div class="in g med n1">
          <p class="lab mono mu par">{fr ? 'la palette et les typos' : 'palette and typefaces'}</p>
          <figure class="mi m0 kp ch-v" data-par="70">
            <ul class="pal">{PAL.map(([col, nm]) => <li style={`--c:${col}`}><span class="sw"></span><span class="mono">{nm}</span><span class="mono mu">{col}</span></li>)}</ul>
            <div class="fonts">
              <img src="/work/kern-outdoor/font-instrument.webp" width="1302" height="176" alt="Instrument Serif" />
              <img src="/work/kern-outdoor/font-helvetica.webp" width="1545" height="169" alt="Helvetica Neue" />
            </div>
          </figure>
        </div>
      </section>
    )}

    {i === 1 && (
      <section class="scr mds" data-media data-k="serie">
        <div class="in g med n3 flip">
          <p class="lab mono mu par">{fr ? 'les formats — trois des cinq' : 'the formats — three of five'}</p>
          {CAR.map((car, k) => (
            <figure class:list={['mi kp car', `m${k}`]} data-car data-par={[70, 150, 110][k]}>
              <button type="button" class="vp" data-card aria-label={fr ? `Carrousel ${k + 1} : slide suivante` : `Carousel ${k + 1}: next slide`}>
                <span class="track">{Array.from({ length: car.n }, (_, j) => <img src={`/work/kern-outdoor/car/p${k + 1}-${j + 1}.webp`} width="720" height="960" alt={`kern.outdoor — ${car.t}, ${j + 1}/${car.n}`} loading={j ? 'lazy' : 'eager'} decoding="async" />)}</span>
              </button>
              <figcaption class="mono mu">{car.t}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {TODO.after[i].length > 0 && <SlotScreen label={todo} slots={slots(TODO.after[i])} />}
  </>
))}

<section class="scr txs" data-k="fin">
  <div class="in g cen">
    <div class="pin">
      <h2 class="lab mono mu par">{fr ? 'les résultats' : 'results'}</h2>
      <ul class="fig">{FIG.end.map(([v, k]) => <li><b class="phr t56">{v}</b><span class="mono mu note">{k}</span></li>)}</ul>
      <p class="mono mu note src">{FIG.src}</p>
    </div>
  </div>
</section>

<style>
  /* chiffres : trois valeurs côte à côte, la source datée dessous */
  .fig { display: grid; grid-template-columns: repeat(3, auto); column-gap: clamp(32px, 6vw, 96px); row-gap: 20px; }
  .fig li { display: grid; row-gap: 10px; align-content: start; }
  .fig b { white-space: nowrap; }


  .fig .mono, .src { font-size: 11px; text-transform: none; }

  /* la charte : quatre couleurs en colonnes, puis les typos */
  .ch-v { display: grid !important; row-gap: 28px; width: min(100%, calc(var(--mh, 70dvh) * 1.3)); }
  .pal { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .pal li { display: grid; row-gap: 6px; }
  .pal .sw { height: calc(var(--mh, 70dvh) * .55); background: var(--c); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 8%, transparent); }
  .pal .mono { font-size: 11px; text-transform: none; }
  .fonts { display: grid; row-gap: 12px; }
  .fonts img { display: block; height: min(4.4dvh, 38px); width: auto; max-width: 100%; }
  :global(html[data-theme="nuit"]) .fonts img { filter: invert(1); }

  /* les formats : trois carrousels (3:4) */
  .car { flex-direction: column; }
  .car .vp { display: block; width: min(100%, var(--mh, 52dvh) * .75); aspect-ratio: 3 / 4; overflow: hidden; padding: 0; border: 0; background: color-mix(in srgb, var(--fg) 6%, var(--bg)); cursor: e-resize; }
  .track { display: flex; height: 100%; will-change: transform; transition: none; }
  .track img { flex: none; width: 100%; height: 100%; object-fit: contain; display: block; }
  .car figcaption { margin-top: 12px; font-size: 11px; text-transform: none; }

  @media (max-width: 760px) {
    .fig { grid-template-columns: 1fr; row-gap: 14px; }
    .ch-v { width: 100%; row-gap: 12px; }
    .pal .sw { height: 14dvh; }
    .fonts img { height: 3dvh; }
    .car .vp { width: 15dvh; }
    .car figcaption { display: none; }
  }
</style>
