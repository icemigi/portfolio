---
// Écran de médias des études à mise en page propre : un libellé, puis 1 à 4 visuels carrés posés sur les colonnes de la grille
// (placements .sqg.cN / .big / .big-r dans [slug].astro). Recadrage minimal : un visuel déjà carré remplit son carré, tout autre
// visuel y est entier, sur fond neutre. layout (3 visuels) : 'big' : un grand et deux petits empilés à sa droite ; 'big-r' : en miroir.
// items : sorties de pic() ([slug].astro) avec leur texte alternatif.
interface Item { src: string; srcset?: string; sizes: string; w: number; h: number; alt: string; fit?: 'contain' }
interface Props { label: string; items: Item[]; layout?: 'big' | 'big-r' }
const { label, items, layout } = Astro.props;
const fit = (p: Item) => p.fit ?? (Math.abs(p.w / p.h - 1) > 0.02 ? 'contain' : undefined);
---
<section class="scr mds" data-media>
  <div class:list={['in g med sqg', layout ?? `c${items.length}`]}>
    <p class="lab mono mu par">{label}</p>
    {items.map((p, k) => <figure class:list={['mi', `m${k}`]}><span class="sq"><img class="md" src={p.src} srcset={p.srcset} sizes={p.sizes} width={p.w} height={p.h} alt={p.alt} style={fit(p) && `object-fit:${fit(p)}`} loading="lazy" decoding="async" /></span></figure>)}
  </div>
</section>
