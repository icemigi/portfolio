---
// Liste des projets (accueil, page Projets sur téléphone). Ordinateur : au survol d'une ligne, l'objet du projet
// apparaît et suit le curseur (amorti), comme un aperçu ; rien sur écran tactile. Tous les aperçus tiennent dans la même boîte
// de 180 × 180 : un objet haut (le livre) et un objet large (le vinyle) ont le même encombrement.
import { projects } from '../data/projects';
import { tags, pad, type Lang } from '../data/ui';
import ObjectShape from './ObjectShape.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
// équilibre visuel des aperçus : à boîte égale, un objet large et clair (le vinyle) paraît petit, un objet haut et sombre (le livre) paraît grand
const K: Record<string, number> = { book: 0.82, vinyl: 1.3 };
---
<ol class="rows" data-rows>
  {projects.map((p, i) => (
    <li>
      <a class="row" href={`/${lang}/work/${p.slug}/`}>
        <span class="n mono mu">{pad(i + 1)}</span>
        <span class="t t28">{p[lang].title}</span>
        <span class="d mono mu">{p.tags.map((t) => tags[lang][t]).join(', ')}</span>
        <span class="y mono mu">{p.yearLabel}</span>
      </a>
      <span class="pv" aria-hidden="true" style={`--k:${K[p.object] ?? 1}`}><ObjectShape kind={p.object} /></span>
    </li>
  ))}
</ol>

<style>
  .rows { position: relative; }
  .pv { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .pv { display: grid; place-items: center; position: absolute; left: 0; top: 0; z-index: 5; width: 180px; height: 180px; pointer-events: none; opacity: 0; scale: .8; transition: opacity .25s, scale .45s var(--out); will-change: transform; }
    .pv :global(.shape) { display: block; width: 100%; height: 100%; object-fit: contain; scale: var(--k, 1); filter: drop-shadow(0 18px 18px rgba(0, 0, 0, .2)); animation: kk-sway 6s ease-in-out infinite; }
    li:hover .pv { opacity: 1; scale: 1; }
  }
</style>

