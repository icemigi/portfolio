---
// Menu fixe : le cavalier seul (accueil), rubriques, son, EN / FR (garde la page en cours).
// Téléphone : « (menu) » ouvre un plein écran (rubriques en grand, numérotées, langue en bas) ; Échap ou un lien le referme.
import { ui, pad, type Lang } from '../data/ui';
import { projects } from '../data/projects';
import { rooms } from '../data/lab';
interface Props { lang: Lang; path: string; active?: string }
const { lang, path, active } = Astro.props;
const t = ui[lang];
const items = [
  { key: 'work', href: `/${lang}/work/`, count: pad(projects.length) },
  { key: 'lab', href: `/${lang}/lab/`, count: pad(rooms.length) },
  { key: 'archive', href: `/${lang}/archive/`, count: '' },
  { key: 'about', href: `/${lang}/about/`, count: '' },
] as const;
---
<header class="site-header g mono">
  <a class="home" href={`/${lang}/`} aria-label={t.home}><img src="/logo-kerningkastle-dark.svg" alt="" width="34" height="34" /></a>
  <nav id="site-nav" aria-label={lang === 'fr' ? 'Menu principal' : 'Main menu'} data-own-wheel data-own-touch>
    <ul>
      {items.map((i, k) => (
        <li style={`--k:${k}`}>
          <a class="lk" href={i.href} aria-current={active === i.key ? 'page' : undefined}>
            <span class="nn mu" aria-hidden="true">{pad(k + 1)}</span>{t.nav[i.key]}{i.count && <span class="count mu"> {i.count}</span>}
          </a>
        </li>
      ))}
    </ul>
    <span class="lang lang-m" aria-label={lang === 'fr' ? 'Langue' : 'Language'}>
      <a class="hit" href={`/en/${path}`} hreflang="en" lang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>en</a>
      <span aria-hidden="true">/</span>
      <a class="hit" href={`/fr/${path}`} hreflang="fr" lang="fr" data-lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>fr</a>
    </span>
  </nav>
  <div class="r">
    <button class="snd hit" type="button" data-sound aria-pressed="false" data-on={lang === 'fr' ? 'Son on' : 'Sound on'} data-off={lang === 'fr' ? 'Son off' : 'Sound off'} aria-label={lang === 'fr' ? 'Son off' : 'Sound off'}><svg viewBox="0 0 20 16" width="20" height="16" aria-hidden="true"><path d="M2 5.5h3.2L9.5 2v12L5.2 10.5H2Z" fill="currentColor"/><path d="m12.5 5.5 5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
    <button class="burger bp hit" type="button" aria-controls="site-nav" aria-expanded="false" data-burger data-open="menu" data-close={lang === 'fr' ? 'fermer' : 'close'}>menu</button>
    <span class="lang">
      <a class="hit" href={`/en/${path}`} hreflang="en" lang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>en</a>
      <span aria-hidden="true">/</span>
      <a class="hit" href={`/fr/${path}`} hreflang="fr" lang="fr" data-lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>fr</a>
    </span>
  </div>
</header>

<script>
  const b = document.querySelector<HTMLButtonElement>('[data-burger]');
  const nav = document.getElementById('site-nav');
  if (b && nav) {
    const set = (o: boolean) => {
      document.documentElement.classList.toggle('menu-open', o);
      b.setAttribute('aria-expanded', String(o)); b.textContent = o ? b.dataset.close! : b.dataset.open!; b.classList.toggle('bx', o);
      dispatchEvent(new CustomEvent('kk:sound', { detail: o ? 'pick' : 'drop' }));
      if (o) nav.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    };
    b.addEventListener('click', () => set(b.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && b.getAttribute('aria-expanded') === 'true') { set(false); b.focus(); } });
    matchMedia('(min-width: 761px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }
</script>
