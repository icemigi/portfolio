---
// Menu fixe : le cavalier seul (accueil), rubriques, son, langue (un seul bouton : l'autre langue, garde la page en cours).
// Téléphone : « (menu) » ouvre un plein écran (rubriques en grand, numérotées, langue en bas) ; Échap ou un lien le referme.
import { ui, pad, type Lang } from '../data/ui';
import { projects } from '../data/projects';
import { labCount } from '../data/lab';
import { pieces } from '../data/archive';
interface Props { lang: Lang; path: string; active?: string }
const { lang, path, active } = Astro.props;
const t = ui[lang];
const items = [
  { key: 'work', href: `/${lang}/work/`, count: pad(projects.length) },
  { key: 'lab', href: `/${lang}/lab/`, count: pad(labCount) },
  { key: 'archive', href: `/${lang}/archive/`, count: String(pieces.length) },
  { key: 'about', href: `/${lang}/about/`, count: '' },
  { key: 'contact', href: `/${lang}/contact/`, count: '' },
] as const;
// langue : un seul bouton, l'autre langue ; un clic réécrit la page sur place (langswap.ts) puis ouvre l'autre version
const other: Lang = lang === 'fr' ? 'en' : 'fr';
---
<header class="site-header g mono">
  <a class="home" href={`/${lang}/`} aria-label={t.home}><img class="logo-ic" src="/logo-icon-128.webp" srcset="/logo-icon-128.webp 1x, /logo-icon-256.webp 2x" alt="" width="50" height="50" /></a>
  <nav id="site-nav" aria-label={lang === 'fr' ? 'Menu principal' : 'Main menu'} data-own-wheel data-own-touch>
    <ul>
      {items.map((i, k) => (
        <li style={`--k:${k}`}>
          <a class="lk" href={i.href} aria-current={active === i.key ? 'page' : undefined}>
            <span class="nn mu" aria-hidden="true">{pad(k + 1)}</span>{t.nav[i.key]}{i.count && <span class="count mu"> {i.count}</span>}
          </a>
        </li>
      ))}
    </ul>
    <span class="lang lang-m"><a class="hit" href={`/${other}/${path}`} hreflang={other} lang={other} data-lang={other}>{other}<span class="sr">{other === 'en' ? ' — English version' : ' — version française'}</span></a></span>
  </nav>
  <div class="r">
    <button class="snd hit" type="button" data-sound aria-pressed="false" data-on={lang === 'fr' ? 'Son on' : 'Sound on'} data-off={lang === 'fr' ? 'Son off' : 'Sound off'} aria-label={lang === 'fr' ? 'Son off' : 'Sound off'}><svg viewBox="0 0 30 22" width="19" height="14" aria-hidden="true"><rect x=".5" y="3.9" width="1.3" height="6" fill="currentColor"/><path d="M1.8 5.7H18.4C20.6 5.3 22.2 3.4 22.6.8C23-.1 23.7.3 23.8 1.2C24.2 4.5 24.2 9.4 23.8 12.7C23.7 13.6 23 13.9 22.6 13.1C22.1 10.6 20.6 8.6 18.4 8.1H1.8Z" fill="currentColor"/><path class="bn" d="M4.7 7.9H14.8V21.3L9.75 16.4 4.7 21.3Z" fill="currentColor"/><path class="wv" d="M25.6 3.2 28.4 1.4M26 6.9H29.4M25.6 10.6 28.4 12.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    <button class="thm hit" type="button" data-theme-toggle aria-pressed="false" aria-label={lang === 'fr' ? 'Mode nuit' : 'Night mode'} title={lang === 'fr' ? 'Mode nuit' : 'Night mode'}><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><g class="sun"><circle cx="8" cy="8" r="3.6" fill="currentColor"/><path d="M13.30 8.00L15.30 8.00M11.75 11.75L13.16 13.16M8.00 13.30L8.00 15.30M4.25 11.75L2.84 13.16M2.70 8.00L0.70 8.00M4.25 4.25L2.84 2.84M8.00 2.70L8.00 0.70M11.75 4.25L13.16 2.84" fill="none" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/></g><path class="mn" d="M12.2 1.5A6.5 6.5 0 1 0 12.2 14.5A8.2 8.2 0 0 1 12.2 1.5Z"/></svg></button>
    <button class="burger bp hit" type="button" aria-controls="site-nav" aria-expanded="false" data-burger data-open="menu" data-close={lang === 'fr' ? 'fermer' : 'close'}>menu</button>
    <span class="lang"><a class="hit" href={`/${other}/${path}`} hreflang={other} lang={other} data-lang={other}>{other}<span class="sr">{other === 'en' ? ' — English version' : ' — version française'}</span></a></span>
  </div>
</header>

