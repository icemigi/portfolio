---
// Lab : une pièce en plein écran, avec la même enveloppe épurée que les pièces autonomes (public/lab/ui.css + back.js) :
// « ← lab » et une aide en haut à gauche, les actions en haut à droite, rien d'autre (ni menu du site, ni numéros, ni flèches).
// Une pièce autonome (kind 'embed') s'ouvre directement : cette adresse ne fait que l'y renvoyer.
import Base from '../layouts/Base.astro';
import TypeCanvas from './TypeCanvas.astro';
import { ui, type Lang } from '../data/ui';
import { rooms } from '../data/lab';
interface Props { lang: Lang; index: number }
const { lang, index } = Astro.props;
const t = ui[lang];
const room = rooms[index];
const r = room[lang];
const fr = lang === 'fr';
const intro = room.kind === 'type'
  ? (fr ? 'Tape un mot : il se compose en modules (Entrée pour une nouvelle ligne). Approche le curseur, clique pour changer de famille, molette pour la portée.' : 'Type a word: it is built from modules (Enter for a new line). Move the cursor close, click to change the family, wheel for the reach.')
  : r.note;
---
<Base lang={lang} title={`${r.title} — Lab`} description={r.note} path={`lab/${room.id}/`} active="lab">
  {room.kind === 'embed' && <script is:inline define:vars={{ to: `${room.src}?lang=${lang}` }}>location.replace(to);</script>}
  <link rel="stylesheet" href="/lab/ui.css" />
  <h1 class="sr">{r.title}</h1>
  <div class="lab" data-room={room.kind}>
    <div class:list={['room', room.kind]}>
      {room.kind === 'type' && <TypeCanvas class="tc" label={r.note} edit />}
      {room.kind === 'slot' && <p class="mono mu">({r.note})</p>}
      {room.kind === 'font' && <p class="tester" contenteditable="plaintext-only" spellcheck="false" data-own-keys>Kerning</p>}
      {room.kind === 'embed' && <p class="mono mu"><a href={`${room.src}?lang=${lang}`}>{r.title}</a></p>}
    </div>
  </div>
  <div class="kk-bar">
    <p class="hint">{room.kind === 'type' ? (fr ? 'tape · entrée : ligne · clic : modules · molette : portée' : 'type · enter: new line · click: modules · wheel: reach') : room.kind === 'font' ? t.typeHere : ''} <span data-fam></span></p>
    <p class="act">
      {room.kind === 'type' && <Fragment><button type="button" data-twave>{fr ? 'onde' : 'wave'}</button><button type="button" data-tsave>{fr ? 'enregistrer' : 'save'}</button><button type="button" data-tsvg>svg</button></Fragment>}
      {room.kind === 'font' && (room.file ? <a href={room.file} download>{t.download.toLowerCase()}</a> : <span>{t.fileSoon.toLowerCase()}</span>)}
    </p>
  </div>
  <script is:inline define:vars={{ intro }}>document.documentElement.dataset.intro = intro;</script>
  <script is:inline src="/lab/back.js"></script>
</Base>

<style>
  /* enveloppe épurée : la pièce seule, plein écran, aux couleurs du mode jour / nuit du site */
  :global(.site-header), :global(.more-arrow) { display: none !important; }
  .lab { position: fixed; inset: 0; background: var(--bg); }
  .room { position: absolute; inset: 0; display: grid; place-items: center; padding: 0 var(--m); }
  .room.slot { background: repeating-linear-gradient(45deg, #e6e6e6 0 10px, #dedede 10px 20px); }
  .room.slot p { max-width: 520px; text-align: center; }
  .room :global(.tc) { width: 100%; height: 100%; }
  .tester { font-weight: 500; font-size: 160px; line-height: 160px; letter-spacing: -0.03em; text-align: center; outline: none; max-width: 100%; overflow-wrap: anywhere; caret-color: var(--fg); }
  .kk-bar :global(a), .kk-bar :global(span) { color: var(--k-fg); }
  @media (max-width: 760px) { .tester { font-size: 52px; line-height: 56px; } }
</style>

<script>
  import { reduced as isReduced } from '../scripts/motion';
  // apparition : la pièce se montre en fondu (et se pose, de 2 %), la barre glisse en place juste après
  if (!isReduced()) {
    const room = document.querySelector<HTMLElement>('.room'), bar = document.querySelector<HTMLElement>('.kk-bar');
    room?.animate([{ opacity: 0, transform: 'scale(.98)' }, { opacity: 1, transform: 'none' }], { duration: 700, easing: 'cubic-bezier(.2, .7, .2, 1)', fill: 'backwards' });
    bar?.animate([{ opacity: 0, transform: 'translateY(-8px)' }, { opacity: 1, transform: 'none' }], { duration: 560, delay: 260, easing: 'cubic-bezier(.2, .7, .2, 1)', fill: 'backwards' });
  }
  // type modulaire : enregistrer, et nom de la famille de modules affiché au clic
  const tc = document.querySelector<HTMLCanvasElement>('canvas.type-canvas[data-edit]');
  document.querySelector('[data-tsave]')?.addEventListener('click', () => tc?.dispatchEvent(new CustomEvent('type:save')));
  document.querySelector('[data-tsvg]')?.addEventListener('click', () => tc?.dispatchEvent(new CustomEvent('type:svg')));
  const wv = document.querySelector<HTMLButtonElement>('[data-twave]');
  wv?.addEventListener('click', () => tc?.dispatchEvent(new CustomEvent('type:wave')));
  tc?.addEventListener('type:wavestate', (e) => wv?.setAttribute('aria-pressed', String((e as CustomEvent).detail.on)));
  tc?.addEventListener('type:family', (e) => { const f = document.querySelector('[data-fam]'); if (f) f.textContent = '· ' + (e as CustomEvent).detail.name; });
</script>
